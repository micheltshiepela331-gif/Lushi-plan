(()=>{const arcL=(cx,cy,r,a0,a1,n)=>{const o=[];for(let i=0;i<n;i++){const t0=a0+(a1-a0)*i/n,t1=a0+(a1-a0)*(i+1)/n;o.push(['l',cx+r*Math.cos(t0),cy+r*Math.sin(t0),cx+r*Math.cos(t1),cy+r*Math.sin(t1)]);}return o;};
 const R=(x,y,w,h)=>['r',x,y,w,h],L=(a,b,c,d)=>['l',a,b,c,d],C=(x,y,r)=>['c',x,y,r],rq=(x,y,w,h)=>[[x,y],[x+w,y],[x+w,y+h],[x,y+h]];
 const t=0.28,n1=7,F1=n1*t;
 const eL={g:[R(0,0,1,F1),R(0,F1,1,1),R(1,F1,F1,1)],st:[]},NL=2*n1+2;
 for(let i=1;i<n1;i++){eL.g.push(L(0,i*t,1,i*t),L(1+i*t,F1,1+i*t,F1+1));}
