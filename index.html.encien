const VIEWS3={top:[-Math.PI/2,1.55],front:[-Math.PI/2,0.08],back:[Math.PI/2,0.08],left:[Math.PI,0.08],right:[0,0.08],iso_so:[-3*Math.PI/4,0.6],iso_se:[-Math.PI/4,0.6],iso_ne:[Math.PI/4,0.6],iso_no:[3*Math.PI/4,0.6]};
/* ---------- façades et coupes automatiques ---------- */
let lastCut=null,facMode='fac';
function facRender(cv2,w0,h0,yaw,cut,title){const was=V3.d4;V3.d4=false;V3.noSite=!cut;let B3;try{B3=build3D();}finally{V3.d4=was;V3.noSite=false;}if(!B3.bb)return false;const bb=B3.bb,tgt=[(bb[0]+bb[2])/2,(bb[1]+bb[3])/2,B3.zTop/2],D=Math.min(2,Math.max(1,DPR)),w=Math.round(w0*D),h=Math.round(h0*D);
 cv2.width=w;cv2.height=h;const g=cv2.getContext('2d'),O={yaw,pitch:0,tgt,B3,cut};render3D(g,w,h,O);const proj=O.proj;if(!proj)return true;
 const Hh=S.wallH,lev=B3.lev,ST=S.slabT||0.2;g.save();g.lineCap='round';
 if(cut){const {P0,s:sv,n}=cut,tOf=q=>(q[0]-P0[0])*sv[0]+(q[1]-P0[1])*sv[1];ALLFL=true;const walls=ents.filter(e=>e.t==='wall'&&visible(e)),ops=ents.filter(e=>(e.t==='door'||e.t==='window')&&visible(e));ALLFL=false;
  const P3=(t,z)=>proj([P0[0]+sv[0]*t,P0[1]+sv[1]*t,z]),rect=(t0,t1,z0,z1,col)=>{if(z1-z0<1e-4||t1-t0<1e-4)return;const a=P3(t0,z0),b=P3(t1,z0),c2=P3(t1,z1),d=P3(t0,z1);g.beginPath();g.moveTo(a[0],a[1]);g.lineTo(b[0],b[1]);g.lineTo(c2[0],c2[1]);g.lineTo(d[0],d[1]);g.closePath();g.fillStyle=col;g.fill();g.strokeStyle='#000';g.lineWidth=2*D;g.stroke();};
  const cutT=Q=>{const ts=[];for(let i=0;i<Q.length;i++){const A=Q[i],B=Q[(i+1)%Q.length],da=(A[0]-P0[0])*n[0]+(A[1]-P0[1])*n[1],db=(B[0]-P0[0])*n[0]+(B[1]-P0[1])*n[1];if((da>=0)!==(db>=0)){const t=da/(da-db);ts.push(tOf([A[0]+(B[0]-A[0])*t,A[1]+(B[1]-A[1])*t]));}}return ts.length>=2?[Math.min(...ts),Math.max(...ts)]:null;};
  const fls=B3.MF?null:[...Array(B3.NF).keys()];
  walls.forEach(w=>{const T=cutT(wallPoly(w));if(!T)return;const tm=(T[0]+T[1])/2,m=[P0[0]+sv[0]*tm,P0[1]+sv[1]*tm];let zr=null;ops.forEach(o=>{if((o.fl|0)!==(w.fl|0))return;if(segDist(o.a,w.a,w.b)[0]>w.th/2+0.02)return;const L=dist(o.a,o.b),u=projT(m,o.a,o.b);if(u>=0&&u<=1&&L>0)zr=opZ(o);});
   (fls||[w.fl|0]).forEach(f=>{const z0=f*lev;if(zr){rect(T[0],T[1],z0,z0+zr[0],'#5c636b');rect(T[0],T[1],z0+zr[1],z0+Hh,'#5c636b');}else rect(T[0],T[1],z0,z0+Hh,'#5c636b');});});
  const T0=cutT([[bb[0]-.3,bb[1]-.3],[bb[2]+.3,bb[1]-.3],[bb[2]+.3,bb[3]+.3],[bb[0]-.3,bb[3]+.3]]);if(T0){rect(T0[0],T0[1],-0.25,0,'#8a9097');for(let f=1;f<B3.NF;f++)rect(T0[0],T0[1],f*lev-ST,f*lev,'#8a9097');}
  if(B3.roof){g.strokeStyle='#000';g.lineWidth=3*D;B3.roof.forEach(fc=>{const Pp=fc.p,pts2=[];for(let i=0;i<Pp.length;i++){const A=Pp[i],B=Pp[(i+1)%Pp.length],da=(A[0]-P0[0])*n[0]+(A[1]-P0[1])*n[1],db=(B[0]-P0[0])*n[0]+(B[1]-P0[1])*n[1];if((da>=0)!==(db>=0)){const t=da/(da-db);pts2.push([A[0]+(B[0]-A[0])*t,A[1]+(B[1]-A[1])*t,A[2]+(B[2]-A[2])*t]);}}if(pts2.length>=2){const a=proj(pts2[0]),b=proj(pts2[1]);g.beginPath();g.moveTo(a[0],a[1]);g.lineTo(b[0],b[1]);g.stroke();}});}}
 const gl=proj([tgt[0],tgt[1],0]);g.strokeStyle='#2b2b2b';g.lineWidth=2.5*D;g.beginPath();g.moveTo(8*D,gl[1]);g.lineTo(w-8*D,gl[1]);g.stroke();
 const lv=[0];for(let f=0;f<B3.NF;f++)lv.push(f*lev+Hh);if(B3.roof){let zm=0;B3.roof.forEach(fc=>fc.p.forEach(q=>zm=Math.max(zm,q[2])));lv.push(zm);}
 g.font='bold '+(11*D)+'px sans-serif';g.fillStyle='#c0392b';g.strokeStyle='#c0392b';g.lineWidth=D;[...new Set(lv.map(v=>Math.round(v*100)/100))].forEach(z=>{const p=proj([tgt[0],tgt[1],z]),x=w-6*D;g.beginPath();g.moveTo(x-40*D,p[1]);g.lineTo(x,p[1]);g.moveTo(x-40*D,p[1]);g.lineTo(x-36*D,p[1]-5*D);g.lineTo(x-32*D,p[1]);g.stroke();g.textAlign='right';g.fillText((z>=0?'+':'')+z.toFixed(2).replace('.',','),x,p[1]-3*D);});
 g.restore();return true;}
function openFacades(){ALLFL=true;const has=ents.some(e=>e.t==='wall');ALLFL=false;if(!has){log('Dessine d\'abord des murs');return;}$('#facv').classList.add('on');facMode='fac';drawFacades();}
function facSize(){const bw=$('#facbox').clientWidth||W;const w=Math.max(260,Math.min(640,Math.floor((bw-74)/2)));return [w,Math.round(w*0.56)];}
function drawFacades(){const box=$('#facbox');box.innerHTML='';const [w,h]=facSize();
 [['Façade Sud (avant)',-Math.PI/2],['Façade Nord (arrière)',Math.PI/2],['Façade Est (droite)',0],['Façade Ouest (gauche)',Math.PI]].forEach(([tt,yw])=>{const fg=document.createElement('figure'),c=document.createElement('canvas');c.style.width=w+'px';c.style.height=h+'px';facRender(c,w,h,yw,null,tt);fg.appendChild(c);const cap=document.createElement('figcaption');cap.textContent=tt;fg.appendChild(cap);box.appendChild(fg);});}
function openSection(a,b){const L=dist(a,b),sv=[(b[0]-a[0])/L,(b[1]-a[1])/L],n=[-sv[1],sv[0]];lastCut={a,b};$('#facv').classList.add('on');facMode='cut';
 const box=$('#facbox');box.innerHTML='';const bw=box.clientWidth||W,w=Math.max(300,Math.min(1100,bw-30)),h=Math.round(Math.min(w*0.5,(box.clientHeight||H)-50));
 const fg=document.createElement('figure'),c=document.createElement('canvas');c.style.width=w+'px';c.style.height=h+'px';const yw=Math.atan2(-n[1],-n[0]);facRender(c,w,h,yw,{P0:a,s:sv,n});fg.appendChild(c);const cap=document.createElement('figcaption');cap.textContent='Coupe — traits épais et gris foncé : ce qui est coupé ; derrière : la vue intérieure';fg.appendChild(cap);box.appendChild(fg);setTool('select');}
$('#fClose').onclick=()=>$('#facv').classList.remove('on');
$('#fFac').onclick=()=>{facMode='fac';drawFacades();};
$('#fCut').onclick=()=>{$('#facv').classList.remove('on');setTool('coupe');log('Trace le trait de coupe à travers la maison : on regarde du côté de la petite flèche');};
$('#fFlip').onclick=()=>{if(!lastCut){log('Fais d\'abord une coupe');return;}openSection(lastCut.b,lastCut.a);};
$('#fPng').onclick=()=>{const cs=[...document.querySelectorAll('#facbox canvas')];if(!cs.length)return;const caps=[...document.querySelectorAll('#facbox figcaption')].map(x=>x.textContent);const cols=cs.length>1?2:1,cw=cs[0].width,ch=cs[0].height+26,o=document.createElement('canvas');o.width=cw*cols+10*(cols+1);o.height=Math.ceil(cs.length/cols)*(ch+10)+10;const g=o.getContext('2d');g.fillStyle='#fff';g.fillRect(0,0,o.width,o.height);g.fillStyle='#222';g.font='bold 14px sans-serif';g.textAlign='center';cs.forEach((c,i)=>{const x=10+(i%cols)*(cw+10),y=10+Math.floor(i/cols)*(ch+10);g.drawImage(c,x,y);g.fillText(caps[i]||'',x+cw/2,y+c.height+18);});o.toBlob(bl=>{if(bl){download(safeName()+(facMode==='cut'?'-coupe':'-facades')+'.png',bl,'image/png');log('Image enregistrée');}});};
function splitLong(list,mx){const out=[];for(const fc of list){const P=fc.p;if(!P||P.length!==4||Math.abs(P[0][2]-P[1][2])>1e-6||Math.abs(P[2][2]-P[3][2])>1e-6){out.push(fc);continue;}const L=Math.hypot(P[1][0]-P[0][0],P[1][1]-P[0][1]),n=Math.ceil(L/mx);if(n<=1){out.push(fc);continue;}
 const lp=(a,b,t)=>[a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t,a[2]+(b[2]-a[2])*t];for(let i=0;i<n;i++){const t0=i/n,t1=(i+1)/n;out.push(Object.assign({},fc,{p:[lp(P[0],P[1],t0),lp(P[0],P[1],t1),lp(P[3],P[2],t1),lp(P[3],P[2],t0)]}));}}return out;}
/* ---------- visite et aménagement ---------- */
let FPR=[],ARR=null;const FPK=new Set();let fpRaf=0,fpT=0;
function fpRooms(){FPR=[];roomList().forEach(r=>{const q=roomAt(r.p);if(q&&!q.open)FPR.push({n:r.n,poly:q.poly,fl:S.curFl|0});});
 {ALLFL=false;const ws=ents.filter(e=>e.t==='wall'&&visible(e));if(ws.length){let b=null;ws.forEach(w=>{const q=bbox(w);b=b?[Math.min(b[0],q[0]),Math.min(b[1],q[1]),Math.max(b[2],q[2]),Math.max(b[3],q[3])]:q;});const st=Math.max(0.4,Math.min(1,Math.sqrt((b[2]-b[0])*(b[3]-b[1])/900)));let nc=0,np=FPR.length,tries=0;for(let y=b[1]+st/2;y<b[3];y+=st)for(let x=b[0]+st/2;x<b[2];x+=st){const pt=[x,y];if(FPR.some(R=>pointInPoly(pt,R.poly)))continue;if(++tries>700)break;const q=roomAt(pt);if(!q||q.open||!q.poly||q.poly.length<3)continue;const A=Math.abs(polyArea(q.poly));if(A<0.8)continue;const c=centroid(q.poly);if(FPR.some(R=>pointInPoly(c,R.poly)))continue;const bx=scrBox(q.poly),w=bx[2]-bx[0],h=bx[3]-bx[1],cor=Math.min(w,h)<1.7||Math.max(w,h)/Math.max(.01,Math.min(w,h))>2.3;FPR.push({n:cor?'Couloir'+(nc++?' '+nc:''):'Pièce '+(++np),poly:q.poly,fl:S.curFl|0,cor});}}}
 return FPR;}
function fpLev(){return S.wallH+(S.slabT||0.2);}
function startVisit(i){if(!FPR.length)fpRooms();if(!FPR.length){log('Dessine d\'abord une pièce fermée par des murs');return false;}i=((i%FPR.length)+FPR.length)%FPR.length;const R=FPR[i],b=scrBox(R.poly),w=b[2]-b[0],h=b[3]-b[1];let x,y,yaw;
 if(w>=h){x=b[0]+Math.min(0.7,w*0.2);y=(b[1]+b[3])/2;yaw=0;}else{x=(b[0]+b[2])/2;y=b[1]+Math.min(0.7,h*0.2);yaw=Math.PI/2;}if(R.cor){const c=centroid(R.poly);if(pointInPoly(c,R.poly)){x=w>=h?b[0]+w*0.3:c[0];y=w>=h?c[1]:b[1]+h*0.3;}}if(!pointInPoly([x,y],R.poly)){const c=centroid(R.poly);x=c[0];y=c[1];}
 V3.d4=false;V3.play=false;$('#v4bar').classList.remove('on');$('#b34d').classList.remove('on');V3.fp={x,y,z:R.fl*fpLev()+1.6,yaw,pitch:-0.08,fl:R.fl,ri:i};$('#v3d').classList.add('fp');render3D();return true;}
function stopVisit(){V3.fp=null;FPK.clear();$('#v3d').classList.remove('fp');fit3D();render3D();}
function fpCurRoom(){const P=V3.fp;if(!P)return -1;return FPR.findIndex(R=>pointInPoly([P.x,P.y],R.poly));}
function fpLabel(){const n=$('#fpname');if(!n)return;const i=fpCurRoom();n.textContent=i>=0?'🚶 '+FPR[i].n:'🚶 Couloir / dehors';}
function fpBlocked(x,y){const P=V3.fp,MF=multiFl();ALLFL=true;try{for(const w of ents){if(w.t!=='wall'||(MF&&(w.fl|0)!==P.fl))continue;if(segDist([x,y],w.a,w.b)[0]>w.th/2+0.18)continue;
  const open=ents.some(o=>o.t==='door'&&(!MF||(o.fl|0)===P.fl)&&segDist(o.a,w.a,w.b)[0]<w.th/2+0.03&&segDist([x,y],o.a,o.b)[0]<w.th/2+0.3&&(()=>{const t=projT([x,y],o.a,o.b),L=dist(o.a,o.b)||1;return t>0.18/L&&t<1-0.18/L;})());
  if(!open)return true;}return false;}finally{ALLFL=false;}}
function fpLoop(t){if(!V3.fp||!FPK.size){fpRaf=0;return;}const dt=Math.min(0.05,fpT?(t-fpT)/1000:0.016);fpT=t;const P=V3.fp,sp=1.3*dt,tr=1.4*dt;
 if(FPK.has('l'))P.yaw+=tr;if(FPK.has('r'))P.yaw-=tr;if(FPK.has('lu'))P.pitch=Math.min(1.1,P.pitch+tr*0.7);if(FPK.has('ld'))P.pitch=Math.max(-1.1,P.pitch-tr*0.7);
 const mv=(FPK.has('f')?1:0)-(FPK.has('b')?1:0);if(mv){const nx=P.x+Math.cos(P.yaw)*sp*mv,ny=P.y+Math.sin(P.yaw)*sp*mv;if(!fpBlocked(nx,ny)){P.x=nx;P.y=ny;}else if(!fpBlocked(nx,P.y))P.x=nx;else if(!fpBlocked(P.x,ny))P.y=ny;}
 render3D();fpRaf=requestAnimationFrame(fpLoop);}
function startArrange(R){if(!R)return;if($('#v3d').classList.contains('on')){V3.fp=null;FPK.clear();$('#v3d').classList.remove('fp');$('#v3d').classList.remove('on');}
 if((S.curFl|0)!==(R.fl|0)){S.curFl=R.fl|0;save();}ARR=R;if(curStep()!==5)setStep(5,true);setTool('select');$('#arrname').textContent='🛋 '+R.n;$('#arrb').classList.add('on');zoomBox(scrBox(R.poly));S.miniOn=S.miniOn!==false;updMini();log('Tu arranges : '+R.n+'. Seuls les meubles de cette pièce bougent. Touche « 🚶 Visiter » pour voir le résultat.');draw();}
function endArrange(){ARR=null;$('#arrb').classList.remove('on');updMini();log('Aménagement terminé');draw();}
function updMini(){const cv2=$('#mini3');if(!cv2)return;if(!ARR||S.miniOn===false){cv2.style.display='none';return;}cv2.style.display='block';cv2.style.right=(S.hideZoom?8:($('#viewbtns').offsetWidth+16))+'px';
 const w=190,h=116,D=Math.min(2,Math.max(1,DPR));cv2.width=w*D;cv2.height=h*D;const sv={yaw:V3.yaw,pitch:V3.pitch,tgt:V3.tgt,dist:V3.dist,d4:V3.d4,fp:V3.fp},roof=S.roof,fls=S.floors,E0=ents,b=scrBox(ARR.poly),fl=ARR.fl|0;
 try{V3.d4=false;V3.fp=null;S.roof=false;ents=E0.filter(e=>(e.fl|0)<=fl);if(!multiFl())S.floors=Math.min(S.floors|0||1,fl+1);V3.tgt=[(b[0]+b[2])/2,(b[1]+b[3])/2,fl*fpLev()+0.6];V3.dist=Math.max(b[2]-b[0],b[3]-b[1])*1.25+3;V3.pitch=0.95;V3.yaw=-Math.PI/2+0.45;render3D(cv2.getContext('2d'),w*D,h*D);}catch(e){}finally{ents=E0;Object.assign(V3,sv);S.roof=roof;S.floors=fls;}}
function arrRoomOf(e){const Q=footprint(e);const c=Q?centroid(Q):(()=>{const b=bbox(e);return [(b[0]+b[2])/2,(b[1]+b[3])/2];})();return pointInPoly(c,ARR.poly);}
function hull2(P){const p=P.slice().sort((a,b)=>a[0]-b[0]||a[1]-b[1]);if(p.length<3)return p;const cr=(o,a,b)=>(a[0]-o[0])*(b[1]-o[1])-(a[1]-o[1])*(b[0]-o[0]),lo=[],up=[];for(const q of p){while(lo.length>=2&&cr(lo[lo.length-2],lo[lo.length-1],q)<=0)lo.pop();lo.push(q);}for(let i=p.length-1;i>=0;i--){const q=p[i];while(up.length>=2&&cr(up[up.length-2],up[up.length-1],q)<=0)up.pop();up.push(q);}lo.pop();up.pop();return lo.concat(up);}
function rrect(g,x,y,w,h,r){g.beginPath();g.moveTo(x+r,y);g.lineTo(x+w-r,y);g.quadraticCurveTo(x+w,y,x+w,y+r);g.lineTo(x+w,y+h-r);g.quadraticCurveTo(x+w,y+h,x+w-r,y+h);g.lineTo(x+r,y+h);g.quadraticCurveTo(x,y+h,x,y+h-r);g.lineTo(x,y+r);g.quadraticCurveTo(x,y,x+r,y);g.closePath();}
function draw4Overlay(g,Wv,Hv){const T=phTotal(),d=Math.min(V3.day,T);let st=0,ci=S.ph.length-1,pc=100;for(let i=0;i<S.ph.length;i++){const du=+S.ph[i]||0;if(d<st+du){ci=i;pc=Math.round((d-st)/du*100);break;}st+=du;}const done=d>=T;
 let spent=0;try{const C=costs(quant()),pp=phProg(d);C.byPh.forEach((v,i)=>spent+=v*pp[i]);}catch(e){}
 const k=Math.max(0.85,Math.min(1.5,Math.min(Wv,Hv*1.6)/620)),bw=Math.min(Wv-24,320*k),bh=(spent>0||S.proj?94:76)*k,x=12,y=12;g.save();g.setLineDash([]);g.globalAlpha=0.84;g.fillStyle='#14171b';rrect(g,x,y,bw,bh,10*k);g.fill();g.globalAlpha=1;
 g.textAlign='left';g.textBaseline='alphabetic';g.fillStyle='#ff8a1f';g.font='bold '+Math.round(17*k)+'px sans-serif';g.fillText(done?'Chantier terminé ✓':(ci+1)+' · '+PH_NAMES[ci]+'   '+pc+' %',x+12*k,y+24*k);
 g.fillStyle='#ffffff';g.font=Math.round(12.5*k)+'px sans-serif';g.fillText('Jour '+Math.floor(d)+' / '+T+'   ·   '+fdate(addDate(d)),x+12*k,y+44*k);
 const sx=x+12*k,sw=bw-24*k,sy=y+54*k,sh=9*k,cols=['#8d6e63','#adb5bd','#4dabf7','#e8590c','#f2c94c','#51cf66'];let a=0;S.ph.forEach((du,i)=>{du=+du||0;if(!T)return;g.fillStyle=cols[i%6];g.globalAlpha=d>=a+du?1:(d>a?0.9:0.3);g.fillRect(sx+sw*a/T,sy,Math.max(0,sw*du/T-2),sh);a+=du;});g.globalAlpha=1;
 if(T){const mx=sx+sw*d/T;g.fillStyle='#ffffff';g.fillRect(mx-1.5,sy-3*k,3,sh+6*k);}
 if(spent>0){g.fillStyle='#ffd43b';g.font='bold '+Math.round(13*k)+'px sans-serif';g.fillText('Dépensé ≈ '+money(spent),x+12*k,y+84*k);}
 if(S.proj){g.textAlign='right';g.fillStyle='#ddd';g.font=Math.round(12*k)+'px sans-serif';g.fillText(String(S.proj).slice(0,28),x+bw-12*k,y+84*k);}g.restore();}
function rec4(){if(V3.rec){V3.rec.stop();return;}const cs=c3.captureStream?c3.captureStream(30):null;if(!cs||!window.MediaRecorder){log('Ce téléphone ne permet pas d\'enregistrer la vidéo ici');alertBar('Enregistrement vidéo impossible sur cet appareil');return;}
 const types=['video/mp4;codecs=avc1','video/mp4','video/webm;codecs=vp9','video/webm;codecs=vp8','video/webm'],mt=types.find(t=>MediaRecorder.isTypeSupported&&MediaRecorder.isTypeSupported(t))||'';let mr;try{mr=new MediaRecorder(cs,mt?{mimeType:mt,videoBitsPerSecond:6e6}:undefined);}catch(e){alertBar('Enregistrement vidéo impossible : '+(e.message||e));return;}
 const ch=[];mr.ondataavailable=e=>{if(e.data&&e.data.size)ch.push(e.data);};
 mr.onstop=()=>{V3.rec=null;$('#b4rec').textContent='🎬 Vidéo';$('#b4rec').classList.remove('on');const ty=mr.mimeType||mt||'video/webm',ext=/mp4/.test(ty)?'mp4':'webm';if(ch.length){download(safeName()+'-chantier-4D.'+ext,new Blob(ch,{type:ty}),ty);alertBar('Vidéo du chantier enregistrée ('+ext.toUpperCase()+') ✓');}};
 V3.rec=mr;mr.start(500);$('#b4rec').textContent='⏹ Arrêter';$('#b4rec').classList.add('on');fit3D();V3.day=0;V3.orbit=true;$('#b4orb').classList.add('on');V3.play=false;play4();}
function alertBar(t){const l=$('#v4lbl');if(l){l.textContent=t;}log(t);}
function setView3(k){const v=VIEWS3[k];if(!v)return;V3.yaw=v[0];V3.pitch=v[1];render3D();}
function fit3D(){const {bb,zTop}=build3D();if(!bb)return;V3.tgt=[(bb[0]+bb[2])/2,(bb[1]+bb[3])/2,zTop*0.35];V3.dist=Math.max(bb[2]-bb[0],bb[3]-bb[1],zTop*1.3,4)*1.5+4;}
function resize3D(){const r=c3.getBoundingClientRect();W3=r.width;H3=r.height;c3.width=Math.round(W3*DPR);c3.height=Math.round(H3*DPR);}
function open3D(d4){setTimeout(()=>{fill3Fl();layoutSplit();if(window.syncRoof)syncRoof();},0);if(!ents.some(e=>e.t==='wall'))log('Dessine d\'abord des murs pour voir la maison en 3D');$('#v3d').classList.add('on');V3.d4=d4;$('#v4bar').classList.toggle('on',d4);$('#b34d').classList.toggle('on',d4);$('#b3roof').classList.toggle('on',!!S.roof);$('#s3s').value=S.vstyle||'realiste';$('#d4r').max=phTotal();if(d4&&V3.day>=phTotal())V3.day=0;resize3D();fit3D();render3D();}
function upd4Label(){const T=phTotal(),d=Math.min(V3.day,T);let st=0,cur='',pc=100;for(let i=0;i<S.ph.length;i++){const du=+S.ph[i]||0;if(d<st+du){cur=PH_NAMES[i];pc=Math.round((d-st)/du*100);break;}st+=du;}
 if(d>=T||!cur){cur='Chantier terminé';pc=100;}let spent=0;try{const C=costs(quant()),pp=phProg(d);C.byPh.forEach((v,i)=>spent+=v*pp[i]);}catch(e){}
 $('#v4lbl').textContent='Jour '+Math.floor(d)+' / '+T+' · '+fdate(addDate(d))+' · '+cur+(d<T?' ('+pc+' %)':'')+(spent>0?' · dépensé ≈ '+money(spent):'');$('#d4r').value=d;}
function renderSet3(){const b=$('#set3w .wb'),inp=(l,id,v)=>'<div class="fr"><label>'+l+'</label><input id="'+id+'" value="'+v+'" inputmode="decimal"></div>',sl=(l,id,o)=>'<div class="fr"><label>'+l+'</label><select id="'+id+'">'+Object.entries(o).map(([k,v])=>'<option value="'+k+'">'+v+'</option>').join('')+'</select></div>';
 b.innerHTML=(multiFl()?'<div class="note">Étages dessinés un par un : '+nFl()+' niveaux (onglet Bâtiment › Étages).</div>':inp('Nombre d\'étages','tFl',Math.max(1,S.floors|0)))+inp('Hauteur des murs (m)','tWH',fmt(S.wallH))+inp('Épaisseur des dalles (m)','tST',fmt(S.slabT||0.2))
 +sl('Toit','tRT',{'2pans':'Deux pans','4pans':'Quatre pans',plat:'Plat (dalle)'})+inp('Pente du toit (°)','tRP',S.roofPitch||25)+inp('Débord du toit (m)','tRO',fmt(S.roofOv==null?0.5:S.roofOv))
 +sl('Murs','tWM',{crepi:'Crépi',brique:'Brique',bloc:'Bloc ciment',peint:'Peint'})+sl('Toiture','tRM',{tole:'Tôle',tuile:'Tuile',beton:'Béton'})+sl('Sol des pièces','tFM',{carrelage:'Carrelage',gcarreau:'Grand carreau',marbre:'Marbre',parquet:'Parquet',beton:'Béton ciré'})+sl('Couleur des portes','tDC',{bois:'Bois',blanc:'Blanc',gris:'Gris',noir:'Noir'})+sl('Ambiance des meubles','tTH',Object.fromEntries(Object.entries(THEMES).map(([k,v])=>[k,v.n])))+inp('Hauteur des murs en maquette (m)','tMC',fmt(S.maqCut||1.8))
 +sl('4D : les murs montent','tD4',{ensemble:'Tous ensemble',unparun:'Un par un'})+'<div class="note">'+(multiFl()?'Chaque étage a son propre plan.':'Chaque étage reprend le plan dessiné (ou crée un étage différent : Bâtiment › Nouvel étage).')+' Les escaliers relient les étages.</div>';
 if(S.floorMat==='bois')S.floorMat='parquet';if(!S.theme)S.theme='corail';[['tRT','roofType'],['tWM','wallMat'],['tRM','roofMat'],['tFM','floorMat'],['tTH','theme'],['tDC','doorCol'],['tD4','d4mode']].forEach(([id,k])=>{const x=b.querySelector('#'+id);x.value=S[k]||(k==='doorCol'?'bois':'');x.addEventListener('change',()=>{S[k]=x.value;save();render3D();});});
 [['tFl','floors',1],['tWH','wallH'],['tST','slabT'],['tRP','roofPitch'],['tRO','roofOv'],['tMC','maqCut']].forEach(([id,k,int])=>b.querySelector('#'+id).addEventListener('change',ev=>{const n=num(ev.target.value);if(isFinite(n)&&n>=0){S[k]=int?Math.max(1,Math.min(20,Math.round(n))):n;save();fit3D();render3D();}}));}
function play4(){if(V3.play){V3.play=false;$('#b4play').textContent='▶';if(V3.rec)V3.rec.stop();return;}if(V3.day>=phTotal())V3.day=0;V3.play=true;$('#b4play').textContent='⏸';let lt=performance.now();
 const step=t=>{if(!V3.play)return;const dt=Math.min(0.1,(t-lt)/1000);lt=t;V3.day=Math.min(phTotal(),V3.day+phTotal()*dt/(V3.dur||14));if(V3.orbit)V3.yaw+=dt*0.22;render3D();if(V3.day>=phTotal()){V3.play=false;$('#b4play').textContent='▶';if(V3.rec){const r=V3.rec;setTimeout(()=>{if(V3.rec===r)r.stop();},1200);}return;}requestAnimationFrame(step);};requestAnimationFrame(step);}
function renderPlan(){const b=$('#planw .wb');let st=0;const rows=S.ph.map((d,i)=>{d=+d||0;const a=st;st+=d;return '<div class="fr"><label>'+(i+1)+'. '+PH_NAMES[i]+'</label><input data-i="'+i+'" value="'+d+'" inputmode="numeric" style="max-width:64px"><span>j</span></div><div class="note" style="margin-top:-6px">'+fdate(addDate(a))+' → '+fdate(addDate(Math.max(a,st-1)))+'</div>';}).join('');
 b.innerHTML='<div class="fr"><label>Début du chantier</label><input type="date" id="pStart" value="'+S.start+'"></div>'+rows+'<div class="fr"><label><b>Durée totale</b></label><b>'+phTotal()+' jours · fin le '+fdate(addDate(Math.max(0,phTotal()-1)))+'</b></div><div class="note">Durées estimées en jours de travail. Change-les selon ton chantier.</div>';
 b.querySelector('#pStart').addEventListener('change',ev=>{if(ev.target.value){S.start=ev.target.value;save();renderPlan();render3D();}});
 b.querySelectorAll('input[data-i]').forEach(x=>x.addEventListener('change',ev=>{S.ph[+x.dataset.i]=Math.max(0,Math.round(num(ev.target.value))||0);save();$('#d4r').max=phTotal();if(V3.day>phTotal())V3.day=phTotal();renderPlan();render3D();}));}

/* ---------- travailler dans l'espace : écran partagé, édition 3D, étages ---------- */
let SPLIT=false,SELSIG='',S3RAF=0;const ED={};
function sched3(){if(!$('#v3d').classList.contains('on')||V3.play)return;if(S3RAF)return;S3RAF=requestAnimationFrame(()=>{S3RAF=0;try{render3D();}catch(e){}});}
function selSig3(){const g=[...sel].map(e=>e.id).join(',');if(g!==SELSIG){SELSIG=g;sched3();}}
function layoutSplit(){const v=$('#v3d');if(!SPLIT){['left','top','width','height','right','bottom'].forEach(k=>v.style[k]='');return;}const r=$('#main').getBoundingClientRect();Object.assign(v.style,{left:r.right+'px',top:r.top+'px',width:Math.max(120,innerWidth-r.right)+'px',height:r.height+'px',right:'auto',bottom:'auto'});}
function setSplit(on){SPLIT=!!on;document.body.classList.toggle('split3',SPLIT);$('#b3split').classList.toggle('on',SPLIT);$('#b3split').textContent=SPLIT?'⛶ 3D plein écran':'◧ Plan + 3D';if(SPLIT&&!$('#v3d').classList.contains('on'))open3D(false);resize();layoutSplit();resize3D();fit3D();render3D();if(SPLIT)log('Plan + 3D : dessine à gauche, la maison monte à droite en direct');}
function fill3Fl(){const s=$('#s3fl');if(!s)return;const n=nFl();let h='<option value="all">Tous les étages</option>';for(let i=0;i<n;i++)h+='<option value="'+i+'">'+flName(i)+'</option>';s.innerHTML=h;s.value=V3.flOnly?String(S.curFl|0):'all';}
function set3Tool(t){V3.tool=t;['vue','sel','mur'].forEach(k=>$('#t3'+k).classList.toggle('on',k===t));$('#t3obj').classList.toggle('on',t==='pose');if(t!=='mur'){V3.wp=null;}$('#t3fin').style.display=t==='mur'?'':'none';
 log(t==='pose'?'Touche le sol dans la 3D pour poser : '+(V3.pose&&OPS3[V3.pose]?OPS3[V3.pose][0]+' (près d\'un mur)':blkName(S.blockName))+' (un doigt qui glisse tourne la vue)':t==='sel'?'Touche un meuble, un mur ou une lampe dans la 3D et fais-le glisser. Le rond orange le fait tourner. Deux doigts : zoom et déplacement de la vue':t==='mur'?'Touche le sol pour poser le début du mur, puis chaque coin. ✔ Fin du mur pour arrêter':'Un doigt : tourner autour de la maison. Deux doigts : zoom et déplacement');render3D();}
function ray3(X,Y){const C=V3.cam;if(!C)return null;const dx=(X-C.W/2)/C.fl,dy=(C.H/2-Y)/C.fl,d=[0,1,2].map(i=>C.f[i]+C.r[i]*dx+C.u[i]*dy);const zp=V3.maq?0:(S.curFl|0)*fpLev();if(Math.abs(d[2])<1e-6)return null;const t=(zp-C.eye[2])/d[2];if(t<=0)return null;return [C.eye[0]+d[0]*t,C.eye[1]+d[1]*t];}
function hit3D(p){let best=null,ba=1e9;ents.forEach(e=>{if(e.t!=='block'||!visible(e))return;const Q=footprint(e);let ins;if(Q)ins=pointInPoly(p,Q);else{const b=bbox(e);ins=p[0]>=b[0]-.2&&p[0]<=b[2]+.2&&p[1]>=b[1]-.2&&p[1]<=b[3]+.2;}if(!ins)return;let a=Q?Math.abs(polyArea(Q)):0.04;if((BLOCKS[e.name]||{}).rug)a+=100;if(a<ba){ba=a;best=e;}});if(!best){ALLOWLOCK=true;best=hitTest(p,0.3);ALLOWLOCK=false;}if(best&&locked(best)){const ph=phaseOf(best);if(ph>=0)setStep(ph,true);}return best;}
function snapW(p){let best=null,bd=0.3;ents.forEach(e=>{if(e.t!=='wall'||!visible(e))return;[e.a,e.b].forEach(q=>{const d=dist(q,p);if(d<bd){bd=d;best=q;}});});if(V3.wp)V3.wp.forEach(q=>{const d=dist(q,p);if(d<bd){bd=d;best=q;}});if(best)return best.slice();
 let q=[Math.round(p[0]/0.05)*0.05,Math.round(p[1]/0.05)*0.05];const W2=V3.wp;if(W2&&W2.length){const a=W2[W2.length-1],dx=q[0]-a[0],dy=q[1]-a[1];if(Math.abs(dx)<Math.abs(dy)*0.15)q[0]=a[0];else if(Math.abs(dy)<Math.abs(dx)*0.15)q[1]=a[1];}return q.map(v=>+v.toFixed(3));}
function wallTap(p){p=snapW(p);const W2=V3.wp||(V3.wp=[]);if(W2.length&&dist(W2[W2.length-1],p)<0.05){V3.wp=null;log('Mur terminé');render3D();return;}
 if(W2.length){const a=W2[W2.length-1],q={t:'wall',a:a.slice(),b:p.slice(),th:S.wallT};if((S.curFl|0)>0)q.fl=S.curFl|0;add(q);W2.push(p);after();log('Mur ajouté : '+fmtL(dist(a,p))+' '+S.unit+' — touche le coin suivant, ou ✔ Fin du mur');}
 else{W2.push(p);log('Début du mur posé. Touche le coin suivant');}render3D();}

function rotHandle(){if(V3.tool!=='sel'||sel.size!==1)return null;const e=[...sel][0];let Q=null;if(e.t==='block'){Q=footprint(e);if(!Q){const b=bbox(e);Q=[[b[0],b[1]],[b[2],b[1]],[b[2],b[3]],[b[0],b[3]]];}}else return null;
 const c=centroid(Q),b=scrBox(Q),R=Math.max(b[2]-b[0],b[3]-b[1])/2+0.45,ws=ents.filter(w=>w.t==='wall'&&visible(w));let best=null,bs=-1;
 for(let i=0;i<4;i++){const a=(e.rot||0)-Math.PI/2+i*Math.PI/2,H=[c[0]+Math.cos(a)*R,c[1]+Math.sin(a)*R];let m=9;ws.forEach(w=>{m=Math.min(m,segDist(H,w.a,w.b)[0]);});ws.forEach(w=>{const r=segDist(w.a,c,H)[0];if(r<0.05)m=Math.min(m,0);});if(m>bs+0.05){bs=m;best=H;}}return {c,H:best};}
function v3Undo(){undo();render3D();}
const OPS3={'op:door':['Porte',{t:'door',k:''},.9,'door'],'op:door2':['Porte double',{t:'door',k:'',dbl:true},1.4,'door'],'op:vitree':['Porte vitrée',{t:'door',k:'vitree'},.9,'door'],'op:dcoul':['Porte coulissante',{t:'door',k:'coul'},1.6,'door'],'op:win':['Fenêtre',{t:'window',k:'double'},1.2,'window'],'op:wcoul':['Fenêtre coulissante',{t:'window',k:'coul'},1.6,'window'],'op:baie':['Baie vitrée',{t:'window',k:'baie'},2.4,'window'],'st:droit':['Escalier droit',null,0,'stair'],'escL':null,'escU':null,'spiral':null};
const CAT3=[['Portes et fenêtres',['op:door','op:door2','op:vitree','op:dcoul','op:win','op:wcoul','op:baie']],['Escaliers',['st:droit','escL','escU','spiral']],['Chambre',['bed2','bed1','mousse','armoire','dressing','chevet','coussin','tapis']],['Salon',['sofa','fauteuil','pouf','tv','tableR','table','chaise','etagere','lampadaire','cheminee']],['Cuisine',['ilot','kitsink','stove','frigo']],['Salle de bain',['wc','sink','shower','bath','miroir']],['Décoration',['rideau','cadre','vase','plante']],['Électricité',['lampe','spot','applique','ventilo','prise','inter','tableau','clim']],['Dehors',['tree','palmier','buisson','fleurs','car']]];
function openObj3(){const w=$('#objw'),b=w.querySelector('.wb');const rot=S.blkRot||0;
 b.innerHTML='<div class="brow">Angle : '+[0,90,180,270].map(a=>'<button class="bt'+(a===rot?' p':'')+'" data-ra="'+a+'">'+a+'°</button>').join('')+'</div><div class="og">'+CAT3.map(([t,L2])=>'<h5>'+t+'</h5>'+L2.filter(k=>BLOCKS[k]||OPS3[k]).map(k=>{const O=OPS3[k];return '<button data-ob="'+k+'"><svg viewBox="0 0 24 24">'+(IC[O?O[3]:k]||IC[k]||'<rect x="5" y="5" width="14" height="14"/>')+'</svg>'+esc(O?O[0]:blkName(k))+'</button>';}).join('')).join('')+'</div>';
 b.querySelectorAll('[data-ra]').forEach(x=>x.onclick=()=>{S.blkRot=+x.dataset.ra;save();openObj3();});
 b.querySelectorAll('[data-ob]').forEach(x=>x.onclick=()=>{const k=x.dataset.ob;if(OPS3[k]){V3.pose=k;}else{V3.pose=null;S.blockName=k;}w.classList.remove('on');set3Tool('pose');});w.classList.add('on');}
function poseOp3(p,k){const O=OPS3[k];if(!O)return;if(k==='st:droit'){const lev=fpLev(),n=Math.max(2,Math.round(lev/0.17)),L=n*0.28,a=(S.blkRot||0)*Math.PI/180+Math.PI/2,b=rnd([p[0]+Math.cos(a)*L,p[1]+Math.sin(a)*L]);const q={t:'stair',a:rnd(p),b,w:S.stairW||1,n};if((S.curFl|0)>0)q.fl=S.curFl|0;add(q);after();log('Escalier droit posé ('+n+' marches) — Angle dans ➕ Objet pour changer son sens');render3D();return;}
 let best=null,bd=0.9;ents.forEach(w=>{if(w.t!=='wall'||!visible(w))return;const r=segDist(p,w.a,w.b);if(r[0]<bd){bd=r[0];best=w;}});if(!best){log('Touche le sol tout près d\'un mur pour y mettre '+O[0].toLowerCase());return;}
 const w=best,L=dist(w.a,w.b),ux=(w.b[0]-w.a[0])/L,uy=(w.b[1]-w.a[1])/L,W2=Math.min(O[2],L-0.1);let t=(p[0]-w.a[0])*ux+(p[1]-w.a[1])*uy;t=Math.max(W2/2+0.05,Math.min(L-W2/2-0.05,t));t=Math.round(t/0.05)*0.05;
 const q=Object.assign({},O[1],{a:rnd([w.a[0]+ux*(t-W2/2),w.a[1]+uy*(t-W2/2)]),b:rnd([w.a[0]+ux*(t+W2/2),w.a[1]+uy*(t+W2/2)]),th:w.th,flip:false});if((S.curFl|0)>0)q.fl=S.curFl|0;add(q);after();log(O[0]+' posée dans le mur — touche encore pour une autre');render3D();}
function pose3(p){if(V3.pose){poseOp3(p,V3.pose);return;}const nm=S.blockName;if(!BLOCKS[nm])return;const b=blkLocalBox(nm),cx=(b[0]+b[2])/2,cy=(b[1]+b[3])/2,a=(S.blkRot||0)*Math.PI/180,co=Math.cos(a),si=Math.sin(a);
 const q={t:'block',name:nm,p:rnd([p[0]-(cx*co-cy*si),p[1]-(cx*si+cy*co)]),rot:a,sc:1,m:1};if((S.curFl|0)>0)q.fl=S.curFl|0;const sn=S.wallSnap!==false&&!!footprint(q)&&snapBlock(q,0.4);add(q);sel.clear();sel.add(q);after();
 log(blkName(nm)+' posé'+(sn?' contre le mur':'')+'. Touche encore pour en poser un autre — 👆 Déplacer pour l\'ajuster');render3D();}
function backTo2D(){if(V3.fp){stopVisit();return;}$('#b3close').click();}
setTimeout(()=>{try{const P=CAP();if(P&&P.App&&P.App.addListener)P.App.addListener('backButton',()=>{if(V3.fp){stopVisit();return;}const ws=[...document.querySelectorAll('.win.on')];if(ws.length){ws[ws.length-1].classList.remove('on');return;}if($('#v3d').classList.contains('on')){$('#b3close').click();return;}if(sel.size){sel.clear();refreshProp();draw();return;}if(tool!=='select'){setTool('select');return;}ask('Quitter Lushi Plan ? Ton plan reste gardé.',[['Rester'],['Quitter',()=>{save();try{P.App.exitApp();}catch(e){}},'d']]);});}catch(e){}},0);

(function(){const p3=new Map();let g3s=null;
 const loc3=e=>{const r=c3.getBoundingClientRect();return [e.clientX-r.left,e.clientY-r.top];};
 c3.addEventListener('pointerdown',e=>{try{c3.setPointerCapture(e.pointerId);}catch(_){}p3.set(e.pointerId,[e.clientX,e.clientY]);ED.down=[e.clientX,e.clientY];ED.mv=0;
  if(p3.size===2){if(ED.drag){if(!ED.drag.moved)undoS.pop();ED.drag=null;}const [a,b]=[...p3.values()];g3s={d:Math.hypot(a[0]-b[0],a[1]-b[1])||1,dist:V3.dist,m:[(a[0]+b[0])/2,(a[1]+b[1])/2]};return;}
  if(p3.size===1&&!V3.fp&&V3.tool==='sel'){const RH=rotHandle(),[X0,Y0]=loc3(e),g0=ray3(X0,Y0);if(RH&&g0&&dist(g0,RH.H)<0.38){snapshot();ED.rot={c:RH.c,a0:Math.atan2(g0[1]-RH.c[1],g0[0]-RH.c[0]),last:0};return;}}
  if(p3.size===1&&!V3.fp&&V3.tool==='sel'){const [X,Y]=loc3(e),g=ray3(X,Y),h=g&&hit3D(g);if(h){snapshot();if(!sel.has(h)){sel.clear();sel.add(h);}ED.drag={last:g,moved:false};refreshProp();draw();render3D();}}});
 c3.addEventListener('pointermove',e=>{if(!p3.has(e.pointerId))return;const pv=p3.get(e.pointerId);p3.set(e.pointerId,[e.clientX,e.clientY]);
  ED.mv+=Math.abs(e.clientX-pv[0])+Math.abs(e.clientY-pv[1]);
  if(p3.size>=2&&g3s){const [a,b]=[...p3.values()];V3.dist=Math.max(2,Math.min(500,g3s.dist*g3s.d/(Math.hypot(a[0]-b[0],a[1]-b[1])||1)));const m=[(a[0]+b[0])/2,(a[1]+b[1])/2],C=V3.cam;if(C&&!V3.fp){const k=V3.dist/C.fl,dx=m[0]-g3s.m[0],dy=m[1]-g3s.m[1],fx=C.f[0],fy=C.f[1],fn=Math.hypot(fx,fy)||1,rx=C.r[0],ry=C.r[1];V3.tgt=[V3.tgt[0]-(rx*dx-fx/fn*dy)*k,V3.tgt[1]-(ry*dx-fy/fn*dy)*k,V3.tgt[2]];}g3s.m=m;render3D();return;}
  if(ED.rot&&p3.size===1){const g=ray3(...loc3(e));if(g){const R=ED.rot;let a=Math.atan2(g[1]-R.c[1],g[0]-R.c[0])-R.a0;a=Math.atan2(Math.sin(a),Math.cos(a));const stp=Math.PI/36;let tot=Math.round(a/stp)*stp;const d=tot-R.last;if(Math.abs(d)>1e-9){sel.forEach(x=>rotateE(x,R.c,d));R.last=tot;BVER++;render3D();draw();log('Rotation : '+Math.round(tot*180/Math.PI)+'°');}}return;}
  if(ED.drag&&p3.size===1){const g=ray3(...loc3(e));if(g){const d=[g[0]-ED.drag.last[0],g[1]-ED.drag.last[1]];sel.forEach(x=>translate(x,d));BVER++;ED.drag.last=g;ED.drag.moved=true;render3D();draw();}return;}
  if(V3.tool==='mur'&&!V3.fp)return;
  if(V3.fp){V3.fp.yaw+=(e.clientX-pv[0])*0.006;V3.fp.pitch=Math.max(-1.1,Math.min(1.1,V3.fp.pitch-(e.clientY-pv[1])*0.005));render3D();return;}
  V3.yaw-=(e.clientX-pv[0])*0.008;V3.pitch=Math.max(0.05,Math.min(1.55,V3.pitch+(e.clientY-pv[1])*0.006));render3D();});
 const up3=e=>{const one=p3.size===1;p3.delete(e.pointerId);if(p3.size<2)g3s=null;
  if(ED.rot){const R=ED.rot;ED.rot=null;if(Math.abs(R.last)>1e-9){sel.forEach(x=>mapPts(x,rnd));after();log('Tourné de '+Math.round(R.last*180/Math.PI)+'°');}else undoS.pop();render3D();return;}
  if(one&&ED.drag){if(ED.drag.moved){sel.forEach(x=>mapPts(x,rnd));after();log('Déplacé. ⟳ 90° pour tourner, 🗑 pour effacer');}else{undoS.pop();log(entLabel([...sel][0]||{t:''})+' sélectionné : fais-le glisser, ⟳ 90° pour tourner');}ED.drag=null;return;}
  if(one&&e.type==='pointerup'&&ED.mv<14&&!V3.fp){const g=ray3(...loc3(e));if(!g)return;if(V3.tool==='mur'){wallTap(g);return;}if(V3.tool==='pose'){pose3(g);return;}if(V3.tool==='sel'){sel.clear();refreshProp();draw();render3D();}}};c3.addEventListener('pointerup',up3);c3.addEventListener('pointercancel',up3);
 c3.addEventListener('wheel',e=>{e.preventDefault();V3.dist=Math.max(2,Math.min(500,V3.dist*Math.exp(e.deltaY*0.0012)));render3D();},{passive:false});
 $('#b3top').onclick=()=>{V3.pitch=1.55;render3D();};$('#b3per').onclick=()=>{V3.pitch=0.55;render3D();};
 $('#t3obj').onclick=openObj3;$('#t3back').onclick=backTo2D;$('#b3back').onclick=backTo2D;$('#t3vue').onclick=()=>set3Tool('vue');$('#t3sel').onclick=()=>set3Tool('sel');$('#t3mur').onclick=()=>set3Tool('mur');$('#t3fin').onclick=()=>{V3.wp=null;render3D();log('Mur terminé');};
 $('#t3rot').onclick=()=>{if(!sel.size){log('Choisis d\'abord un objet avec 👆 Déplacer');return;}snapshot();const c=selCenter();sel.forEach(x=>{rotateE(x,c,Math.PI/2);mapPts(x,rnd);});after();render3D();};
 $('#t3del').onclick=()=>{eraseSel();render3D();};$('#t3undo').onclick=v3Undo;
 $('#s3fl').onchange=e=>{const v=e.target.value;if(v==='all'){V3.flOnly=false;}else{V3.flOnly=true;goFloor(+v);}fit3D();render3D();};
 $('#t3flp').onclick=()=>{if(!SPLIT)setSplit(true);act('flnew');V3.flOnly=true;setTimeout(()=>{fill3Fl();fit3D();render3D();},300);};
 const syncRoof=()=>{$('#s3roof').value=S.roof?(S.roofType||'2pans'):'none';const pv=String(S.roofPitch||25);$('#s3pente').value=[...$('#s3pente').options].some(o=>o.value===pv)?pv:'25';$('#s3pente').style.display=S.roof&&S.roofType!=='plat'?'':'none';$('#b3roof').classList.toggle('on',!!S.roof);};window.syncRoof=syncRoof;
 $('#s3roof').onchange=e=>{const v=e.target.value;S.roof=v!=='none';if(S.roof)S.roofType=v;if(S.roof){V3.flOnly=false;V3.maq=false;$('#b3maq').classList.remove('on');$('#t3maq').classList.remove('on');if(V3.tool&&V3.tool!=='vue')set3Tool('vue');}save();syncRoof();fill3Fl();render3D();log(S.roof?'Toit : '+e.target.selectedOptions[0].textContent:'Toit enlevé');};
 $('#s3pente').onchange=e=>{S.roofPitch=+e.target.value;save();render3D();};
 $('#b3split').onclick=()=>setSplit(!SPLIT);$('#t3maq').onclick=()=>$('#b3maq').click();$('#t3vis').onclick=()=>$('#b3visit').click();
 $('#b3maq').onclick=()=>{V3.maq=!V3.maq;$('#b3maq').classList.toggle('on',V3.maq);$('#t3maq').classList.toggle('on',V3.maq);if(V3.maq){V3.pitch=1.15;V3.yaw=-Math.PI/2-0.12;log('Maquette : maison vue de haut, murs coupés, meubles visibles. Ambiance et sol : bouton Bâtiment');}else V3.pitch=0.55;fit3D();if(V3.maq)V3.dist*=0.68;render3D();};
 $('#b3roof').onclick=()=>{S.roof=!S.roof;save();$('#b3roof').classList.toggle('on',S.roof);if(window.syncRoof)syncRoof();render3D();};
 $('#b34d').onclick=()=>{V3.d4=!V3.d4;V3.play=false;$('#b4play').textContent='▶';$('#v4bar').classList.toggle('on',V3.d4);$('#b34d').classList.toggle('on',V3.d4);resize3D();render3D();};
 $('#s3v').addEventListener('change',e=>{if(e.target.value)setView3(e.target.value);e.target.value='';});$('#s3s').addEventListener('change',e=>{S.vstyle=e.target.value;save();render3D();});
 $('#vLoupe').onclick=()=>act('loupe');
 $('#b3set').onclick=()=>{$('#set3w').classList.add('on');renderSet3();};
 $('#b3fit').onclick=()=>{fit3D();render3D();};$('#b3close').onclick=()=>{if(SPLIT){SPLIT=false;document.body.classList.remove('split3');layoutSplit();setTimeout(resize,30);}V3.wp=null;V3.fp=null;FPK.clear();$('#v3d').classList.remove('fp');V3.play=false;$('#b4play').textContent='▶';$('#v3d').classList.remove('on');$('#planw').classList.remove('on');if(V3.rec)V3.rec.stop();};
 $('#d4r').addEventListener('input',e=>{V3.day=+e.target.value;render3D();});$('#b4play').onclick=play4;
$('#b3visit').onclick=()=>{if(V3.fp){stopVisit();return;}fpRooms();startVisit(0);};
document.querySelectorAll('#fpc [data-fk]').forEach(b=>{const k=b.dataset.fk,on=e=>{e.preventDefault();FPK.add(k);if(!fpRaf){fpT=0;fpRaf=requestAnimationFrame(fpLoop);}},off=()=>FPK.delete(k);b.addEventListener('pointerdown',on);b.addEventListener('pointerup',off);b.addEventListener('pointerleave',off);b.addEventListener('pointercancel',off);b.addEventListener('contextmenu',e=>e.preventDefault());});
$('#fptop').addEventListener('click',e=>{const b=e.target.closest('[data-fq]');if(!b)return;const q=b.dataset.fq,i=fpCurRoom()>=0?fpCurRoom():(V3.fp?V3.fp.ri:0);
 if(q==='next')startVisit(i+1);else if(q==='prev')startVisit(i-1);else if(q==='quit')stopVisit();else if(q==='arr'){const R=FPR[fpCurRoom()];if(!R){alertBar('Entre d\'abord dans une pièce');return;}startArrange(R);}});
$('#arrb').addEventListener('click',e=>{const b=e.target.closest('[data-ar]');if(!b||!ARR)return;const q=b.dataset.ar;
 if(q==='end')endArrange();else if(q==='mini'){S.miniOn=S.miniOn===false;updMini();}else if(q==='visit'){const R=ARR;open3D(false);fpRooms();let i=FPR.findIndex(x=>x.n===R.n&&Math.abs(polyArea(x.poly)-polyArea(R.poly))<0.05);if(i<0){FPR.push(R);i=FPR.length-1;}startVisit(i);}});$('#d4sp').addEventListener('change',e=>{V3.dur=+e.target.value;});$('#b4orb').onclick=()=>{V3.orbit=!V3.orbit;$('#b4orb').classList.toggle('on',V3.orbit);if(!V3.play)render3D();};$('#b4rec').onclick=rec4;
 $('#b4plan').onclick=()=>{$('#planw').classList.add('on');renderPlan();};$('#v3b').onclick=()=>open3D(false);$('#vGomme').onclick=()=>{if(tool==='gomme'){setTool('select');log('Gomme rangée');}else{setTool('gomme');log('GOMME : touche un objet pour l\'effacer, ou glisse le doigt sur une zone. Retouche le bouton pour arrêter.');}};
 window.addEventListener('resize',()=>{if($('#v3d').classList.contains('on'))setTimeout(()=>{resize3D();render3D();},80);});})();
function init(){buildRibbon();setTimeout(()=>{updStepUI();document.querySelectorAll('.tb[data-id=wsnap]').forEach(b=>b.classList.toggle('on',S.wallSnap!==false));},0);loadDocs();const had=load();if(!had)layers=JSON.parse(JSON.stringify(DEF_LAYERS));else mergeDefaultLayers();fillMinis();
 ensureIds();renderTabs();applyUI();$('#vLoupe').classList.toggle('on',!!S.loupe);resize();if(ents.length)zoomExt();setTool('select');
 log(had&&ents.length?'Ton dernier plan est revenu. Bon travail !':'Bienvenue dans Lushi Plan. Choisis « Mur » pour commencer une maison, ou touche Aide.');}
try{init();}catch(e){showErr('Démarrage : '+(e&&e.message||e));}
</script>
</body>
</html>
