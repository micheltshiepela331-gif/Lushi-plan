 if(padGrip&&tool==='select'&&sel.has(padGrip.e)){const s=w2s(padGrip.p);c.save();c.strokeStyle='#ff8a1f';c.lineWidth=2.5;c.strokeRect(s[0]-8,s[1]-8,16,16);c.restore();}
