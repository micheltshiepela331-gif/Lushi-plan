function buildRibbon(){const tb=$('#tabs'),box=$('#ribs');
 TABS.forEach(([id,name])=>{const t=el('button','tab'+(id==='home'?' on':''),esc(name));t.dataset.t=id;tb.appendChild(t);});
 for(const [tab,groups] of Object.entries(RIB)){const r=el('div','rib'+(tab==='home'?' on':''));r.id='rib_'+tab;
  for(const [label,btns,extra,ph] of groups){const g=el('div','grp'),row=el('div','r');if(ph!=null)g.dataset.ph=ph;
   for(const [id,name] of btns){const b=el('button','tb','<svg viewBox="0 0 24 24">'+(IC[id]||'')+'</svg>'+esc(name));b.dataset.id=id;b.onclick=()=>act(id);row.appendChild(b);}
   if(extra==='wallT')row.appendChild(el('div','mini','Épaisseur<select id="wallT">'+[0.1,0.15,0.2,0.25,0.3,0.4].map(v=>'<option value="'+v+'">'+v.toFixed(2)+' m</option>').join('')+'</select>'));
   if(extra==='hpat')row.appendChild(el('div','mini','Motif<select id="hatchPat">'+Object.entries(HPAT).map(([k,l])=>'<option value="'+k+'">'+l+'</option>').join('')+'</select>'));
   if(extra==='layer')row.appendChild(el('div','mini','Calque courant<select id="laysel"></select>'));
   if(extra==='txtH')row.appendChild(el('div','mini','Hauteur<select id="txtH">'+[0.1,0.15,0.2,0.25,0.3,0.5].map(v=>'<option value="'+v+'">'+v.toFixed(2)+' m</option>').join('')+'</select>'));
   if(extra==='unit'){row.appendChild(el('div','mini','Unité<select id="unitSel"><option value="m">m</option><option value="cm">cm</option><option value="mm">mm</option></select>'));row.appendChild(el('div','mini','Précision<select id="decSel"><option value="2">1 cm</option><option value="3">1 mm</option><option value="4">0,1 mm</option></select>'));}
   g.appendChild(row);g.appendChild(el('div','gl',esc(label)));r.appendChild(g);}
  box.appendChild(r);}
 document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('on',x===t));document.querySelectorAll('.rib').forEach(x=>x.classList.toggle('on',x.id==='rib_'+t.dataset.t));resize();});
 $('#wallT').addEventListener('change',e=>{S.wallT=num(e.target.value);save();updPrompt();draw();});
 $('#txtH').addEventListener('change',e=>{S.txtH=num(e.target.value);save();});
 $('#unitSel').addEventListener('change',e=>{S.unit=e.target.value;save();updPrompt();refreshProp();if($('#setw').classList.contains('on'))renderSettings();draw();log('Unité : '+({m:'mètres',cm:'centimètres',mm:'millimètres'})[S.unit]);});
 $('#hatchPat').addEventListener('change',e=>{S.hatchPat=e.target.value;save();});
 $('#decSel').addEventListener('change',e=>{S.dec=+e.target.value;save();updPrompt();refreshProp();draw();log('Précision : '+fmtL(0)+' '+S.unit);});
 $('#laysel').addEventListener('change',e=>{curLayer=e.target.value;save();if($('#layw').classList.contains('on'))renderLayers();});}
/* ---------- contraintes (restent attachées) ---------- */
const CNAME={hor:'Horizontal',ver:'Vertical',par:'Parallèle',perp:'Perpendiculaire',equal:'Égal',coinc:'Coïncident',col:'Colinéaire',conc:'Concentrique',tan:'Tangent',fix:'Fixe',len:'Longueur',rad:'Rayon',ang:'Angle'};
const CSYM={hor:'H',ver:'V',par:'∥',perp:'⊥',equal:'=',coinc:'●',col:'≡',conc:'◎',tan:'T',fix:'🔒'};
const E=id=>ents.find(e=>e.id===id);
function ensureIds(){const seen=new Set();let mx=0;ents.forEach(e=>{if(e.id)mx=Math.max(mx,e.id);});nid=Math.max(nid,mx+1);ents.forEach(e=>{if(!e.id||seen.has(e.id)){if(!e.id&&(S.curFl|0)>0&&e.fl==null)e.fl=S.curFl|0;e.id=nid++;}seen.add(e.id);});}
const isLin=e=>!!(e&&e.a&&e.b&&(LINS.includes(e.t)||e.t==='leader'));
const angOf=e=>Math.atan2(e.b[1]-e.a[1],e.b[0]-e.a[0]);
const ptKeys=e=>e.a&&e.b?['a','b']:(e.c?['c']:(e.p&&!Array.isArray(e.p[0])?['p']:[]));
function rotTo(e,t){let d=t-angOf(e);d=Math.atan2(Math.sin(d),Math.cos(d));if(Math.abs(d)>1e-9)rotateE(e,e.a,d);}
function nearestDir(e,base){let best=base,bd=Infinity;[base,base+Math.PI].forEach(t=>{let d=t-angOf(e);d=Math.abs(Math.atan2(Math.sin(d),Math.cos(d)));if(d<bd){bd=d;best=t;}});return best;}
function geomKeys(e){const o={};['a','b','c','o','p','p1','p2','r','rx','ry','rot','a0','a1','th','w','h','n'].forEach(k=>{if(e[k]!=null)o[k]=e[k];});return JSON.stringify(o);}
function applyCon(c,fixed){const e1=E(c.ids[0]),e2=c.ids[1]!=null?E(c.ids[1]):null;if(!e1)return;let m=e2||e1,ref=e1;
 if(!e2&&fixed.has(e1.id))return;if(e2){if(fixed.has(e1.id)&&fixed.has(e2.id))return;if(fixed.has(e2.id)){m=e1;ref=e2;}}
 switch(c.t){
 case 'hor':case 'ver':{if(!isLin(e1))return;const L=dist(e1.a,e1.b);if(L<1e-9)return;if(c.t==='hor'){const sg=Math.sign(e1.b[0]-e1.a[0])||1;e1.b=[e1.a[0]+sg*L,e1.a[1]];}else{const sg=Math.sign(e1.b[1]-e1.a[1])||1;e1.b=[e1.a[0],e1.a[1]+sg*L];}break;}
 case 'len':if(isLin(e1))setLen(e1,c.v);break;
 case 'ang':if(isLin(e1)){const L=dist(e1.a,e1.b);e1.b=[e1.a[0]+L*Math.cos(c.v),e1.a[1]+L*Math.sin(c.v)];}break;
 case 'rad':if(e1.r!=null)e1.r=c.v;break;
 case 'par':if(isLin(m)&&isLin(ref))rotTo(m,nearestDir(m,angOf(ref)));break;
 case 'perp':if(isLin(m)&&isLin(ref))rotTo(m,nearestDir(m,angOf(ref)+Math.PI/2));break;
 case 'equal':if(isLin(m)&&isLin(ref))setLen(m,dist(ref.a,ref.b));else if(m.r!=null&&ref.r!=null)m.r=ref.r;break;
 case 'coinc':{const [k1,k2]=c.k||[];if(!e2||!e1[k1]||!e2[k2])return;if(m===e2)e2[k2]=e1[k1].slice();else e1[k1]=e2[k2].slice();break;}
 case 'col':if(isLin(m)&&isLin(ref)){const pr=q=>{const t=projT(q,ref.a,ref.b);return [ref.a[0]+(ref.b[0]-ref.a[0])*t,ref.a[1]+(ref.b[1]-ref.a[1])*t];};m.a=pr(m.a);m.b=pr(m.b);}break;
 case 'conc':if(m.c&&ref.c)m.c=ref.c.slice();break;
 case 'tan':{if(!e2)return;const L=isLin(e1)?e1:e2,C=isLin(e1)?e2:e1;if(!C.c||C.r==null||fixed.has(C.id))return;const D=dist(L.a,L.b);if(D<1e-9)return;const nx=-(L.b[1]-L.a[1])/D,ny=(L.b[0]-L.a[0])/D,d=(C.c[0]-L.a[0])*nx+(C.c[1]-L.a[1])*ny,k=(d>=0?1:-1)*C.r-d;C.c=[C.c[0]+nx*k,C.c[1]+ny*k];break;}}}
function solve(){if(!cons.length)return;ensureIds();cons=cons.filter(c=>c.ids.every(id=>E(id)));if(!cons.length)return;const fixed=new Set(cons.filter(c=>c.t==='fix').map(c=>c.ids[0]));
 for(let it=0;it<8;it++)cons.forEach(c=>{if(c.t!=='fix')applyCon(c,fixed);});
 cons.filter(c=>c.t==='fix').forEach(c=>{const e=E(c.ids[0]);if(e&&c.v)Object.assign(e,JSON.parse(c.v));});
 const ids=new Set();cons.forEach(c=>c.ids.forEach(i=>ids.add(i)));ents.forEach(e=>{if(ids.has(e.id))mapPts(e,rnd);});}
function addCon(t){ensureIds();const arr=[...sel];const one=['hor','ver','fix'];
 if(!arr.length){log('Sélectionne d\'abord '+(one.includes(t)?'un ou plusieurs objets':'deux objets')+' (outil Sélection), puis choisis « '+CNAME[t]+' »');return;}
 snapshot();let n=0;
 if(one.includes(t)){arr.forEach(e=>{if(t!=='fix'&&!isLin(e))return;if(cons.some(c=>c.t===t&&c.ids[0]===e.id))return;if(t!=='fix')cons=cons.filter(c=>!((c.t==='hor'||c.t==='ver'||c.t==='ang')&&c.ids[0]===e.id));cons.push({t,ids:[e.id],v:t==='fix'?geomKeys(e):undefined});n++;});}
 else{if(arr.length<2){undoS.pop();log('Sélectionne deux objets : le premier touché sert de référence');return;}const r=arr[0];
  for(const e of arr.slice(1)){const c={t,ids:[r.id,e.id]};
   if(['par','perp','col'].includes(t)&&!(isLin(r)&&isLin(e)))continue;
   if(t==='conc'&&!(r.c&&e.c))continue;
   if(t==='tan'&&!((isLin(r)&&e.r!=null&&e.c)||(isLin(e)&&r.r!=null&&r.c)))continue;
   if(t==='equal'&&!((isLin(r)&&isLin(e))||(r.r!=null&&e.r!=null)))continue;
   if(t==='coinc'){let best=null,bd=Infinity;ptKeys(r).forEach(k1=>ptKeys(e).forEach(k2=>{const d=dist(r[k1],e[k2]);if(d<bd){bd=d;best=[k1,k2];}}));if(!best)continue;c.k=best;}
   cons.push(c);n++;}}
 if(!n){undoS.pop();log('Cette contrainte ne va pas avec ces objets');return;}after();log(CNAME[t]+' : '+n+' contrainte(s). Elles restent attachées au dessin.');}
function addDimCon(t){const circ=t==='rad'||t==='dia',arr=[...sel].filter(e=>circ?e.r!=null:isLin(e));
 if(!arr.length){log(circ?'Sélectionne d\'abord des cercles ou des arcs':'Sélectionne d\'abord des lignes ou des murs');return;}ensureIds();
 const lab={len:'Longueur ('+S.unit+')',rad:'Rayon ('+S.unit+')',dia:'Diamètre ('+S.unit+')',ang:'Angle (°)'}[t];
 const cur=t==='len'?fmtL(dist(arr[0].a,arr[0].b)):t==='rad'?fmtL(arr[0].r):t==='dia'?fmtL(2*arr[0].r):(((deg(angOf(arr[0]))%360)+360)%360).toFixed(1);
 askIn('num',lab+' — actuellement '+cur+' — tape la valeur, puis Entrée',n=>{let v,tt=t;if(t==='ang')v=n*Math.PI/180;else{v=inM(n);if(!(v>0)){log('Valeur non valable');return;}}if(t==='dia'){tt='rad';v=v/2;}
  snapshot();arr.forEach(e=>{cons=cons.filter(c=>!(c.t===tt&&c.ids[0]===e.id)&&!(tt==='ang'&&(c.t==='hor'||c.t==='ver')&&c.ids[0]===e.id));cons.push({t:tt,ids:[e.id],v});});after();log('Contrainte de '+(t==='dia'?'diamètre':CNAME[tt].toLowerCase())+' : '+(tt==='ang'?n+'°':uL(t==='dia'?v*2:v))+', elle reste attachée');});}
function autoCon(){ensureIds();const arr=sel.size?[...sel]:ents.filter(visible);snapshot();let n=0;const has=(t,a)=>cons.some(c=>c.t===t&&c.ids[0]===a);
 arr.forEach(e=>{if(!isLin(e))return;const a=((deg(angOf(e))%180)+180)%180;if(has('hor',e.id)||has('ver',e.id)||has('ang',e.id))return;if(a<1||a>179){cons.push({t:'hor',ids:[e.id]});n++;}else if(Math.abs(a-90)<1){cons.push({t:'ver',ids:[e.id]});n++;}});
 for(let i=0;i<arr.length;i++)for(let j=i+1;j<arr.length;j++){const r=arr[i],e=arr[j];ptKeys(r).forEach(k1=>ptKeys(e).forEach(k2=>{if(r[k1]&&e[k2]&&dist(r[k1],e[k2])<1e-6&&!cons.some(c=>c.t==='coinc'&&c.ids.includes(r.id)&&c.ids.includes(e.id)&&c.k&&((c.ids[0]===r.id&&c.k[0]===k1&&c.k[1]===k2)||(c.ids[0]===e.id&&c.k[0]===k2&&c.k[1]===k1)))){cons.push({t:'coinc',ids:[r.id,e.id],k:[k1,k2]});n++;}}));}
 if(!n){undoS.pop();log('Aucune contrainte à ajouter');return;}after();log('Contrainte automatique : '+n+' contrainte(s) ajoutée(s)');}
function delCons(){if(!cons.length){log('Il n\'y a aucune contrainte');return;}
 if(sel.size){const ids=new Set([...sel].map(e=>e.id)),n0=cons.length;snapshot();cons=cons.filter(c=>!c.ids.some(id=>ids.has(id)));after();log((n0-cons.length)+' contrainte(s) supprimée(s)');}
 else ask('Supprimer toutes les contraintes du dessin ('+cons.length+') ?',[['Annuler'],['Tout supprimer',()=>{snapshot();cons=[];after();log('Contraintes supprimées');},'d']]);}
function renderCons(){const b=$('#consw .wb');if(!cons.length){b.innerHTML='<div class="note">Aucune contrainte. Sélectionne des objets, puis choisis une contrainte dans l\'onglet Paramétrique.</div>';return;}
 b.innerHTML=cons.map((c,i)=>{const nm=c.ids.map(id=>{const x=E(id);return x?(NAMES[x.t]||x.t)+' n°'+id:'?';}).join(' / ');
  const val=c.t==='len'||c.t==='rad'?fmtL(c.v):c.t==='ang'?deg(c.v).toFixed(2):null;
  return '<div class="fr"><label style="min-width:0;flex:1"><b>'+(CSYM[c.t]||'')+' '+CNAME[c.t]+'</b><br><span class="note">'+esc(nm)+'</span></label>'+(val!==null?'<input data-i="'+i+'" value="'+val+'" style="max-width:80px" inputmode="decimal">':'')+'<button class="bt d" data-del="'+i+'">×</button></div>';}).join('')
  +'<div class="note">Les valeurs sont en '+S.unit+' (angles en degrés). Change une valeur : le dessin suit.</div>';
 b.querySelectorAll('[data-del]').forEach(x=>x.onclick=()=>{snapshot();cons.splice(+x.dataset.del,1);after();renderCons();});
 b.querySelectorAll('input[data-i]').forEach(x=>x.addEventListener('change',()=>{const c=cons[+x.dataset.i],n=num(x.value);if(!isFinite(n))return;snapshot();c.v=c.t==='ang'?n*Math.PI/180:inM(n);after();renderCons();}));}
function drawCons(c){if(!S.showCons||!cons.length)return;const cnt={};c.save();c.font='11px '+FONT();c.textBaseline='middle';
 for(const k of cons){const e=E(k.ids[k.ids.length-1]);if(!e||!visible(e))continue;const q=bbox(e),mp=e.a&&e.b?mid(e.a,e.b):(e.c||[(q[0]+q[2])/2,(q[1]+q[3])/2]),s=w2s(mp),i=cnt[e.id]=(cnt[e.id]||0)+1;
  const txt=k.t==='len'?'L='+fmtL(k.v):k.t==='rad'?'R='+fmtL(k.v):k.t==='ang'?'∠'+deg(k.v).toFixed(1)+'°':CSYM[k.t],w=c.measureText(txt).width+8,x=s[0]+6+(i-1)*(w+3),y=s[1]-14;
  c.fillStyle='rgba(120,90,200,.88)';c.fillRect(x,y-8,w,16);c.fillStyle='#fff';c.fillText(txt,x+4,y);}
 c.restore();}
function saveView(){askIn('text','Nom de la vue, puis Entrée',n=>{const [cx,cy]=s2w(W/2,H/2);views=views.filter(v=>v.n!==n);views.push({n,cx,cy,s:view.s});save();log('Vue « '+n+' » enregistrée');});}
function renderViews(){const b=$('#viewsw .wb');b.innerHTML=views.length?views.map((v,i)=>'<div class="fr"><label style="min-width:0;flex:1">'+esc(v.n)+'</label><button class="bt p" data-go="'+i+'">Afficher</button><button class="bt d" data-del="'+i+'">×</button></div>').join(''):'<div class="note">Aucune vue enregistrée. Utilise « Enregistrer » dans l\'onglet Vue.</div>';
 b.querySelectorAll('[data-go]').forEach(x=>x.onclick=()=>{const v=views[+x.dataset.go];pushView();view.s=v.s;view.ox=W/2-v.cx*v.s;view.oy=H/2+v.cy*v.s;draw();});
 b.querySelectorAll('[data-del]').forEach(x=>x.onclick=()=>{views.splice(+x.dataset.del,1);save();renderViews();});}
function applyUI(){$('#status').style.display=S.hideStatus?'none':'';$('#cmdbar').style.display=S.hideCmd?'none':'';$('#viewbtns').style.display=S.hideZoom?'none':'';setTimeout(resize,30);}
function act(id){if(BLOCKS[id]){S.blockName=id;setTool('block');return;}
 if(/^st\d$/.test(id)){setStep(+id[2]);return;}
 switch(id){
 case 'zroom':setTool('zroom');{const n=roomList().length;log(n?'Choisis la pièce en bas, ou touche l\'intérieur d\'une pièce':'Touche l\'intérieur de la pièce où tu veux aller');}break;
 case 'visite':open3D(false);fpRooms();startVisit(0);break;
 case 'pelouse':S.solMat='pelouse';save();setTool('sol');break;
 case 'wsnap':S.wallSnap=S.wallSnap===false;save();document.querySelectorAll('.tb[data-id=wsnap]').forEach(b=>b.classList.toggle('on',S.wallSnap!==false));log(S.wallSnap!==false?'Aimant des murs activé : les meubles se collent au mur quand on les pose près':'Aimant des murs désactivé');break;
 case 'flnew':{const nf=nFl(),cf=S.curFl|0,ws=ents.filter(e=>e.t==='wall'&&visible(e));const mk=cp=>{if(cp&&ws.length){snapshot();ws.forEach(w=>{const q=cloneE(w);delete q.id;delete q.paint;q.fl=nf;ents.push(q);});}goFloor(nf);after();log(flName(nf)+' créé'+(cp&&ws.length?' : les murs de '+flName(cf).toLowerCase()+' sont recopiés, efface ou déplace ceux qui changent':' : dessine ses murs (l\'étage du dessous est en pointillés)'));};
  if(ws.length)ask('Nouvel étage ('+flName(nf)+') : recopier les murs de l\'étage actuel ?',[['Étage vide',()=>mk(false)],['Recopier les murs',()=>mk(true),'p']]);else mk(false);break;}
 case 'flup':if((S.curFl|0)+1<nFl())goFloor((S.curFl|0)+1);else log('Pas d\'étage au-dessus : touche « Nouvel étage »');break;
 case 'fldn':if((S.curFl|0)>0)goFloor((S.curFl|0)-1);else log('Tu es déjà au rez-de-chaussée');break;
 case 'facades':openFacades();break;
 case 'new':ask('Commencer un nouveau plan ? Le dessin actuel sera effacé de l\'écran (pense à l\'enregistrer avant).',[['Annuler'],['Nouveau plan',()=>{snapshot();S.curFl=0;ents=[];cons=[];views=[];sel.clear();setBg(null);saveBg();$('#fname').value='Plan sans titre';setTool('select');view.s=40;view.ox=60;view.oy=H-60;after();},'p']]);break;
 case 'open':openLib();break;case 'importdxf':$('#fileIn').click();break;
 case 'save':saveFile();break;
 case 'dxf':if(!ents.length){log('Le plan est vide');break;}download(safeName()+'.dxf',toDXF(),'application/dxf');log('DXF exporté : il s\'ouvre dans AutoCAD');break;
 case 'png':if(!ents.length){log('Le plan est vide');break;}renderSheet(200).c.toBlob(b=>{if(b){download(safeName()+'.png',b,'image/png');log('Image enregistrée');}});break;
 case 'print':case 'printw':openPrint();break;
 case 'erase':eraseSel();break;
 case 'layers':$('#layw').classList.add('on');renderLayers();break;
 case 'image':$('#imgIn').click();break;
 case 'imgop':if(!bgImg){log('Pas d\'image de fond');break;}{const o=[0.25,0.5,0.8],i=o.indexOf(bgImg.op);bgImg.op=o[(i+1)%o.length];saveBg();draw();log('Transparence de l\'image : '+Math.round(bgImg.op*100)+' %');}break;
 case 'imgdel':if(!bgImg){log('Pas d\'image de fond');break;}ask('Retirer l\'image de fond ?',[['Annuler'],['Retirer',()=>{setBg(null);saveBg();draw();log('Image retirée');},'d']]);break;
 case 'c_coinc':case 'c_col':case 'c_conc':case 'c_fix':case 'c_par':case 'c_perp':case 'c_hor':case 'c_ver':case 'c_tan':case 'c_equal':addCon(id.slice(2));break;
 case 'cauto':autoCon();break;
 case 'cshow':S.showCons=!S.showCons;save();draw();log(S.showCons?'Contraintes affichées':'Contraintes cachées (elles restent actives)');break;
 case 'cd_len':case 'cd_ang':case 'cd_rad':case 'cd_dia':addDimCon(id.slice(3));break;
 case 'cdel':delCons();break;
 case 'cmgr':$('#consw').classList.add('on');renderCons();break;
 case 'zprev':{const v=vhist.pop();if(!v){log('Pas de vue précédente');break;}view.s=v.s;view.ox=v.ox;view.oy=v.oy;draw();break;}
 case 'zwin':prevTool=tool;setTool('zwin');break;
 case 'vsave':saveView();break;
 case 'vlist':$('#viewsw').classList.add('on');renderViews();break;
 case 'ucsw':S.ucs=[0,0];save();draw();log('Repère général : l\'origine est revenue au point 0;0 du dessin');break;
 case 'pprop':if(!sel.size){log('Sélectionne d\'abord un objet');break;}setTool('select');propOpen=true;refreshProp();break;
 case 'ui_status':case 'ui_cmd':case 'ui_zoom':{const k={ui_status:'hideStatus',ui_cmd:'hideCmd',ui_zoom:'hideZoom'}[id];S[k]=!S[k];save();applyUI();break;}
 case 'resetS':ask('Remettre tous les réglages par défaut ? Ton dessin ne change pas.',[['Annuler'],['Réinitialiser',()=>{PERSIST.forEach(k=>{S[k]=JSON.parse(JSON.stringify(DEFS[k]));});save();fillMinis();applyUI();updPrompt();draw();log('Réglages remis par défaut');},'p']]);break;
 case 'overkill':{snapshot();const seen=new Set(),n0=ents.length;ents=ents.filter(e=>{if(e.a&&e.b&&e.t!=='text'&&dist(e.a,e.b)<1e-9)return false;if((e.t==='circle'||e.t==='arc')&&!(e.r>1e-9))return false;const k=e.t+'|'+e.layer+'|'+geomKeys(e)+'|'+(e.s||'')+'|'+(e.name||'');if(seen.has(k))return false;seen.add(k);return true;});
  const n=n0-ents.length;if(!n){undoS.pop();log('Rien à nettoyer : pas de doublon ni d\'objet vide');break;}sel.clear();after();log(n+' objet(s) en double ou vide(s) supprimé(s)');break;}
 case 'purge':{const used=new Set(ents.map(e=>e.layer)),def=new Set(DEF_LAYERS.map(l=>l.n)),n0=layers.length;layers=layers.filter(l=>used.has(l.n)||def.has(l.n)||l.n===curLayer);const n=n0-layers.length;save();fillMinis();log(n?n+' calque(s) vide(s) supprimé(s)':'Aucun calque vide à purger');break;}
 case 'zext':zoomExt();break;case 'zin':smoothZoom(1.5);break;case 'zout':smoothZoom(1/1.5);break;
 case 'grid':$('#sGrid').click();break;
 case 'theme':S.light=!S.light;save();draw();log(S.light?'Fond clair : pratique en plein soleil':'Fond sombre');break;
 case 'full':try{if(document.fullscreenElement)document.exitFullscreen();else document.documentElement.requestFullscreen();setTimeout(resize,300);}catch(e){log('Plein écran non disponible ici');}break;
 case 'settings':$('#setw').classList.add('on');renderSettings();break;
 case 'help':$('#help').classList.add('on');break;
 case 'quant':$('#quantw').classList.add('on');renderQuant();break;
 case 'share':share('plan');break;case 'shareimg':share('img');break;
 case 'count':{if(!ents.length){log('Le plan est vide');break;}const c={};ents.forEach(e=>{const k=e.t==='block'?'block':e.t;c[k]=(c[k]||0)+1;});
  ask('<b>'+ents.length+' objets dans le plan</b><br>'+Object.entries(c).map(([t,n])=>n+' '+(n>1?PLUR[t]:NAMES[t].toLowerCase())).join('<br>'),[['OK',null,'p']]);break;}
 case 'selall':setTool('select');ents.forEach(e=>{if(visible(e)&&!locked(e))sel.add(e);});refreshProp();updPrompt();draw();break;
 case 'seltype':case 'sellay':{if(!sel.size){log('Sélectionne d\'abord un objet modèle');break;}const ks=new Set([...sel].map(e=>id==='seltype'?e.t:e.layer));setTool('select');ents.forEach(e=>{if(visible(e)&&!locked(e)&&ks.has(id==='seltype'?e.t:e.layer))sel.add(e);});refreshProp();updPrompt();draw();log(sel.size+' objet(s) sélectionné(s)');break;}
 case 'arrayR':if(!sel.size){log('Sélectionne d\'abord les objets à répéter');break;}form('Réseau rectangulaire',[['Nombre de lignes','fR',S.arrR],['Nombre de colonnes','fC',S.arrC],['Écart entre colonnes ('+S.unit+')','fX',fmtL(S.arrDX)],['Écart entre lignes ('+S.unit+')','fY',fmtL(S.arrDY)]],v=>{
   const R=Math.max(1,Math.round(v.fR)||1),C=Math.max(1,Math.round(v.fC)||1),dx=inM(v.fX),dy=inM(v.fY);if(!isFinite(dx)||!isFinite(dy)){log('Valeurs non valables');return;}S.arrR=R;S.arrC=C;S.arrDX=dx;S.arrDY=dy;save();snapshot();const nw=[];
   for(let i=0;i<R;i++)for(let j=0;j<C;j++){if(!i&&!j)continue;sel.forEach(e=>{const q=cloneE(e);translate(q,[j*dx,i*dy]);mapPts(q,rnd);nw.push(q);});}ents.push(...nw);after();log('Réseau : '+nw.length+' copies');});break;
 case 'arrayP':if(!sel.size){log('Sélectionne d\'abord les objets à répéter');break;}form('Réseau polaire',[['Nombre d\'éléments','fN',S.arrN],['Angle total (°)','fA',S.arrA]],v=>{S.arrN=Math.max(2,Math.round(v.fN)||2);S.arrA=isFinite(v.fA)&&v.fA?v.fA:360;save();setTool('arrayP');});break;
 case 'loupe':S.loupe=!S.loupe;padP=null;save();$('#vLoupe').classList.toggle('on',S.loupe);log(S.loupe?'Zoom de précision : touche le plan, ajuste avec N S E O, puis « Poser ». En Sélection : touche un coin puis les flèches le déplacent sans casser les murs':'Zoom de précision désactivé');updPrompt();draw();break;
 case 'join':joinSel();break;
 case 'explode':explodeSel();break;
 case 'bcreate':if(!sel.size){log('Sélectionne d\'abord les objets qui formeront le bloc');break;}{const list=[...sel];askIn('text','Nom du nouveau bloc, puis Entrée',n=>{n=n.trim();if(!n)return;if(ublocks[n]){log('Ce nom existe déjà');return;}blkPending={name:n,ents:list};setTool('bbase');log('Touche le point de base du bloc');});}break;
 case 'binsert':$('#blkw').classList.add('on');renderBlocks();break;
 case 'box3d':setTool('rect');extNext=true;log('Dessine la base de la boîte, puis tape sa hauteur');break;
 case 'cyl3d':setTool('circle');extNext=true;log('Dessine la base du cylindre, puis tape sa hauteur');break;
 case 'extrude':{const L=[...sel].filter(e=>(e.t==='pline'&&e.closed)||e.t==='circle');if(!L.length){log('Sélectionne d\'abord des rectangles, polylignes fermées ou cercles');break;}askIn('num','Hauteur à donner ('+S.unit+'), puis Entrée',n=>{const h=inM(n);if(!(h>0)){log('Hauteur non valable');return;}snapshot();L.forEach(e=>{e.ext=+h.toFixed(6);e.z=e.z||0;});after();log(L.length+' volume(s) créé(s) : regarde-les en 3D');});break;}
 case 'set3d':open3D(false);$('#set3w').classList.add('on');renderSet3();break;
 case 'newtab':newDoc();break;
 case 'pdfv':{if(!ents.length){log('Le plan est vide');break;}const r=renderPdf();download(safeName()+'.pdf',r.blob,'application/pdf');log('PDF en traits enregistré'+(r.warn?' — '+r.warn:''));break;}
 case 'v3d':open3D(false);break;case 'split':setSplit(true);break;case 'v4d':V3.fp=null;$('#v3d').classList.remove('fp');open3D(true);break;
 case 'kalamu':window.open('https://micheltshiepela331-gif.github.io/KALAMU/','_blank');break;
 case 'site':window.open('https://micheltshiepela331-gif.github.io/','_blank');break;
 default:if(id.startsWith('v_')){open3D(false);setView3(id.slice(2));break;}if(id.startsWith('vs_')){S.vstyle=id.slice(3);save();$('#s3s').value=S.vstyle;if(!$('#v3d').classList.contains('on'))open3D(false);else render3D();log('Style visuel : '+({realiste:'Réaliste',conceptuel:'Conceptuel',filaire:'Filaire',rayonsx:'Rayons X'})[S.vstyle]);break;}setTool(id);}}

/* ---------- branchements ---------- */
$('#bUndo').onclick=undo;$('#bRedo').onclick=redo;$('#bSave').onclick=saveFile;
holdZoom($('#vZin'),1);holdZoom($('#vZout'),-1);$('#vRoom').onclick=()=>act('zroom');$('#vZext').onclick=()=>act('zext');
$('#fname').addEventListener('change',save);
document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>{const id=b.dataset.close;$('#'+id).classList.remove('on');if(id==='prop'){propOpen=false;}});
$('#ctx').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const c=b.dataset.c;
 if(c&&c.startsWith('pc:')){const v=c.slice(3);if(v==='all'){const ws=ents.filter(e=>e.t==='wall'&&visible(e));if(!ws.length){log('Aucun mur sur cet étage');return;}if(S.paintCol==='none'){log('Choisis d\'abord une couleur');return;}snapshot();ws.forEach(w=>w.paint=S.paintCol);after();log(ws.length+' murs peints');return;}S.paintCol=v;save();updPrompt();log(v==='none'?'Touche un mur pour enlever sa peinture':'Couleur : '+(PAINTS.find(x=>x[0]===v)||['',''])[1]+' — touche un mur');return;}
 if(c&&c.startsWith('sm:')){S.solMat=c.slice(3);save();updPrompt();log('Revêtement : '+FLOORM[S.solMat].n+' — touche l\'intérieur d\'une pièce');return;}
 if(c&&c.startsWith('ar:')){const r=roomList()[+c.slice(3)];if(r){const q=roomAt(r.p);if(q&&!q.open)startArrange({n:r.n,poly:q.poly,fl:S.curFl|0});else log('Cette pièce n\'est pas fermée');}return;}
 if(c&&c.startsWith('zr:')){const r=roomList()[+c.slice(3)];if(r){const q=roomAt(r.p);zoomBox(q&&!q.open?scrBox(q.poly):bbox(r.e));setTool('select');log('Pièce : '+r.n);}return;}
 if(c&&c.startsWith('rn:')&&waitIn){const w=waitIn;waitIn=null;w.fn(c.slice(3));$('#cmd').blur();updPrompt();draw();return;}
 if(c==='done')finish();else if(c==='close')closePline();else if(c==='back')backPoint();else if(c==='esc')escape();else if(c&&c[0]==='d')dirPoint(+c.slice(1));});
$('#cmd').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();const v=e.target.value;e.target.value='';onCmd(v);}else if(e.key==='Escape'){e.target.value='';escape();e.target.blur();}});
$('#cmdOk').onclick=()=>{const v=$('#cmd').value;$('#cmd').value='';onCmd(v);};
$('#dpad').addEventListener('click',e=>{const b=e.target.closest('[data-d]');if(!b)return;const d=b.dataset.d;
 if(d==='n')padMove(0,1);else if(d==='s')padMove(0,-1);else if(d==='e')padMove(1,0);else if(d==='o')padMove(-1,0);else if(d==='ok')padOk();
 else if(d==='st'){const i=PADST.findIndex(v=>Math.abs(v-(S.padStep||0.01))<1e-9);S.padStep=PADST[(i+1)%PADST.length];save();draw();log('Pas des flèches : '+stLbl(S.padStep));}
 else if(d==='x')act('loupe');});
$('#dpc').addEventListener('click',()=>{if(padP)padOk();});
$('#stb').addEventListener('click',e=>{const b=e.target.closest('[data-st]');if(!b)return;setStep(curStep()+(+b.dataset.st));});
$('#flb').addEventListener('click',e=>{const b=e.target.closest('[data-fl]');if(!b)return;act(b.dataset.fl==='up'?'flup':'fldn');});
document.addEventListener('keydown',e=>{const tg=e.target.tagName;if(tg==='INPUT'||tg==='SELECT'||tg==='TEXTAREA')return;
 if(S.loupe&&e.key.startsWith('Arrow')&&(padP||(tool==='select'&&sel.size)||(!NOCROSS.includes(tool)&&(cursor||pts.length)))){e.preventDefault();const k=e.key;padMove(k==='ArrowRight'?1:k==='ArrowLeft'?-1:0,k==='ArrowUp'?1:k==='ArrowDown'?-1:0);return;}
 if(e.key==='Escape'){escape();return;}if(e.key==='Enter'||e.key===' '){e.preventDefault();finish();return;}if(e.key==='Delete'){eraseSel();return;}
 if(e.key==='F8'){e.preventDefault();$('#sOrtho').click();return;}if(e.key==='F3'){e.preventDefault();$('#sOsnap').click();return;}
 if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='z'){e.preventDefault();undo();return;}if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='y'){e.preventDefault();redo();return;}
 if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='s'){e.preventDefault();saveFile();return;}
 if(e.key.length===1&&!e.ctrlKey&&!e.metaKey&&!e.altKey)$('#cmd').focus();});
[['sGrid','grid'],['sSnap','snap'],['sOsnap','osnap'],['sOrtho','ortho']].forEach(([id,k])=>{$('#'+id).onclick=()=>{S[k]=!S[k];$('#'+id).classList.toggle('on',S[k]);log(({grid:'Grille',snap:'Aimant de la grille',osnap:'Accrochage aux objets',ortho:'Mode ortho (droit)'})[k]+(S[k]?' activé':' désactivé'));draw();};});
$('#fileIn').addEventListener('change',async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;
 try{if(/\.dwg$/i.test(f.name)){log('Ouverture du DWG… le lecteur se télécharge la première fois (internet nécessaire)');const r=await readDWG(new Uint8Array(await f.arrayBuffer()));if(!r.list.length){log('Aucun objet lisible dans ce DWG');return;}loadList(r.list,f.name,null,null);if(r.skip)log('DWG ouvert : '+r.list.length+' objets ('+r.skip+' objets non pris en charge, par exemple des blocs ou des cotes)');return;}
  const txt=await f.text();let list,lays=null,bg=null,cs=null,vs=null,ub=null;if(/\.dxf$/i.test(f.name))list=parseDXF(txt);else{const d=JSON.parse(txt);list=d.ents;lays=d.layers;bg=d.bg;cs=d.cons;vs=d.views;ub=d.ublocks;}
  if(!list||!list.length){log('Aucun objet lisible dans ce fichier');return;}loadList(list,f.name,lays,bg,cs,vs,ub);}
 catch(err){log('Fichier illisible : '+(err&&err.message||err));}});
function loadList(list,name,lays,bg,cs,vs,ub){if(ents.length)newDoc(name.replace(/\.[^.]+$/,''));snapshot();ents=list;cons=cs||[];views=vs||[];ublocks=ub||{};S.curFl=0;ensureIds();if(lays&&lays.length)layers=lays;mergeDefaultLayers();for(const x of ents){if(!x.layer)x.layer='0';if(!layerOf(x.layer))layers.push({n:x.layer,c:'#ffffff',v:true});}
 if(bg&&bg.src){setBg(bg);saveBg();}$('#fname').value=name.replace(/\.[^.]+$/,'');sel.clear();fillMinis();setTool('select');zoomExt();after();log('Ouvert : '+name+' ('+ents.length+' objets)');
 const bx=extents();if(bx&&!/\.(lplan|json)$/i.test(name)&&Math.max(bx[2]-bx[0],bx[3]-bx[1])>300)ask('Ce dessin semble être en millimètres (il mesure '+Math.round(Math.max(bx[2]-bx[0],bx[3]-bx[1]))+' unités). Le convertir en mètres ?',[['Laisser tel quel'],['Convertir en mètres',()=>{snapshot();ents.forEach(x=>{scaleE(x,[0,0],0.001);mapPts(x,rnd);});zoomExt();after();log('Converti en mètres');},'p']]);}
async function readDWG(buf){const base='https://cdn.jsdelivr.net/npm/@mlightcad/libredwg-web';let mod;
 try{mod=await import(base+'/+esm');}catch(e){throw new Error('le lecteur DWG n\'a pas pu être téléchargé : vérifie ta connexion internet');}
 const LD=mod.LibreDwg||(mod.default&&mod.default.LibreDwg);if(!LD)throw new Error('lecteur DWG incompatible');
 let lib;try{lib=await LD.create(base+'/wasm/');}catch(e){throw new Error('le lecteur DWG n\'a pas pu démarrer');}
 const ptr=lib.dwg_read_data(buf,0);if(!ptr)throw new Error('ce DWG n\'a pas pu être lu (version trop récente ou fichier abîmé). Enregistre-le en DXF dans AutoCAD');
 let db;try{db=lib.convert(ptr);}finally{try{lib.dwg_free(ptr);}catch(_){}}return dwgEnts(db);}
function dwgEnts(db){const list=(db&&(db.entities||(db.modelSpace&&db.modelSpace.entities)))||[],out=[];let skip=0;
 const Pt=v=>v?[+v.x||0,+v.y||0]:null,ang=a=>{a=+a||0;return Math.abs(a)>2*Math.PI+0.01?a*Math.PI/180:a;};
 for(const e of list){const la=e.layer||'0';try{switch(e.type){
  case 'LINE':out.push({t:'line',a:Pt(e.startPoint),b:Pt(e.endPoint),layer:la});break;
  case 'CIRCLE':out.push({t:'circle',c:Pt(e.center),r:+e.radius,layer:la});break;
  case 'ARC':out.push({t:'arc',c:Pt(e.center),r:+e.radius,a0:ang(e.startAngle),a1:ang(e.endAngle),layer:la});break;
  case 'LWPOLYLINE':case 'POLYLINE2D':case 'POLYLINE':{const vs=(e.vertices||[]).map(Pt).filter(Boolean);if(vs.length>1)out.push({t:'pline',p:vs,closed:((+e.flag||0)&1)===1||!!e.closed,layer:la});else skip++;break;}
  case 'TEXT':case 'MTEXT':{const t=String(e.text||'').replace(/\\P/g,' ').replace(/\\[A-Za-z][^;]*;/g,'').replace(/[{}]/g,'');if(t)out.push({t:'text',p:Pt(e.startPoint||e.insertionPoint||e.position),s:t,h:+(e.textHeight||e.height)||0.2,rot:ang(e.rotation),layer:la});break;}
  case 'ELLIPSE':{const c=Pt(e.center),M=Pt(e.majorAxisEndPoint);if(c&&M){const rx=Math.hypot(M[0],M[1]);out.push({t:'ellipse',c,rx,ry:rx*(+e.axisRatio||1),rot:Math.atan2(M[1],M[0]),layer:la});}break;}
  default:skip++;}}catch(_){skip++;}}
 const ok=x=>Array.isArray(x)?x.every(ok):(x!==null&&(typeof x!=='number'||isFinite(x)));
 return {list:out.filter(e=>Object.values(e).every(ok)),skip};}
$('#imgIn').addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();
 r.onload=()=>{const im=new Image();im.onload=()=>{const mx=1600,k=Math.min(1,mx/Math.max(im.width,im.height)),c2=document.createElement('canvas');c2.width=Math.round(im.width*k);c2.height=Math.round(im.height*k);c2.getContext('2d').drawImage(im,0,0,c2.width,c2.height);
  const src=c2.toDataURL('image/jpeg',0.75),[x0,y1]=s2w(0,0),[x1,y0]=s2w(W,H),w=(x1-x0)*0.8,h=w*c2.height/c2.width;
  setBg({src,x:(x0+x1)/2-w/2,y:(y0+y1)/2-h/2,w,h,op:0.5});saveBg();draw();
  log('Image insérée. Utilise « Calibrer » pour la mettre à la bonne échelle, puis dessine par-dessus.');};im.src=String(r.result);};
 r.readAsDataURL(f);e.target.value='';});
$('#rotgo').onclick=()=>{document.body.classList.add('port');setTimeout(resize,50);};
window.addEventListener('resize',()=>setTimeout(()=>{resize();if(SPLIT){layoutSplit();resize3D();render3D();}},60));
window.addEventListener('orientationchange',()=>setTimeout(resize,250));

/* ---------- 3D / 4D ---------- */
const PH_NAMES=['Fondation','Murs','Ouvertures','Escaliers et toiture','Finitions et réseaux','Design et jardin'];
const BH={bed2:.5,bed1:.5,table:.75,sofa:.8,wc:.4,sink:.85,shower:.05,bath:.55,stove:.9,kitsink:.9,car:1.5};
const V3={yaw:-0.9,pitch:0.55,dist:20,tgt:[0,0,1.5],d4:false,day:0,play:false};
const c3=$('#c3d'),g3=c3.getContext('2d');let W3=0,H3=0;
const phTotal=()=>S.ph.reduce((a,b)=>a+(+b||0),0);
function phProg(day){const out=[];let st=0;S.ph.forEach(d=>{d=+d||0;out.push(d<=0?(day>=st?1:0):Math.max(0,Math.min(1,(day-st)/d)));st+=d;});return out;}
function addDate(n){const d=new Date((S.start||new Date().toISOString().slice(0,10))+'T00:00:00');d.setDate(d.getDate()+Math.floor(n));return d;}
const fdate=d=>isNaN(d)?'—':d.toLocaleDateString('fr-FR',{day:'numeric',month:'short',year:'numeric'});
function prism(F,Q,z0,z1,col,a){if(z1-z0<1e-6||Q.length<3)return;if(polyArea(Q)<0)Q=Q.slice().reverse();const n=Q.length;
 F.push({p:Q.slice().reverse().map(q=>[q[0],q[1],z0]),col,a});F.push({p:Q.map(q=>[q[0],q[1],z1]),col,a});
 for(let i=0;i<n;i++){const A=Q[i],B=Q[(i+1)%n];F.push({p:[[A[0],A[1],z0],[B[0],B[1],z0],[B[0],B[1],z1],[A[0],A[1],z1]],col,a});}}
function ngon(c,r,n){const Q=[];for(let i=0;i<n;i++){const a=i/n*2*Math.PI;Q.push([c[0]+r*Math.cos(a),c[1]+r*Math.sin(a)]);}return Q;}
function quadAlong(A,ux,uy,nx,ny,t0,t1,h){return [[A[0]+ux*t0+nx*h,A[1]+uy*t0+ny*h],[A[0]+ux*t1+nx*h,A[1]+uy*t1+ny*h],[A[0]+ux*t1-nx*h,A[1]+uy*t1-ny*h],[A[0]+ux*t0-nx*h,A[1]+uy*t0-ny*h]];}
const WMAT={crepi:[234,224,204],brique:[178,92,62],bloc:[168,168,162],peint:[244,242,234]},RMAT={tole:[140,152,165],tuile:[176,76,54],beton:[172,172,170]},FMAT={carrelage:[214,196,160],beton:[192,192,186],bois:[172,124,82]};
const hex2rgb=h=>{const m=/^#?([0-9a-f]{6})$/i.exec(h||'');if(!m)return [200,200,210];const v=parseInt(m[1],16);return [v>>16&255,v>>8&255,v&255];};
function roofFaces(out,bb,z,pr){const ov=S.roofOv==null?0.5:S.roofOv,x0=bb[0]-ov,y0=bb[1]-ov,x1=bb[2]+ov,y1=bb[3]+ov,col=RMAT[S.roofMat]||RMAT.tole,gc=WMAT[S.wallMat]||WMAT.crepi,typ=S.roofType||'2pans',pt=Math.tan((S.roofPitch||25)*Math.PI/180)*pr;
 if(typ==='plat'||pt<1e-4){prism(out,[[x0,y0],[x1,y0],[x1,y1],[x0,y1]],z,z+0.2*Math.max(pr,0.05),col);return;}
 const W=x1-x0,D=y1-y0,alongX=W>=D,half=(alongX?D:W)/2,h=half*pt,F=(p,c2)=>out.push({p,col:c2||col,ds:true,gab:!!c2});
 if(alongX){const ym=(y0+y1)/2,hb=((bb[3]-bb[1])/2+ov)*pt;
  if(typ==='4pans'){const rx0=x0+half,rx1=x1-half;F([[x0,y0,z],[x1,y0,z],[rx1,ym,z+h],[rx0,ym,z+h]]);F([[x1,y1,z],[x0,y1,z],[rx0,ym,z+h],[rx1,ym,z+h]]);F([[x0,y1,z],[x0,y0,z],[rx0,ym,z+h]]);F([[x1,y0,z],[x1,y1,z],[rx1,ym,z+h]]);}
  else{F([[x0,y0,z],[x1,y0,z],[x1,ym,z+h],[x0,ym,z+h]]);F([[x1,y1,z],[x0,y1,z],[x0,ym,z+h],[x1,ym,z+h]]);const zb=z+ov*pt;F([[bb[0],bb[3],zb],[bb[0],bb[1],zb],[bb[0],ym,z+hb]],gc);F([[bb[2],bb[1],zb],[bb[2],bb[3],zb],[bb[2],ym,z+hb]],gc);}}
 else{const xm=(x0+x1)/2,hb=((bb[2]-bb[0])/2+ov)*pt;
  if(typ==='4pans'){const ry0=y0+half,ry1=y1-half;F([[x1,y0,z],[x1,y1,z],[xm,ry1,z+h],[xm,ry0,z+h]]);F([[x0,y1,z],[x0,y0,z],[xm,ry0,z+h],[xm,ry1,z+h]]);F([[x0,y0,z],[x1,y0,z],[xm,ry0,z+h]]);F([[x1,y1,z],[x0,y1,z],[xm,ry1,z+h]]);}
  else{F([[x1,y0,z],[x1,y1,z],[xm,y1,z+h],[xm,y0,z+h]]);F([[x0,y1,z],[x0,y0,z],[xm,y0,z+h],[xm,y1,z+h]]);const zb=z+ov*pt;F([[bb[0],bb[1],zb],[bb[2],bb[1],zb],[xm,bb[1],z+hb]],gc);F([[bb[2],bb[3],zb],[bb[0],bb[3],zb],[xm,bb[3],z+hb]],gc);}}}
/* ---------- meubles 3D réalistes, ambiances, sols décorés ---------- */
const THEMES={
 corail:{n:'Corail et blanc',wood:[228,214,194],woodD:[196,178,152],frame:[242,238,232],lin:[250,248,244],fab:[240,128,104],sofa:[244,241,236],acc:[240,124,100],rug:[214,198,176],counter:[246,246,244],metal:[198,202,208],dark:[36,38,44],plant:[74,150,80]},
