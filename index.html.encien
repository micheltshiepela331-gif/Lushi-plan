  c.restore();c.save();c.strokeStyle='#ff8a1f';c.lineWidth=3;c.beginPath();c.arc(dx,dy,R,0,Math.PI*2);c.stroke();
  const u=U(),txt=fmtL(cursor[0]-u[0])+' ; '+fmtL(cursor[1]-u[1])+(snapHit?'  '+snapHit.ty:'');c.font='12px '+FONT();const tw=c.measureText(txt).width;c.fillStyle='rgba(0,0,0,.75)';c.fillRect(dx-tw/2-6,dy+R+4,tw+12,18);c.fillStyle='#fff';c.textAlign='center';c.fillText(txt,dx,dy+R+17);c.restore();}}
const NOCROSS=['select','pan','zwin','gomme'];
const ERRSEEN={};function SAFE(nm,fn){try{fn();}catch(e){const k=nm+':'+(e&&e.message);if(!ERRSEEN[k]){ERRSEEN[k]=1;const st=String(e&&e.stack||'').split('\n').slice(0,3).join(' | ');if(typeof showErr==='function')showErr('['+nm+'] '+(e&&e.message||e)+' — '+st);}try{ctx.restore();}catch(_){}}}
/* ---------- zoom de direction (N S E O) ---------- */
let padP=null,padGrip=null,FAST=false,zA=null,propOpen=false;
function roomList(){return ents.filter(e=>e.t==='text'&&e.room&&visible(e)).map(e=>{const b=bbox(e);return {e,n:String(e.s).split('\n')[0],p:[(b[0]+b[2])/2,(b[1]+b[3])/2]};});}
function animView(ns,c,ms){ns=clampS(ns);if(zA)cancelAnimationFrame(zA);const s0=view.s,c0=[(W/2-view.ox)/view.s,(view.oy-H/2)/view.s],t0=performance.now();ms=ms||280;FAST=true;
 const f=t=>{let k=Math.min(1,(t-t0)/ms);k=1-Math.pow(1-k,3);const sc=s0*Math.pow(ns/s0,k),cx=c0[0]+(c[0]-c0[0])*k,cy=c0[1]+(c[1]-c0[1])*k;view.s=sc;view.ox=W/2-cx*sc;view.oy=H/2+cy*sc;drawNow();if(k<1)zA=requestAnimationFrame(f);else{zA=null;FAST=false;drawNow();}};zA=requestAnimationFrame(f);}
function zoomBox(b){pushView();const w=Math.max(b[2]-b[0],0.3),h=Math.max(b[3]-b[1],0.3);animView(Math.min(W/w,H/h)*0.8,[(b[0]+b[2])/2,(b[1]+b[3])/2],420);}
function zAnchorW(){if(tool==='select'&&sel.size)return selCenter();if(padP)return padP;if(pts.length&&cursor&&!NOCROSS.includes(tool))return cursor;return null;}
function smoothZoom(f){pushView();const a=zAnchorW();animView(view.s*f,a||[(W/2-view.ox)/view.s,(view.oy-H/2)/view.s]);}
function holdZoom(btn,dir){let held=null,lt=0,started=false,tm=null;const stop=()=>{clearTimeout(tm);if(held){cancelAnimationFrame(held);held=null;FAST=false;drawNow();}};
 btn.addEventListener('pointerdown',e=>{e.preventDefault();started=false;clearTimeout(tm);tm=setTimeout(()=>{started=true;pushView();lt=performance.now();FAST=true;const a=zAnchorW();
  const run=t=>{const dt=Math.min(0.05,(t-lt)/1000);lt=t;const X=a?w2s(a):[W/2,H/2],ns=clampS(view.s*Math.exp(dir*dt*0.7)),wx=(X[0]-view.ox)/view.s,wy=(X[1]-view.oy)/view.s;view.s=ns;view.ox=X[0]-wx*ns;view.oy=X[1]-wy*ns;drawNow();held=requestAnimationFrame(run);};held=requestAnimationFrame(run);},300);});
 btn.addEventListener('pointerup',()=>{const was=started;stop();if(!was)smoothZoom(dir>0?1.5:1/1.5);});btn.addEventListener('pointerleave',stop);btn.addEventListener('pointercancel',stop);}
/* ---------- barre collée à l'objet ---------- */
function blkNat(nm){const g=blockPrims({name:nm,p:[0,0],rot:0,sc:1,m:1});const P2=[];g.l.forEach(q=>P2.push(q[0],q[1]));g.c.forEach(([c2,r])=>P2.push([c2[0]-r,c2[1]-r],[c2[0]+r,c2[1]+r]));if(!P2.length)return [1,1];const b=scrBox(P2);return [Math.max(1e-6,b[2]-b[0]),Math.max(1e-6,b[3]-b[1])];}
function dimsOf(e){if(e.t==='block'&&!String(e.name).startsWith('u:')){const n=blkNat(e.name),k=e.sc||1;return [['Largeur',n[0]*k*(e.sx||1)],['Prof.',n[1]*k*(e.sy||1)]];}
 if(e.t==='elem')return [['Longueur',dist(e.a,e.b)]].concat(e.w?[['Largeur',e.w]]:[]);if(e.t==='stair')return [['Longueur',dist(e.a,e.b)],['Largeur',e.w]];
 if(['wall','door','window','line'].includes(e.t))return [['Longueur',dist(e.a,e.b)]];if(e.t==='circle')return [['Diamètre',2*e.r]];return [];}
function setDim(e,i,v){if(!(v>0)||!e)return;snapshot();if(e.t==='block'){const n=blkNat(e.name),k=e.sc||1;if(i===0)e.sx=v/(n[0]*k);else e.sy=v/(n[1]*k);}else if(e.t==='circle')e.r=v/2;else if(i===0)setLen(e,v);else e.w=v;after();}
function selDists(){if(!sel.size)return null;let b=null;sel.forEach(e=>{const q=footprint(e)?scrBox(footprint(e)):bbox(e);if(isFinite(q[0]))b=b?[Math.min(b[0],q[0]),Math.min(b[1],q[1]),Math.max(b[2],q[2]),Math.max(b[3],q[3])]:q;});if(!b)return null;return distsFor(b,sel);}
function drawDistLines(c,OD){if(!OD||!OD.d)return;c.save();c.setLineDash([5,4]);c.strokeStyle='#ff8a1f';c.fillStyle='#ff8a1f';c.lineWidth=1.3;c.font='bold 11px '+FONT();c.textAlign='center';const dirs=[[-1,0],[1,0],[0,1],[0,-1]];OD.d.forEach((d,i)=>{if(!isFinite(d)||d>60||d<1e-4)return;const a=OD.o[i],b=[a[0]+dirs[i][0]*d,a[1]+dirs[i][1]*d],sa=w2s(a),sb=w2s(b);if(Math.hypot(sb[0]-sa[0],sb[1]-sa[1])<6)return;c.beginPath();c.moveTo(sa[0],sa[1]);c.lineTo(sb[0],sb[1]);c.stroke();const m=[(sa[0]+sb[0])/2,(sa[1]+sb[1])/2],t=fmtL(d),tw=c.measureText(t).width;c.save();c.setLineDash([]);c.fillStyle='rgba(0,0,0,.75)';c.fillRect(m[0]-tw/2-4,m[1]-8,tw+8,16);c.fillStyle='#ffb066';c.fillText(t,m[0],m[1]+4);c.restore();});c.restore();}
function distsFor(b,skip){
 const sg=[];ents.forEach(w=>{if(w.t!=='wall'||!visible(w)||(skip&&skip.has(w)))return;const Q=wallPoly(w);for(let i=0;i<4;i++)sg.push([Q[i],Q[(i+1)%4]]);});if(!sg.length)return {b,d:null};
 const cx=(b[0]+b[2])/2,cy=(b[1]+b[3])/2,ray=(o,dx,dy)=>{let best=Infinity;for(const [a,c2] of sg){const ex=c2[0]-a[0],ey=c2[1]-a[1],den=dx*ey-dy*ex;if(Math.abs(den)<1e-12)continue;const ax=a[0]-o[0],ay=a[1]-o[1],t=(ax*ey-ay*ex)/den,u=(ax*dy-ay*dx)/den;if(t>=-1e-9&&u>=-1e-9&&u<=1+1e-9&&t<best)best=Math.max(0,t);}return best;};
 return {b,o:[[b[0],cy],[b[2],cy],[cx,b[3]],[cx,b[1]]],d:[ray([b[0],cy],-1,0),ray([b[2],cy],1,0),ray([cx,b[3]],0,1),ray([cx,b[1]],0,-1)]};}
const SIZES={rideau:[[1.2,.12],[1.6,.12],[2.4,.12],[3,.12]],mousse:[[0.9,1.9],[1.2,1.9],[1.4,1.9],[1.6,2.0]],dressing:[[1.2,.6],[1.8,.6],[2.4,.6]],ilot:[[1.4,.9],[1.8,.9],[2.4,1.0]],etagere:[[.6,.3],[.9,.35],[1.2,.35]],tapis:[[1.6,1.2],[2,1.4],[2.4,1.7],[3,2]],fauteuil:[[0.75,0.75],[0.85,0.85],[0.95,0.9]],bed2:[[1.4,1.9],[1.6,2.0],[1.8,2.0]],bed1:[[0.9,1.9],[1.2,1.9]],sofa:[[1.6,0.9],[2.0,0.9],[2.4,0.9]],armoire:[[1.0,0.6],[1.2,0.6],[1.6,0.6],[2.0,0.6]],placard:[[1.2,0.6],[1.8,0.6],[2.4,0.6]],bureau:[[1.0,0.5],[1.2,0.6],[1.4,0.7]],tv:[[1.2,0.4],[1.6,0.45],[2.0,0.45]],bath:[[0.7,1.6],[0.75,1.7],[0.8,1.8]],shower:[[0.8,0.8],[0.9,0.9],[1.2,0.9]],frigo:[[0.6,0.65],[0.7,0.7],[0.9,0.75]],kitsink:[[0.8,0.6],[1.2,0.6]],stove:[[0.5,0.6],[0.6,0.6],[0.9,0.6]]};
const BLB={};function blkLocalBox(nm){if(BLB[nm])return BLB[nm];const g=blockPrims({name:nm,p:[0,0],rot:0,sc:1,m:1});const P2=[];g.l.forEach(q=>P2.push(q[0],q[1]));g.c.forEach(([c2,r])=>P2.push([c2[0]-r,c2[1]-r],[c2[0]+r,c2[1]+r]));return BLB[nm]=P2.length?scrBox(P2):[0,0,1,1];}
function footprint(e){if(e.t!=='block'||String(e.name).startsWith('u:'))return null;const B=BLOCKS[e.name];if(!B||B.sym)return null;const b=blkLocalBox(e.name),T=blockPrims(e).T;let Q=[T(b[0],b[1]),T(b[2],b[1]),T(b[2],b[3]),T(b[0],b[3])];if(polyArea(Q)<0)Q=Q.reverse();return Q;}
function satDepth(A,B){let best=Infinity;for(const Pp of [A,B])for(let i=0;i<Pp.length;i++){const a=Pp[i],b=Pp[(i+1)%Pp.length];let nx=-(b[1]-a[1]),ny=b[0]-a[0];const l=Math.hypot(nx,ny);if(l<1e-12)continue;nx/=l;ny/=l;let a0=Infinity,a1=-Infinity,b0=Infinity,b1=-Infinity;A.forEach(q=>{const v=q[0]*nx+q[1]*ny;if(v<a0)a0=v;if(v>a1)a1=v;});B.forEach(q=>{const v=q[0]*nx+q[1]*ny;if(v<b0)b0=v;if(v>b1)b1=v;});const o=Math.min(a1,b1)-Math.max(a0,b0);if(o<=0)return 0;if(o<best)best=o;}return best;}
const cmTxt=v=>Math.round(v*100)+' cm';
const FITX=e=>{if(e.t!=='block'||String(e.name).startsWith('u:'))return false;const B=BLOCKS[e.name]||{};return !B.sym&&!B.flat&&!B.rug&&!B.wallm&&!B.palm&&e.name!=='tree'&&e.name!=='car'&&B.lay!=='Jardin'&&!B.under;};
let CONF=new Map();
function conflicts(){const items=[];ents.forEach(e=>{if(visible(e)&&FITX(e)){const Q=footprint(e);if(Q)items.push({e,Q,b:scrBox(Q)});}});const out=new Map();if(!items.length||items.length>300)return out;
 const walls=ents.filter(w=>w.t==='wall'&&visible(w)).map(w=>{const Q=wallPoly(w);return {Q,b:scrBox(Q)};}),ov=(a,b)=>!(a[2]<b[0]||a[0]>b[2]||a[3]<b[1]||a[1]>b[3]),add2=(e,t)=>{if(!out.has(e))out.set(e,[]);out.get(e).push(t);};
 items.forEach(it=>{if((BLOCKS[it.e.name]||{}).struct)return;let dm=0;walls.forEach(W2=>{if(ov(it.b,W2.b)){const d=satDepth(it.Q,W2.Q);if(d>dm)dm=d;}});if(dm>0.005)add2(it.e,'entre de '+cmTxt(dm)+' dans un mur');});
 for(let i=0;i<items.length;i++)for(let j=i+1;j<items.length;j++){if(!ov(items[i].b,items[j].b))continue;const d=satDepth(items[i].Q,items[j].Q);if(d>0.005){add2(items[i].e,'chevauche : '+entLabel(items[j].e)+' ('+cmTxt(d)+')');add2(items[j].e,'chevauche : '+entLabel(items[i].e)+' ('+cmTxt(d)+')');}}
 return out;}
function snapBlock(e,tol){tol=tol||0.3;if(!footprint(e))return false;const faces=[];ents.forEach(w=>{if(w.t!=='wall'||!visible(w))return;let Pc=wallPoly(w);if(polyArea(Pc)<0)Pc=Pc.slice().reverse();for(let i=0;i<4;i++){const a=Pc[i],b=Pc[(i+1)%4],L=dist(a,b);if(L<1e-6)continue;const ux=(b[0]-a[0])/L,uy=(b[1]-a[1])/L;faces.push({a,L,ux,uy,nx:uy,ny:-ux});}});
 const done=[];let moved=false;for(let pass=0;pass<2;pass++){const Q=footprint(e);let best=null;
  for(const f of faces){if(done.some(m=>Math.abs(m[0]*f.nx+m[1]*f.ny)>0.9))continue;let t0=Infinity,t1=-Infinity,dmin=Infinity,ds=0;Q.forEach(q=>{const t=(q[0]-f.a[0])*f.ux+(q[1]-f.a[1])*f.uy,d=(q[0]-f.a[0])*f.nx+(q[1]-f.a[1])*f.ny;t0=Math.min(t0,t);t1=Math.max(t1,t);dmin=Math.min(dmin,d);ds+=d;});
   if(t1<0.02||t0>f.L-0.02||ds/Q.length<0)continue;let par=false;for(let i=0;i<4;i++){const a=Q[i],b=Q[(i+1)%4],l=dist(a,b);if(l>1e-6&&Math.abs(((b[0]-a[0])*f.ux+(b[1]-a[1])*f.uy)/l)>0.996)par=true;}if(!par||Math.abs(dmin)>tol)continue;
   if(!best||Math.abs(dmin)<Math.abs(best.d))best={f,d:dmin};}
  if(!best)break;done.push([best.f.nx,best.f.ny]);if(Math.abs(best.d)>1e-4){translate(e,[-best.f.nx*best.d,-best.f.ny*best.d]);mapPts(e,rnd);moved=true;}}
 return moved;}
function setSize(e,w,h){if(e.t!=='block')return;const n=blkNat(e.name),k=e.sc||1;snapshot();e.sx=w/(n[0]*k);e.sy=h/(n[1]*k);after();}
function roomAtFoot(e){const Q=footprint(e);if(!Q)return null;return centroid(Q);}
let ROOMHL=null;
function roomInfo(p){const r=roomAt(p);if(!r||r.open){log('Touche l\'intérieur d\'une pièce fermée');return;}ROOMHL=r.poly;const bb=scrBox(r.poly),inP=q=>pointInPoly(q,r.poly)&&!r.holes.some(H=>pointInPoly(q,H));
 const lab=ents.find(e=>e.t==='text'&&e.room&&visible(e)&&inP(e.p)),name=lab?String(lab.s).split('\n')[0]:'Pièce';
 const C=conflicts(),items=ents.filter(e=>visible(e)&&FITX(e)&&(()=>{const c2=roomAtFoot(e);return c2&&inP(c2);})());
 let occ=0;const rows=items.map(e=>{const Q=footprint(e),a=Math.abs(polyArea(Q)),d=dimsOf(e);occ+=a;const bad=C.get(e);return '<tr><td>'+esc(entLabel(e))+(bad?'<br><span class="bad">⚠ '+esc(bad.join(' ; '))+'</span>':'')+'</td><td>'+(d.length>1?fmtL(d[0][1])+' × '+fmtL(d[1][1]):'')+'</td></tr>';}).join('');
 const free=Math.max(0,r.area-occ),pc=r.area>0?Math.round(free/r.area*100):0,nb=items.filter(e=>C.has(e)).length;
 const rect=r.poly.length===4&&!r.holes.length;
 const b=$('#roomw .wb');b.innerHTML='<h4 style="color:var(--ac);margin:0">'+esc(name)+'</h4><table class="tbl">'+(rect?'<tr><td>Dimensions intérieures</td><td><b>'+fmtL(bb[2]-bb[0])+' × '+fmtL(bb[3]-bb[1])+' '+S.unit+'</b></td></tr>':'<tr><td>Encombrement</td><td>'+fmtL(bb[2]-bb[0])+' × '+fmtL(bb[3]-bb[1])+' '+S.unit+'</td></tr>')
  +'<tr><td>Surface au sol</td><td><b>'+fmt(r.area).replace('.',',')+' m²</b></td></tr><tr><td>Périmètre</td><td>'+fmtL(perim({t:'pline',p:r.poly,closed:true}))+' '+S.unit+'</td></tr><tr><td>Occupé par les meubles</td><td>'+fmt(occ).replace('.',',')+' m²</td></tr><tr class="big"><td>Surface libre pour circuler</td><td>'+fmt(free).replace('.',',')+' m² ('+pc+' %)</td></tr></table>'
  +(items.length?'<h4 style="margin:4px 0 0">Meubles dans la pièce ('+items.length+')</h4><table class="tbl">'+rows+'</table>':'<div class="note">Aucun meuble dans cette pièce pour le moment.</div>')
  +(nb?'<div class="bad">⚠ '+nb+' meuble(s) ne tiennent pas bien : ils sont en rouge sur le plan. Pousse-les avec les flèches ou réduis leur taille.</div>':(items.length?'<div class="ok">✓ Tout tient dans la pièce</div>':''))
  +(pc<40&&items.length?'<div class="note">Moins de 40 % de place libre : la pièce risque d\'être encombrée. Garde au moins 60 à 80 cm pour passer devant les lits et les armoires.</div>':'')
  +'<div class="brow"><button class="bt" id="rmZoom">Agrandir la pièce</button></div>';
 $('#roomw').classList.add('on');b.querySelector('#rmZoom').onclick=()=>zoomBox(bb);draw();}
const fdst=v=>isFinite(v)&&v<60?fmtL(v):'—';
function obarBuild(){const o=$('#obar');if(!o)return;if(tool!=='select'||!sel.size){o.classList.remove('on');return;}
 const one=sel.size===1?[...sel][0]:null,du=S.unit==='mm'?'mm':'cm',uf=du==='mm'?1000:100,st=S.padStep||0.01;
 let h='<div class="r"><button data-o="x" title="Lâcher l\'objet">✕</button><button data-o="del" class="d" title="Effacer">🗑</button><button data-o="w">◀</button><button data-o="n">▲</button><button data-o="s">▼</button><button data-o="e">▶</button><button data-o="rot" title="Tourner de 90°">⟳</button><button data-o="st" title="Pas des flèches et des + −">'+stLbl(st)+'</button><button data-o="more" title="Propriétés">⋯</button></div>';
 const ds=one?dimsOf(one):[];if(ds.length)h+='<div class="r">'+ds.map(([l,v],i)=>'<span class="l">'+l+'</span><button data-o="m'+i+'">−</button><input data-i="'+i+'" value="'+(Math.round(v*uf*10)/10)+'" inputmode="decimal"><button data-o="p'+i+'">+</button>').join('')+'<span class="l">'+du+'</span></div>';
 if(one&&one.t==='block'){const SZ=SIZES[one.name]||[];h+='<div class="r">'+(SZ.length?'<span class="l">Taille</span>'+SZ.map((z,i)=>'<button data-o="z'+i+'">'+Math.round(z[0]*100)+'×'+Math.round(z[1]*100)+'</button>').join(''):'')+'<button data-o="wall" title="Coller contre le mur le plus proche">⇲ Coller au mur</button></div>';}
 h+='<div class="r dist" id="odist"></div>';o.innerHTML=h;o.classList.add('on');
 o.querySelectorAll('input').forEach(x=>x.addEventListener('change',()=>{const v=num(x.value)/uf;if(v>0&&one)setDim(one,+x.dataset.i,v);}));
 if(!o._b){o._b=1;o.addEventListener('click',ev=>{const b=ev.target.closest('[data-o]');if(b)obarAct(b.dataset.o);});}}
function obarAct(a){const one=sel.size===1?[...sel][0]:null,st=S.padStep||0.01;
 if(a==='x'){sel.clear();padGrip=null;propOpen=false;refreshProp();updPrompt();draw();log('Objet lâché');}
 else if(a==='del')eraseSel();
 else if(a==='n')padMove(0,1);else if(a==='s')padMove(0,-1);else if(a==='e')padMove(1,0);else if(a==='w')padMove(-1,0);
 else if(a==='rot'){snapshot();const c=selCenter();sel.forEach(e=>{rotateE(e,c,Math.PI/2);mapPts(e,rnd);});after();}
 else if(a==='st'){const i=PADST.findIndex(v=>Math.abs(v-st)<1e-9);S.padStep=PADST[(i+1)%PADST.length];save();obarBuild();draw();log('Pas : '+stLbl(S.padStep));}
 else if(a==='more'){propOpen=true;refreshProp();}
 else if(a==='wall'&&one){snapshot();if(snapBlock(one,1.0)){after();log('Collé contre le mur');}else{undoS.pop();log('Aucun mur proche et parallèle (tourne le meuble avec ⟳ si besoin)');}}
 else if(/^z\d$/.test(a)&&one){const z=(SIZES[one.name]||[])[+a[1]];if(z){setSize(one,z[0],z[1]);log(entLabel(one)+' : '+Math.round(z[0]*100)+' × '+Math.round(z[1]*100)+' cm');}}
 else if(one&&/^[mp]\d$/.test(a)){const i=+a[1],d=dimsOf(one)[i];if(d)setDim(one,i,Math.max(st,d[1]+(a[0]==='p'?st:-st)));}}
function obarPos(){const o=$('#obar');if(!o||!o.classList.contains('on'))return null;const D=selDists();if(!D)return null;const b=D.b,p0=w2s([b[0],b[3]]),p1=w2s([b[2],b[1]]),bw=o.offsetWidth,bh=o.offsetHeight;
 let x=(p0[0]+p1[0])/2-bw/2,y=p0[1]-bh-14;if(y<4)y=p1[1]+14;if(y+bh>H-4)y=Math.max(4,H-bh-4);x=Math.max(4,Math.min(W-bw-(S.hideZoom?6:($('#viewbtns').offsetWidth+16)),x));o.style.left=x+'px';o.style.top=y+'px';
 const od=$('#odist');if(od){const d=D.d;const bad=[];sel.forEach(e=>{const m=CONF.get(e);if(m)bad.push(...m);});od.innerHTML=(d?esc('Espace libre : ◀ '+fdst(d[0])+'   ▶ '+fdst(d[1])+'   ▲ '+fdst(d[2])+'   ▼ '+fdst(d[3])+' '+S.unit):'')+(bad.length?'<br><span style="color:#ff6b6b;font-weight:700">⚠ Ne tient pas : '+esc(bad.join(' ; '))+'</span>':'');od.style.display=(d||bad.length)?'':'none';}return D;}const PADST=[0.001,0.005,0.01,0.05,0.1,0.5];
const stLbl=v=>v<0.01-1e-9?Math.round(v*1000)+' mm':v<1?Math.round(v*100)+' cm':v+' m';
function padTarget(){if(padP)return padP;if(down&&cursor&&!down.pan&&!NOCROSS.includes(tool))return cursor;if(tool==='select'){if(padGrip&&sel.has(padGrip.e))return padGrip.p;if(sel.size){let b=null;sel.forEach(e=>{const q=bbox(e);b=b?[Math.min(b[0],q[0]),Math.min(b[1],q[1]),Math.max(b[2],q[2]),Math.max(b[3],q[3])]:q;});return b?[(b[0]+b[2])/2,(b[1]+b[3])/2]:null;}return null;}return !NOCROSS.includes(tool)?(cursor||(pts.length?last():null)):null;}
function drawPad(){const d=$('#dpad');if(!d)return;const on=!!S.loupe&&(!NOCROSS.includes(tool)||(tool==='select'&&sel.size>0));d.classList.toggle('on',on);if(!on)return;
 const t=padTarget(),sc=t?w2s(t):null,onLeft=sc?sc[0]>W/2:false;d.style.left=onLeft?'8px':'auto';d.style.right=onLeft?'auto':(S.hideZoom?'8px':($('#viewbtns').offsetWidth+16)+'px');
 const D=Math.max(84,Math.min(130,Math.floor(H-50)));d.style.top=onLeft?'40px':'6px';if(d._D!==D){d._D=D;d.style.width=(D+68)+'px';d.style.height=D+'px';const st=(q,l,t,w2,h2)=>{const x=d.querySelector(q);x.style.left=l+'px';x.style.top=t+'px';x.style.width=w2+'px';x.style.height=h2+'px';};st('#dpc',0,0,D,D);st('.pd.n',D/2-18,1,36,30);st('.pd.s',D/2-18,D-31,36,30);st('.pd.o',1,D/2-17,32,34);st('.pd.e',D-33,D/2-17,32,34);st('.pd.x',D+6,0,62,28);st('.pd.st',D+6,32,62,28);st('.pd.ok',D+6,Math.max(64,D-42),62,Math.min(42,D-64));}
 d.querySelector('[data-d=ok]').style.visibility=padP?'visible':'hidden';$('#dpst').textContent='Pas '+stLbl(S.padStep||0.01);
 const u=U();$('#dpinfo').textContent=t?('X '+fmtL(t[0]-u[0])+' · Y '+fmtL(t[1]-u[1])+(padP&&pts.length?' · L '+uL(dist(last(),padP)):'')):(tool==='select'?'Touche un coin (carré bleu)':'Touche le plan');
 const pc=$('#dpc'),pw=Math.round(D*DPR);if(pc.width!==pw){pc.width=pw;pc.height=pw;}const g=pc.getContext('2d');g.setTransform(1,0,0,1,0,0);g.fillStyle=TH().bg;g.fillRect(0,0,pw,pw);if(!sc)return;
 const Z=4,src=D/2/Z;try{g.drawImage(cv,(sc[0]-src)*DPR,(sc[1]-src)*DPR,2*src*DPR,2*src*DPR,0,0,pw,pw);}catch(e){}
 g.strokeStyle='#ff8a1f';g.lineWidth=1.5*DPR;const m=pw/2;g.beginPath();g.moveTo(0,m);g.lineTo(m-6*DPR,m);g.moveTo(m+6*DPR,m);g.lineTo(pw,m);g.moveTo(m,0);g.lineTo(m,m-6*DPR);g.moveTo(m,m+6*DPR);g.lineTo(m,pw);g.stroke();}
function movePointAll(P0,P1,gp){const ns=new Set();if(gp){if(gp.i!=null)gp.e.p[gp.i]=P1;else gp.e[gp.k]=P1;ns.add(gp.e);}
 for(const e of ents){if(!visible(e)||e.t==='door'||e.t==='window'||e.t==='dim')continue;for(const k of ['a','b'])if(e[k]&&near(e[k],P0))e[k]=P1;if(e.t==='pline')e.p=e.p.map(q=>near(q,P0)?P1:q);}}
function padMove(dx,dy){const st=S.padStep||0.01,d=[dx*st,dy*st];
 if(tool==='select'&&sel.size){snapshot();if(padGrip&&sel.has(padGrip.e)){const P0=padGrip.p.slice(),P1=rnd([P0[0]+d[0],P0[1]+d[1]]);movePointAll(P0,P1,padGrip);padGrip.p=P1;updCoord(P1);log('Coin déplacé de '+stLbl(st)+' — les murs qui y sont attachés suivent');}else{sel.forEach(e=>{translate(e,d);mapPts(e,rnd);});}after();return;}
 if(NOCROSS.includes(tool))return;const b=padP||cursor||(pts.length?last():null);if(!b){log('Touche d\'abord le plan pour placer le point');return;}
 padP=rnd([b[0]+d[0],b[1]+d[1]]);cursor=padP;snapHit=null;updCoord(padP);updPrompt();draw();}
function padOk(){if(!padP){log('Touche d\'abord le plan pour placer le point');return;}const p=padP;padP=null;cursor=p;handlePoint(p);}
function updFlb(){const b=$('#flb');if(!b)return;const n=nFl(),on=n>1||(S.curFl|0)>0;b.classList.toggle('on',on);if(on)$('#flname').textContent=(S.curFl|0)?'Étage '+(S.curFl|0):'RDC';}
function setStep(i,auto){i=Math.max(0,Math.min(5,i|0));S.step=i;save();[...sel].forEach(e=>{if(locked(e))sel.delete(e);});padGrip=null;updStepUI();
 if(!auto&&tool!=='select'&&!NOCROSS.includes(tool)){const tp=toolPhase(tool);if(tp!=null&&tp!==i){tool='select';pts=[];document.querySelectorAll('.tb[data-id]').forEach(b=>b.classList.toggle('on',b.dataset.id==='select'));}}
 refreshProp();updPrompt();draw();log((auto?'Étape changée : ':'Étape ')+(i+1)+' · '+STEPS6[i][0]+' ('+STEPS6[i][1]+'). Le reste est verrouillé 🔒');}
function updStepUI(){const s2=curStep();document.querySelectorAll('#rib_batir .grp[data-ph]').forEach(g=>g.style.display=(+g.dataset.ph===s2)?'':'none');document.querySelectorAll('.tb[data-id]').forEach(b=>{if(/^st\d$/.test(b.dataset.id))b.classList.toggle('on',+b.dataset.id.slice(2)===s2);});const n=$('#stname');if(n)n.textContent=(s2+1)+' · '+STEPS6[s2][0];}
function goFloor(i){i=Math.max(0,i|0);S.curFl=i;setTimeout(()=>{if(typeof fill3Fl==='function'){fill3Fl();sched3();}},0);sel.clear();pts=[];padP=null;padGrip=null;save();refreshProp();updPrompt();draw();log('Tu dessines maintenant : '+flName(i)+(i?' (l\'étage du dessous est en pointillés)':''));}
let PREVD=null;function drawPreview(c,T){PREVD=null;if(!cursor||NOCROSS.includes(tool))return;const P=cursor,n=pts.length,col=T.pre,M={lw:1.3,bg:T.bg,cover:false,minTxt:10},tmp=[];
 if(OPK[tool]&&n&&dist(pts[0],P)>1e-9)tmp.push(mkOpen(tool,pts[0],P));
 if(tool.startsWith('el_')&&n&&ELK[tool.slice(3)]){const a=ELK[tool.slice(3)].two?pts[0]:last();if(dist(a,P)>1e-9)tmp.push(mkElem(tool.slice(3),a,P));}
 if(tool==='coupe'&&n){tmp.push({t:'line',a:pts[0],b:P});const L=dist(pts[0],P);if(L>1e-9){const m=mid(pts[0],P),nx=-(P[1]-pts[0][1])/L,ny=(P[0]-pts[0][0])/L,q=[m[0]+nx*Math.min(1,L*.3),m[1]+ny*Math.min(1,L*.3)];tmp.push({t:'line',a:m,b:q});}}
 switch(tool){
 case 'line':case 'measure':case 'imgmove':case 'calib':case 'scale':if(n)tmp.push({t:'line',a:last(),b:P});break;
 case 'pline':if(n)tmp.push({t:'pline',p:[...pts,P],closed:false});break;
 case 'area':if(n)tmp.push({t:'pline',p:[...pts,P],closed:n>1});break;
 case 'wall':if(n&&dist(last(),P)>1e-9)tmp.push({t:'wall',a:last(),b:P,th:S.wallT});break;
 case 'stair':if(n&&dist(last(),P)>1e-9)tmp.push({t:'stair',a:pts[0],b:P,w:S.stairW,n:Math.max(2,Math.round(dist(pts[0],P)/0.28))});break;
 case 'rect':if(n){const a=pts[0];tmp.push({t:'pline',p:[a,[P[0],a[1]],P,[a[0],P[1]]],closed:true});}break;
 case 'circle':if(n)tmp.push({t:'circle',c:pts[0],r:dist(pts[0],P)});break;
 case 'arc':if(n===1)tmp.push({t:'line',a:pts[0],b:P});if(n===2){const a=arc3(pts[0],pts[1],P);if(a)tmp.push(a);}break;
 case 'dim':if(n===1)tmp.push({t:'line',a:pts[0],b:P});if(n===2)tmp.push({t:'dim',a:pts[0],b:pts[1],o:P,h:S.dimTxt});break;
 case 'leader':if(n)tmp.push({t:'leader',a:pts[0],b:P,s:'…',h:S.txtH});break;
 case 'rdim':if(tdata)tmp.push({t:'rdim',c:tdata.c,r:tdata.r,p:P,h:S.dimTxt});break;
 case 'offset':if(tdata){const q=offsetEnt(tdata,S.offD,P);if(q)tmp.push(q);}break;
 case 'block':{const q={t:'block',name:S.blockName,p:P,rot:(S.blkRot||0)*Math.PI/180,sc:1,m:1};if(S.wallSnap!==false)snapBlock(q,0.3);tmp.push(q);const Q=footprint(q);if(Q){const bx=scrBox(Q);PREVD={b:bx,txt:fmtL(bx[2]-bx[0])+' × '+fmtL(bx[3]-bx[1])+' '+S.unit};}break;}
 case 'polygon':if(n){const r=dist(pts[0],P),a0=Math.atan2(P[1]-pts[0][1],P[0]-pts[0][0]),Q=[];for(let i=0;i<S.polySides;i++){const a=a0+i*2*Math.PI/S.polySides;Q.push([pts[0][0]+r*Math.cos(a),pts[0][1]+r*Math.sin(a)]);}tmp.push({t:'pline',p:Q,closed:true});}break;
 case 'ellipse':if(n===1)tmp.push({t:'line',a:pts[0],b:P});if(n===2)tmp.push({t:'ellipse',c:pts[0],rx:dist(pts[0],pts[1]),ry:Math.max(1e-6,segLineDist(P,pts[0],pts[1])),rot:Math.atan2(pts[1][1]-pts[0][1],pts[1][0]-pts[0][0])});break;
 case 'spline':if(n)tmp.push({t:'spline',p:[...pts,P]});break;
 case 'adim':if(n===1)tmp.push({t:'line',a:pts[0],b:P});if(n===2)tmp.push({t:'line',a:pts[0],b:pts[1]},{t:'line',a:pts[0],b:P});if(n===3)tmp.push({t:'adim',c:pts[0],p1:pts[1],p2:pts[2],o:P,h:S.dimTxt});break;
 case 'dimc':if(tdata){const a=tdata.b,L=dist(a,P);if(L>1e-9){const nx=-(P[1]-a[1])/L,ny=(P[0]-a[0])/L;tmp.push({t:'dim',a,b:P,o:[a[0]+nx*tdata.d,a[1]+ny*tdata.d],h:S.dimTxt});}}else{if(n===1)tmp.push({t:'line',a:pts[0],b:P});if(n===2)tmp.push({t:'dim',a:pts[0],b:pts[1],o:P,h:S.dimTxt});}break;
 case 'ddim':if(tdata)tmp.push({t:'rdim',dia:true,c:tdata.c,r:tdata.r,p:P,h:S.dimTxt});break;
 case 'rtable':{const rows=roomRows();if(rows.length)tmp.push(makeTable(P,rows));break;}
 case 'arrayP':if(sel.size){const nN=Math.max(2,S.arrN|0),A=S.arrA*Math.PI/180,st=Math.abs(S.arrA)>=359.9?A/nN:A/(nN-1);for(let i=1;i<nN;i++)sel.forEach(e=>{const q=cloneE(e);rotateE(q,P,st*i);tmp.push(q);});}break;
 case 'stretch':if(tdata&&n){const d=[P[0]-pts[0][0],P[1]-pts[0][1]];for(const e of sel){const q=cloneE(e);stretchE(q,tdata.box,d);tmp.push(q);}tmp.push({t:'line',a:pts[0],b:P});}break;
 case 'move':case 'copy':if(n){const d=[P[0]-pts[0][0],P[1]-pts[0][1]];for(const e of sel){const q=cloneE(e);translate(q,d);tmp.push(q);}tmp.push({t:'line',a:pts[0],b:P});}break;
 case 'rotate':if(n){const ang=Math.atan2(P[1]-pts[0][1],P[0]-pts[0][0]);for(const e of sel){const q=cloneE(e);rotateE(q,pts[0],ang);tmp.push(q);}tmp.push({t:'line',a:pts[0],b:P});}break;
 case 'mirror':if(n&&dist(pts[0],P)>1e-9){const th=Math.atan2(P[1]-pts[0][1],P[0]-pts[0][0]);for(const e of sel){const q=cloneE(e);mirrorE(q,pts[0],th);tmp.push(q);}tmp.push({t:'line',a:pts[0],b:P});}break;}
 c.save();c.lineWidth=1.3;c.lineCap='round';tmp.forEach(e=>drawEnt(c,e,w2s,view.s,col,M));
 if(PREVD){const D2=distsFor(PREVD.b,null);drawDistLines(c,D2);const s2=w2s([PREVD.b[2],PREVD.b[3]]);c.font='bold 12px '+FONT();const tw=c.measureText(PREVD.txt).width;c.fillStyle='rgba(0,0,0,.8)';c.fillRect(s2[0]+6,s2[1]-22,tw+10,18);c.fillStyle='#ffd43b';c.textAlign='left';c.fillText(PREVD.txt,s2[0]+11,s2[1]-9);PREVD=null;}
 pts.forEach(p=>{const s=w2s(p);c.fillStyle=col;c.fillRect(s[0]-2.5,s[1]-2.5,5,5);});
 if(n&&(['line','pline','wall','stair','measure','move','copy','rect','circle','area','mirror','imgmove','calib','spline','polygon','coupe'].includes(tool)||OPK[tool]||tool.startsWith('el_'))){const a=last();let txt;
  if(tool==='rect')txt=fmtL(Math.abs(P[0]-pts[0][0]))+' × '+fmtL(Math.abs(P[1]-pts[0][1]))+' '+S.unit;
  else if(tool==='circle')txt='R = '+uL(dist(pts[0],P));
  else{const A=deg(Math.atan2(P[1]-a[1],P[0]-a[0]));txt=uL(dist(a,P))+'   ∠'+Math.round((A+360)%360)+'°';}
  const s=w2s(P);c.font='12px '+FONT();const tw=c.measureText(txt).width;let x=s[0]+16,y=s[1]+14;if(x+tw+12>W)x=s[0]-tw-26;if(y+20>H)y=s[1]-34;
  c.fillStyle=T.lbl;c.fillRect(x,y,tw+10,19);c.fillStyle=T.lblT;c.fillText(txt,x+5,y+14);}
 c.restore();}
function drawCursor(c,T){if(!cursor||NOCROSS.includes(tool))return;const s=w2s(cursor);c.save();c.strokeStyle=T.ch;c.lineWidth=1;c.beginPath();const R=(S.cross==='petit'||S.loupe)?28:1e5;c.moveTo(Math.max(0,s[0]-R),Math.round(s[1])+.5);c.lineTo(Math.min(W,s[0]+R),Math.round(s[1])+.5);c.moveTo(Math.round(s[0])+.5,Math.max(0,s[1]-R));c.lineTo(Math.round(s[0])+.5,Math.min(H,s[1]+R));c.stroke();
 c.strokeStyle=T.cur;c.strokeRect(s[0]-4.5,s[1]-4.5,9,9);
 if(snapHit){const r=8;c.strokeStyle='#2fb866';c.lineWidth=2;c.beginPath();const ty=snapHit.ty;
  if(ty==='fin'||ty==='insertion')c.rect(s[0]-r,s[1]-r,2*r,2*r);else if(ty==='milieu'){c.moveTo(s[0],s[1]-r);c.lineTo(s[0]+r,s[1]+r);c.lineTo(s[0]-r,s[1]+r);c.closePath();}
  else if(ty==='centre')c.arc(s[0],s[1],r,0,Math.PI*2);else if(ty==='quadrant'){c.moveTo(s[0],s[1]-r);c.lineTo(s[0]+r,s[1]);c.lineTo(s[0],s[1]+r);c.lineTo(s[0]-r,s[1]);c.closePath();}
  else if(ty==='intersection'){c.moveTo(s[0]-r,s[1]-r);c.lineTo(s[0]+r,s[1]+r);c.moveTo(s[0]+r,s[1]-r);c.lineTo(s[0]-r,s[1]+r);}
  else if(ty==='perpendiculaire'){c.moveTo(s[0]-r,s[1]-r);c.lineTo(s[0]-r,s[1]+r);c.lineTo(s[0]+r,s[1]+r);c.moveTo(s[0]-r,s[1]);c.lineTo(s[0],s[1]);c.lineTo(s[0],s[1]+r);}
  else if(ty==='tangente'){c.arc(s[0],s[1],r*0.7,0,Math.PI*2);c.moveTo(s[0]-r,s[1]-r);c.lineTo(s[0]+r,s[1]-r);}
  else{c.moveTo(s[0]-r,s[1]-r);c.lineTo(s[0]+r,s[1]+r);c.lineTo(s[0]-r,s[1]+r);c.lineTo(s[0]+r,s[1]-r);c.closePath();}
  c.stroke();c.font='11px '+FONT();c.fillStyle='#2fb866';c.fillText(ty,s[0]+12,s[1]-11);}
 c.restore();}

/* ---------- accrochage ---------- */
function snapCands(){const out=[],P=(p,ty)=>out.push({p,ty});
 for(const e of ents){if(!visible(e))continue;switch(e.t){
  case 'line':case 'door':case 'window':case 'stair':case 'leader':P(e.a,'fin');P(e.b,'fin');P(mid(e.a,e.b),'milieu');break;
  case 'wall':P(e.a,'fin');P(e.b,'fin');P(mid(e.a,e.b),'milieu');wallPoly(e).forEach(q=>P(q,'fin'));break;
  case 'pline':if(e.holes)e.holes.forEach(H=>H.forEach(q=>P(q,'fin')));e.p.forEach((p,i)=>{P(p,'fin');if(i<e.p.length-1||e.closed)P(mid(p,e.p[(i+1)%e.p.length]),'milieu');});break;
  case 'circle':P(e.c,'centre');for(let i=0;i<4;i++)P([e.c[0]+e.r*Math.cos(i*Math.PI/2),e.c[1]+e.r*Math.sin(i*Math.PI/2)],'quadrant');break;
  case 'arc':P(e.c,'centre');P(arcEnd(e,0),'fin');P(arcEnd(e,1),'fin');break;
  case 'dim':P(e.a,'fin');P(e.b,'fin');break;
  case 'text':case 'block':P(e.p,'insertion');break;
  case 'ellipse':P(e.c,'centre');curvePts(e).filter((_,i)=>i%18===0).forEach(q=>P(q,'quadrant'));break;
  case 'spline':e.p.forEach(q=>P(q,'fin'));break;
  case 'elem':{P(e.a,'fin');P(e.b,'fin');P(mid(e.a,e.b),'milieu');const Q=elemPoly(e);if(Q&&e.w)Q.forEach(q=>P(q,'fin'));break;}
  case 'adim':P(e.c,'centre');break;}}
 pts.forEach(p=>P(p,'fin'));const om=S.osm||{};return out.filter(c=>om[c.ty]!==false);}
function nearSegs(p,tol){const out=[];for(const e of ents){if(!visible(e))continue;let ss=segsOf(e);if(e.t==='wall'){const P=wallPoly(e);ss=ss.concat([0,1,2,3].map(i=>[P[i],P[(i+1)%4]]));}if(e.t==='block'&&!String(e.name).startsWith('u:'))ss=ss.concat(blockPrims(e).l);for(const sg of ss)if(segDist(p,sg[0],sg[1])[0]<tol*3)out.push(sg);}return out.slice(0,300);}
function extraSnaps(p,tol){const om=S.osm||{},out=[],ss=nearSegs(p,tol);
 if(om.intersection!==false)for(let i=0;i<ss.length;i++)for(let j=i+1;j<ss.length;j++){const [a,b]=ss[i],[c,d]=ss[j],r=[b[0]-a[0],b[1]-a[1]],q=[d[0]-c[0],d[1]-c[1]],den=r[0]*q[1]-r[1]*q[0];if(Math.abs(den)<1e-12)continue;const t=((c[0]-a[0])*q[1]-(c[1]-a[1])*q[0])/den,u=((c[0]-a[0])*r[1]-(c[1]-a[1])*r[0])/den;if(t<-1e-9||t>1+1e-9||u<-1e-9||u>1+1e-9)continue;const X=[a[0]+t*r[0],a[1]+t*r[1]];if(dist(X,p)<tol)out.push({p:X,ty:'intersection'});}
 if(pts.length){const L=last();
  if(om.perpendiculaire!==false)for(const [a,b] of ss){const t=projT(L,a,b);if(t<0||t>1)continue;const F=[a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t];if(dist(F,L)>1e-6&&dist(F,p)<tol)out.push({p:F,ty:'perpendiculaire'});}
  if(om.tangente!==false)for(const e of ents){if(!visible(e)||(e.t!=='circle'&&e.t!=='arc'))continue;const d=dist(L,e.c);if(d<=e.r+1e-9)continue;const ba=Math.atan2(L[1]-e.c[1],L[0]-e.c[0]),al=Math.acos(e.r/d);[ba+al,ba-al].forEach(a=>{const T=[e.c[0]+e.r*Math.cos(a),e.c[1]+e.r*Math.sin(a)];if(dist(T,p)<tol)out.push({p:T,ty:'tangente'});});}}
 return out;}
const NOSNAP=['hatch','offset','rdim','ddim','trim','extend','fillet','chamfer'];
function pick(X,Y){let p=s2w(X,Y);snapHit=null;const tol=(S.snapTol||16)/view.s;
 if(S.osnap&&!NOSNAP.includes(tool)){let bd=tol;for(const c of snapCands().concat(extraSnaps(p,tol))){const d=dist(c.p,p);if(d<bd){bd=d;snapHit=c;}}
  if(!snapHit&&(S.osm||{}).proche!==false){let bd2=tol*0.6,bp=null;for(const e of ents){if(!visible(e))continue;for(const [a,b] of segsOf(e)){const [d,q]=segDist(p,a,b);if(d<bd2){bd2=d;bp=q;}}}if(bp)snapHit={p:bp,ty:'proche'};}}
 if(snapHit)return rnd(snapHit.p);
 if(S.snap&&!NOSNAP.includes(tool)){const st=S.snapStep||gridStep();p=[Math.round(p[0]/st)*st,Math.round(p[1]/st)*st];}
 const orthoOk=!['circle','arc','text','block','hatch','offset','rdim','ddim','ellipse','polygon','adim','trim','extend','fillet','chamfer','rtable','idpt','arrayP'].includes(tool)&&!(tool==='dim'&&pts.length!==1);
 if(S.ortho&&pts.length&&orthoOk){const l=last();p=Math.abs(p[0]-l[0])>=Math.abs(p[1]-l[1])?[p[0],l[1]]:[l[0],p[1]];}
 return rnd(p);}

/* ---------- sélection ---------- */
function entDist(e,p){switch(e.t){
 case 'line':case 'leader':{let d=segDist(p,e.a,e.b)[0];if(e.t==='leader'){const b=bbox(e);if(p[0]>=b[0]&&p[0]<=b[2]&&p[1]>=b[1]&&p[1]<=b[3])d=Math.min(d,dist(p,e.b)*0.5);}return d;}
 case 'pline':{let d=Math.min(...segsOf(e).map(s=>segDist(p,s[0],s[1])[0]));if(e.mat){d+=6/view.s;if(pointInPoly(p,e.p)&&!(e.holes||[]).some(H=>pointInPoly(p,H)))d=Math.min(d,9/view.s);return d;}if(e.hatch&&e.closed&&pointInPoly(p,e.p))d=Math.min(d,4/view.s);return d;}
 case 'elem':{const Q=elemPoly(e);if(!Q||!e.w)return segDist(p,e.a,e.b)[0];if(pointInPoly(p,Q))return 1/view.s;return Math.min(...[0,1,2,3].map(i=>segDist(p,Q[i],Q[(i+1)%4])[0]));}
 case 'wall':return Math.max(0,segDist(p,e.a,e.b)[0]-e.th/2)+0.3*(14/view.s);
 case 'door':case 'window':{let d=Math.max(0,segDist(p,e.a,e.b)[0]-e.th/2);if(e.t==='door'){const L=dist(e.a,e.b);d=Math.min(d,Math.abs(dist(e.a,p)-L));}return d;}
 case 'circle':return Math.abs(dist(e.c,p)-e.r);
 case 'arc':{const a=norm(Math.atan2(p[1]-e.c[1],p[0]-e.c[0])-e.a0),sw=norm(e.a1-e.a0);if(a<=sw)return Math.abs(dist(e.c,p)-e.r);return Math.min(dist(p,arcEnd(e,0)),dist(p,arcEnd(e,1)));}
 case 'dim':{const g=dimGeom(e);return g?Math.min(segDist(p,g.A,g.B)[0],dist(p,g.T)):1e9;}
 case 'stair':{const g=stairGeom(e);if(!g)return 1e9;return pointInPoly(p,g.C)?2/view.s:Math.min(...[0,1,2,3].map(i=>segDist(p,g.C[i],g.C[(i+1)%4])[0]));}
 case 'block':{if(String(e.name).startsWith('u:')){let d=1e9;userBlockEnts(e).forEach(q=>{d=Math.min(d,entDist(q,p));});return d;}const g=blockPrims(e);let d=1e9;g.l.forEach(s=>{d=Math.min(d,segDist(p,s[0],s[1])[0]);});g.c.forEach(([c,r])=>{d=Math.min(d,Math.abs(dist(c,p)-r));});const b=bbox(e);if(p[0]>=b[0]&&p[0]<=b[2]&&p[1]>=b[1]&&p[1]<=b[3])d=Math.min(d,6/view.s);return d;}
 case 'rdim':return segDist(p,e.c,e.p)[0];
 case 'ellipse':case 'spline':return Math.min(...segsOf(e).map(s=>segDist(p,s[0],s[1])[0]));
 case 'adim':{const g=adimGeom(e),a=norm(Math.atan2(p[1]-e.c[1],p[0]-e.c[0])-g.s);return Math.min(a<=g.sw?Math.abs(dist(e.c,p)-g.r):1e9,dist(p,g.T));}
 case 'table':{const b=bbox(e);return(p[0]>=b[0]&&p[0]<=b[2]&&p[1]>=b[1]&&p[1]<=b[3])?0:1e9;}
 case 'text':{const b=bbox(e);return(p[0]>=b[0]&&p[0]<=b[2]&&p[1]>=b[1]&&p[1]<=b[3])?0:1e9;}}return 1e9;}
function hitTest(p,tol,types){let best=null,bd=tol;for(const e of ents){if(!visible(e)||(types&&!types.includes(e.t))||locked(e))continue;const d=entDist(e,p);if(d<bd){bd=d;best=e;}}return best;}
function hitSelect(X,Y){setTimeout(()=>{if(typeof selSig3==='function'&&SPLIT)selSig3();},0);const p=s2w(X,Y),e=hitTest(p,14/view.s);if(e){sel.has(e)?sel.delete(e):sel.add(e);}else{sel.clear();ALLOWLOCK=true;const l=hitTest(p,14/view.s);ALLOWLOCK=false;if(l){const ph=phaseOf(l);log('🔒 '+entLabel(l)+' est verrouillé : il appartient à l\'étape '+(ph+1)+' · '+STEPS6[ph][0]+'. Touche ◀ ▶ en haut à gauche pour y revenir.');}}}
function selectBox(b){const [ax,ay]=s2w(b.x0,b.y0),[bx,by]=s2w(b.x1,b.y1);const x0=Math.min(ax,bx),x1=Math.max(ax,bx),y0=Math.min(ay,by),y1=Math.max(ay,by),crossing=b.x1<b.x0;
 for(const e of ents){if(!visible(e)||locked(e))continue;const q=bbox(e);const inside=q[0]>=x0&&q[2]<=x1&&q[1]>=y0&&q[3]<=y1;const inter=!(q[2]<x0||q[0]>x1||q[3]<y0||q[1]>y1);if(inside||(crossing&&inter))sel.add(e);}}
function closedAt(p){let best=null,ba=Infinity;for(const e of ents){if(!visible(e))continue;let A=null;if(e.t==='pline'&&e.closed&&e.p.length>2&&pointInPoly(p,e.p))A=area(e);else if(e.t==='circle'&&dist(e.c,p)<e.r)A=Math.PI*e.r*e.r;if(A!=null&&A<ba){ba=A;best=e;}}return best;}
function eraseSel(){if(!sel.size){log('Rien de sélectionné. Choisis Sélection et touche les objets à effacer.');return;}const n=sel.size;snapshot();ents=ents.filter(e=>!sel.has(e));sel.clear();after();log(n+' objet(s) effacé(s)');}
function selCenter(){let b=null;sel.forEach(e=>{const q=bbox(e);b=b?[Math.min(b[0],q[0]),Math.min(b[1],q[1]),Math.max(b[2],q[2]),Math.max(b[3],q[3])]:q;});return b?[(b[0]+b[2])/2,(b[1]+b[3])/2]:[0,0];}

/* ---------- opérations ---------- */
function offsetEnt(e,d,P){const q=cloneE(e);
 if(e.t==='line'||e.t==='wall'){const L=dist(e.a,e.b);if(L<1e-9)return null;const nx=-(e.b[1]-e.a[1])/L,ny=(e.b[0]-e.a[0])/L,s=((P[0]-e.a[0])*nx+(P[1]-e.a[1])*ny)>=0?1:-1;translate(q,[nx*d*s,ny*d*s]);mapPts(q,rnd);return q;}
 if(e.t==='circle'||e.t==='arc'){q.r=e.r+(dist(e.c,P)>e.r?1:-1)*d;return q.r>1e-6?q:null;}
 if(e.t==='pline'){const S2=segsOf(e);if(!S2.length)return null;let best=1e18,side=1;
  S2.forEach(([a,b])=>{const [dd]=segDist(P,a,b);if(dd<best){best=dd;const L=dist(a,b)||1,nx=-(b[1]-a[1])/L,ny=(b[0]-a[0])/L;side=((P[0]-a[0])*nx+(P[1]-a[1])*ny)>=0?1:-1;}});
  const lines=S2.map(([a,b])=>{const L=dist(a,b)||1,nx=-(b[1]-a[1])/L*d*side,ny=(b[0]-a[0])/L*d*side;return [[a[0]+nx,a[1]+ny],[b[0]+nx,b[1]+ny]];});
  const n=e.p.length,m=lines.length,cl=e.closed&&n>2,out=[];
  for(let i=0;i<n;i++){const prev=cl?lines[(i-1+m)%m]:(i>0?lines[i-1]:null),next=i<m?lines[i]:null;
   if(prev&&next)out.push(lineInt(prev,next)||next[0]);else if(next)out.push(next[0]);else out.push(prev[1]);}
  q.p=out.map(rnd);return q;}
 return null;}
function rotateSel(c,ang){snapshot();sel.forEach(e=>rotateE(e,c,ang));pts=[];after();setTool('select');}
function scaleSel(c,f){if(!(f>0)){log('Facteur non valable');return;}snapshot();sel.forEach(e=>scaleE(e,c,f));pts=[];after();setTool('select');log('Échelle × '+f+' appliquée');}
function mirrorSel(a,b){if(dist(a,b)<1e-9){pts=[];return;}const th=Math.atan2(b[1]-a[1],b[0]-a[0]);snapshot();const nw=[];sel.forEach(e=>{const q=cloneE(e);mirrorE(q,a,th);mapPts(q,rnd);nw.push(q);});ents.push(...nw);sel=new Set(nw);pts=[];after();setTool('select');log('Miroir fait : la copie est sélectionnée (l\'original est gardé)');}
function placeAreaLabel(c,A,P){const s='S = '+fmt(A)+' m²';add({t:'text',p:rnd([c[0]-s.length*S.txtH*0.3,c[1]-S.txtH/2]),s,h:S.txtH,rot:0});log('Surface : '+fmt(A)+' m²   —   périmètre : '+uL(P));}
const LINS=['line','wall','door','window','dim','stair'];
const linSel=()=>[...sel].filter(e=>LINS.includes(e.t));
function setLen(e,L){const d=dist(e.a,e.b);if(d<1e-9)return;e.b=rnd([e.a[0]+(e.b[0]-e.a[0])/d*L,e.a[1]+(e.b[1]-e.a[1])/d*L]);}

function cutSegs(ex){const out=[];for(const e of ents){if(e===ex||!visible(e))continue;
 if(e.t==='wall'){out.push([e.a,e.b]);if(ex.t!=='wall'){const P=wallPoly(e,true);for(let i=0;i<4;i++)out.push([P[i],P[(i+1)%4]]);}}
 else if(e.t!=='circle'&&e.t!=='arc')segsOf(e).forEach(sg=>out.push(sg));}return out;}
function lineHits(a,b,ex){const ts=[],dx=b[0]-a[0],dy=b[1]-a[1];
 for(const [c,d] of cutSegs(ex)){const sx=d[0]-c[0],sy=d[1]-c[1],den=dx*sy-dy*sx;if(Math.abs(den)<1e-12)continue;const t=((c[0]-a[0])*sy-(c[1]-a[1])*sx)/den,u=((c[0]-a[0])*dy-(c[1]-a[1])*dx)/den;if(u>=-1e-9&&u<=1+1e-9)ts.push(t);}
 for(const e of ents){if(e===ex||!visible(e)||(e.t!=='circle'&&e.t!=='arc'))continue;const fx=a[0]-e.c[0],fy=a[1]-e.c[1],A=dx*dx+dy*dy,B=2*(fx*dx+fy*dy),C=fx*fx+fy*fy-e.r*e.r,disc=B*B-4*A*C;if(disc<0||A<1e-12)continue;const sq=Math.sqrt(disc);
  for(const t of [(-B-sq)/(2*A),(-B+sq)/(2*A)]){if(e.t==='arc'){const Q=[a[0]+t*dx,a[1]+t*dy],an=norm(Math.atan2(Q[1]-e.c[1],Q[0]-e.c[0])-e.a0);if(an>norm(e.a1-e.a0)+1e-9)continue;}ts.push(t);}}
 return ts;}
function trimE(e,p){const tp=projT(p,e.a,e.b),ts=lineHits(e.a,e.b,e).filter(t=>t>1e-6&&t<1-1e-6);let lo=-Infinity,hi=Infinity;ts.forEach(t=>{if(t<tp&&t>lo)lo=t;if(t>tp&&t<hi)hi=t;});
 if(lo===-Infinity&&hi===Infinity)return 'Rien ne coupe cet objet : pas de bord pour ajuster';
 snapshot();const A=e.a,B=e.b;
 if(lo>-Infinity&&hi<Infinity){e.b=lerp(A,B,lo);const q=cloneE(e);q.a=lerp(A,B,hi);q.b=B;ents.push(q);}
 else if(lo>-Infinity)e.b=lerp(A,B,lo);else e.a=lerp(A,B,hi);
 after();return 'Ajusté';}
function extendE(e,p){const tp=projT(p,e.a,e.b),ts=lineHits(e.a,e.b,e);let best=null;const A=e.a,B=e.b;
 if(tp>=0.5){ts.forEach(t=>{if(t>1+1e-6&&(best===null||t<best))best=t;});if(best===null)return 'Aucun objet à atteindre dans ce sens';snapshot();e.b=lerp(A,B,best);}
 else{ts.forEach(t=>{if(t<-1e-6&&(best===null||t>best))best=t;});if(best===null)return 'Aucun objet à atteindre dans ce sens';snapshot();e.a=lerp(A,B,best);}
 after();return 'Prolongé';}
function cornerE(e1,p1,e2,p2,mode){const I=lineInt([e1.a,e1.b],[e2.a,e2.b]);if(!I)return 'Les deux lignes sont parallèles';
 const prep=(e,p)=>{const ua=[e.a[0]-I[0],e.a[1]-I[1]],ub=[e.b[0]-I[0],e.b[1]-I[1]],up=[p[0]-I[0],p[1]-I[1]],la=Math.hypot(ua[0],ua[1]),lb=Math.hypot(ub[0],ub[1]),da=ua[0]*up[0]+ua[1]*up[1],db=ub[0]*up[0]+ub[1]*up[1];
  let far;if(da>0&&db>0)far=la>=lb?'a':'b';else if(da>0)far='a';else if(db>0)far='b';else far=la>=lb?'a':'b';
  const F=e[far],L=dist(F,I);return {near:far==='a'?'b':'a',L,v:L>1e-12?[(F[0]-I[0])/L,(F[1]-I[1])/L]:[0,0]};};
 const s1=prep(e1,p1),s2=prep(e2,p2);if(s1.L<1e-9||s2.L<1e-9)return 'Coin impossible ici';
 const isW=e1.t==='wall'||e2.t==='wall';if(isW&&mode==='chamfer')return 'Le chanfrein ne marche pas sur les murs';
 const R=(mode==='fillet'&&!isW)?S.filletR:0;
 if(mode==='chamfer'){const D=S.chamD;if(D>=s1.L||D>=s2.L)return 'Distance trop grande pour ces lignes';snapshot();const T1=rnd([I[0]+s1.v[0]*D,I[1]+s1.v[1]*D]),T2=rnd([I[0]+s2.v[0]*D,I[1]+s2.v[1]*D]);e1[s1.near]=T1;e2[s2.near]=T2;ents.push({t:'line',a:T1,b:T2,layer:e1.layer});after();return 'Chanfrein fait';}
 if(R<=1e-9){snapshot();e1[s1.near]=rnd(I);e2[s2.near]=rnd(I);after();return isW&&mode==='fillet'&&S.filletR>0?'Coin des murs raccordé (les murs restent à angle droit)':'Coin raccordé';}
 const cosT=s1.v[0]*s2.v[0]+s1.v[1]*s2.v[1],th=Math.acos(Math.max(-1,Math.min(1,cosT)));if(th<1e-3||th>Math.PI-1e-3)return 'Angle impossible pour un raccord';
 const d=R/Math.tan(th/2);if(d>=s1.L||d>=s2.L)return 'Rayon trop grand pour ces lignes';
 snapshot();const T1=[I[0]+s1.v[0]*d,I[1]+s1.v[1]*d],T2=[I[0]+s2.v[0]*d,I[1]+s2.v[1]*d],bx=s1.v[0]+s2.v[0],by=s1.v[1]+s2.v[1],bl=Math.hypot(bx,by),hc=R/Math.sin(th/2),C=[I[0]+bx/bl*hc,I[1]+by/bl*hc];
 e1[s1.near]=rnd(T1);e2[s2.near]=rnd(T2);let a1=Math.atan2(T1[1]-C[1],T1[0]-C[0]),a2=Math.atan2(T2[1]-C[1],T2[0]-C[0]);if(norm(a2-a1)>Math.PI){const t=a1;a1=a2;a2=t;}
 ents.push({t:'arc',c:rnd(C),r:R,a0:a1,a1:a2,layer:e1.layer});after();return 'Raccord fait';}
function polyAt(c,r,a0){const n=Math.max(3,S.polySides|0),Q=[];for(let i=0;i<n;i++){const a=a0+i*2*Math.PI/n;Q.push(rnd([c[0]+r*Math.cos(a),c[1]+r*Math.sin(a)]));}add({t:'pline',p:Q,closed:true});}
function roomRows(){const rooms=ents.filter(e=>e.t==='pline'&&e.closed&&visible(e)),texts=ents.filter(e=>e.t==='text'&&!/^S = /.test(e.s));
 return rooms.map((r,i)=>{const nm=texts.find(t=>pointInPoly(t.p,r.p));return [String(i+1),nm?nm.s:'Pièce '+(i+1),fmt(area(r)),fmt(perim(r))];});}
function makeTable(p,rows){const tot=rows.reduce((a,r)=>a+(+r[2]||0),0);return {t:'table',p,h:S.txtH,title:'TABLEAU DES PIÈCES',head:['N°','Pièce','Surface (m²)','Périmètre (m)'],rows:rows.concat([['','TOTAL',fmt(tot),'']])};}
function coordHTML(e,inp){const f=v=>fmtL(v),fx=v=>fmtL(v-U()[0]),fy=v=>fmtL(v-U()[1]),inp2=(l,i1,v1,i2,v2)=>'<div class="fr"><label>'+l+'</label><input id="'+i1+'" value="'+v1+'" inputmode="decimal"><input id="'+i2+'" value="'+v2+'" inputmode="decimal"></div>';let h='';
 if(e.a&&e.b){h+=inp2('Début X / Y','pAx',fx(e.a[0]),'pAy',fy(e.a[1]))+inp2('Fin X / Y','pBx',fx(e.b[0]),'pBy',fy(e.b[1]));
  if(LINS.includes(e.t)||e.t==='leader'){const A=(deg(Math.atan2(e.b[1]-e.a[1],e.b[0]-e.a[0]))+360)%360;h+=inp((e.t==='door'||e.t==='window'?'Largeur':'Longueur')+' ('+S.unit+')','pL',f(dist(e.a,e.b)))+inp('Angle (°)','pAng',A.toFixed(Math.max(1,S.dec)));}}
 if(e.c)h+=inp2('Centre X / Y','pCx',fx(e.c[0]),'pCy',fy(e.c[1]));
 if(e.p&&!Array.isArray(e.p[0]))h+=inp2('Position X / Y','pPx',fx(e.p[0]),'pPy',fy(e.p[1]));
 return h;}

function stretchE(e,bx,d){const inB=q=>q[0]>=bx[0]-1e-9&&q[0]<=bx[2]+1e-9&&q[1]>=bx[1]-1e-9&&q[1]<=bx[3]+1e-9,mv=q=>inB(q)?[q[0]+d[0],q[1]+d[1]]:q,b=bbox(e);
 if(b[0]>=bx[0]&&b[2]<=bx[2]&&b[1]>=bx[1]&&b[3]<=bx[3]){translate(e,d);mapPts(e,rnd);return;}
 for(const k of ['a','b','p1','p2'])if(e[k])e[k]=mv(e[k]);if(e.c&&e.t!=='rdim')e.c=mv(e.c);if(e.p){if(Array.isArray(e.p[0]))e.p=e.p.map(mv);else e.p=mv(e.p);}mapPts(e,rnd);}
function breakE(e,p1,p2){let t1=Math.max(0,Math.min(1,projT(p1,e.a,e.b))),t2=Math.max(0,Math.min(1,projT(p2,e.a,e.b)));if(t1>t2){const t=t1;t1=t2;t2=t;}const A=e.a,B=e.b;
 if(Math.abs(t2-t1)*dist(A,B)<1e-6){if(t1<=1e-6||t1>=1-1e-6)return 'Impossible de couper au bout';snapshot();e.b=lerp(A,B,t1);const q=cloneE(e);delete q.id;q.a=lerp(A,B,t1);q.b=B;ents.push(q);after();return 'Coupé en deux morceaux';}
 snapshot();const parts=[];if(t1>1e-6)parts.push([A,lerp(A,B,t1)]);if(t2<1-1e-6)parts.push([lerp(A,B,t2),B]);
 if(!parts.length)ents=ents.filter(x=>x!==e);else{e.a=parts[0][0];e.b=parts[0][1];if(parts[1]){const q=cloneE(e);delete q.id;q.a=parts[1][0];q.b=parts[1][1];ents.push(q);}}after();return 'Morceau enlevé';}
function joinSel(){const ls=[...sel].filter(e=>e.t==='line'||(e.t==='pline'&&!e.closed));if(ls.length<2){log('Sélectionne au moins deux lignes ou polylignes ouvertes qui se touchent');return;}
 if(ls.every(e=>e.t==='line')){const r=ls[0];if(dist(r.a,r.b)>1e-9&&ls.every(e=>segLineDist(e.a,r.a,r.b)<1e-6&&segLineDist(e.b,r.a,r.b)<1e-6)){let tmin=Infinity,tmax=-Infinity;ls.forEach(e=>[e.a,e.b].forEach(q=>{const t=projT(q,r.a,r.b);tmin=Math.min(tmin,t);tmax=Math.max(tmax,t);}));snapshot();const A=r.a,B=r.b;r.a=lerp(A,B,tmin);r.b=lerp(A,B,tmax);const rest=new Set(ls.slice(1));ents=ents.filter(e=>!rest.has(e));sel=new Set([r]);after();log('Lignes jointes en une seule');return;}}
 const ch=ls.map(e=>e.t==='line'?[e.a,e.b]:e.p.slice());let chain=ch.shift(),changed=true;
 while(changed&&ch.length){changed=false;for(let i=0;i<ch.length;i++){const c=ch[i],h=chain[0],t=chain[chain.length-1];
  if(near(t,c[0]))chain=chain.concat(c.slice(1));else if(near(t,c[c.length-1]))chain=chain.concat(c.slice().reverse().slice(1));else if(near(h,c[c.length-1]))chain=c.slice(0,-1).concat(chain);else if(near(h,c[0]))chain=c.slice().reverse().slice(0,-1).concat(chain);else continue;ch.splice(i,1);changed=true;break;}}
 if(ch.length){log('Ces objets ne se touchent pas tous bout à bout');return;}
 snapshot();const closed=chain.length>3&&near(chain[0],chain[chain.length-1]);if(closed)chain.pop();const np={t:'pline',p:chain,closed,layer:ls[0].layer};const rm=new Set(ls);ents=ents.filter(e=>!rm.has(e));ents.push(np);sel=new Set([np]);after();log('Joint en une polyligne'+(closed?' fermée':''));}
function explodeE(e){const L=(a,b)=>({t:'line',a:rnd(a),b:rnd(b),layer:e.layer}),T=(p,s2,h,rot)=>({t:'text',p:rnd(p),s:s2,h,rot:rot||0,layer:e.layer});
 switch(e.t){
 case 'pline':case 'ellipse':case 'spline':return segsOf(e).map(sg=>L(sg[0],sg[1]));
 case 'wall':{const P=wallPoly(e,true);return [0,1,2,3].map(i=>L(P[i],P[(i+1)%4]));}
 case 'door':case 'window':{const g=openPrims(e);if(!g)return null;const o=g.l.map(sg=>L(sg[0],sg[1]));if(g.arc)o.push({t:'arc',c:g.arc[0].slice(),r:g.arc[1],a0:g.arc[2],a1:g.arc[3],layer:e.layer});if(g.arc2)o.push({t:'arc',c:g.arc2[0].slice(),r:g.arc2[1],a0:g.arc2[2],a1:g.arc2[3],layer:e.layer});return o;}
 case 'stair':{const g=stairGeom(e);if(!g)return null;return [0,1,2,3].map(i=>L(g.C[i],g.C[(i+1)%4])).concat(g.steps.map(sg=>L(sg[0],sg[1])),g.arrow.map(sg=>L(sg[0],sg[1])));}
 case 'elem':{const Q=elemPoly(e);if(!Q)return null;if(!e.w)return [L(e.a,e.b)];return [0,1,2,3].map(i=>L(Q[i],Q[(i+1)%4]));}
 case 'block':{if(String(e.name).startsWith('u:'))return userBlockEnts(e).map(q=>{delete q.id;return q;});const g=blockPrims(e);return g.l.map(sg=>L(sg[0],sg[1])).concat(g.c.map(([c,r])=>({t:'circle',c:rnd(c),r,layer:e.layer})));}
 case 'dim':{const g=dimGeom(e);if(!g)return null;return [L(e.a,g.A),L(e.b,g.B),L(g.A,g.B),T([g.T[0],g.T[1]-g.h/2],fmtL(g.L),g.h,0)];}
 case 'leader':{const g=leaderGeom(e);return [L(e.a,e.b),L(e.b,g.land),T(g.tp,e.s,g.h,0)];}
 case 'rdim':{const g=rdimGeom(e);return [L(g.q2||e.c,e.p),T(e.p,g.txt,g.h,0)];}
 case 'table':{const g=tableGeom(e);return g.lines.map(l=>L(l[0],l[1])).concat(g.cells.map(t=>T([t.p[0],t.p[1]-e.h*0.35],t.s,e.h,0)));}}
 return null;}
function explodeSel(){if(!sel.size){log('Sélectionne d\'abord les objets à décomposer');return;}snapshot();let n=0;const out=[];ents.forEach(e=>{if(sel.has(e)){const r=explodeE(e);if(r){out.push(...r);n++;return;}}out.push(e);});if(!n){undoS.pop();log('Ces objets ne se décomposent pas');return;}ents=out;sel.clear();after();log(n+' objet(s) décomposé(s) en lignes simples');}
function userBlockEnts(e){const B=ublocks[String(e.name).slice(2)];if(!B)return [];const sc=e.sc||1,m=e.m||1,rot=e.rot||0;
 return B.ents.map(x=>{const q=cloneE(x);if(m<0)mirrorE(q,[0,0],Math.PI/2);if(sc!==1)scaleE(q,[0,0],sc);if(rot)rotateE(q,[0,0],rot);translate(q,e.p);if(!q.layer||q.layer==='0')q.layer=e.layer;return q;});}
function renderBlocks(){const b=$('#blkw .wb'),ks=Object.keys(ublocks);
 b.innerHTML=ks.length?ks.map(k=>'<div class="fr"><label style="min-width:0;flex:1">'+esc(k)+' <span class="note">('+ublocks[k].ents.length+' objets)</span></label><button class="bt p" data-ins="'+esc(k)+'">Insérer</button><button class="bt d" data-del="'+esc(k)+'">×</button></div>').join(''):'<div class="note">Aucun bloc. Sélectionne des objets, puis Insérer › Mes blocs › Créer.</div>';
 b.querySelectorAll('[data-ins]').forEach(x=>x.onclick=()=>{$('#blkw').classList.remove('on');S.blockName='u:'+x.dataset.ins;setTool('block');});
 b.querySelectorAll('[data-del]').forEach(x=>x.onclick=()=>{const k=x.dataset.del;if(ents.some(e=>e.t==='block'&&e.name==='u:'+k)){log('Ce bloc est utilisé dans le plan : efface ou décompose d\'abord ses copies');return;}delete ublocks[k];save();renderBlocks();});}
function afterExt(){if(!extNext)return;extNext=false;const ne=ents[ents.length-1];if(!ne||!(ne.t==='pline'||ne.t==='circle'))return;
 askIn('num','Hauteur du volume ('+S.unit+'), puis Entrée',n=>{const L=inM(n);if(!(L>0)){log('Hauteur non valable');return;}snapshot();ne.ext=+L.toFixed(6);ne.z=ne.z||0;after();log('Volume créé : regarde-le en 3D');});}

/* ---------- onglets de plans ---------- */
const DKEY=KEY+'_docs';
function docData(){return JSON.stringify({ents,cons,views,ublocks,layers,curLayer,name:$('#fname').value});}
function useDoc(j){const d=j?JSON.parse(j):{};ents=d.ents||[];cons=d.cons||[];views=d.views||[];ublocks=d.ublocks||{};layers=d.layers&&d.layers.length?d.layers:JSON.parse(JSON.stringify(DEF_LAYERS));curLayer=d.curLayer||'0';$('#fname').value=d.name||'Plan sans titre';mergeDefaultLayers();S.curFl=0;ensureIds();undoS=[];redoS=[];sel.clear();vhist=[];}
function saveDocs(){try{docs[curDoc].name=$('#fname').value;localStorage.setItem(DKEY,JSON.stringify({list:docs.map((d,i)=>({name:d.name,data:i===curDoc?null:d.data})),cur:curDoc}));}catch(e){log('Mémoire du téléphone pleine : ferme des onglets ou enregistre tes plans');}}
function loadDocs(){try{const d=JSON.parse(localStorage.getItem(DKEY)||'null');if(d&&Array.isArray(d.list)&&d.list.length){docs=d.list;curDoc=Math.max(0,Math.min(d.cur||0,docs.length-1));docs[curDoc].data=null;}}catch(e){}}
function renderTabs(){const t=$('#doctabs');if(!t)return;if(docs[curDoc])docs[curDoc].name=$('#fname').value;
 t.innerHTML=docs.map((d,i)=>'<div class="dt'+(i===curDoc?' on':'')+'" data-i="'+i+'"><span>'+esc(d.name||'Plan')+'</span>'+(docs.length>1?'<b data-x="'+i+'">×</b>':'')+'</div>').join('')+'<button class="add" title="Nouvel onglet">＋</button>';
 t.querySelectorAll('.dt').forEach(x=>x.onclick=ev=>{if(ev.target.dataset.x!=null)return;switchDoc(+x.dataset.i);});
 t.querySelectorAll('[data-x]').forEach(x=>x.onclick=()=>closeDoc(+x.dataset.x));t.querySelector('.add').onclick=()=>newDoc();}
function switchDoc(i){if(i===curDoc||!docs[i])return;docs[curDoc].data=docData();docs[curDoc].name=$('#fname').value;curDoc=i;useDoc(docs[i].data);docs[i].data=null;fillMinis();setTool('select');zoomExt();after();saveDocs();renderTabs();log('Plan : '+$('#fname').value);}
function newDoc(name){docs[curDoc].data=docData();docs[curDoc].name=$('#fname').value;docs.push({name:name||'Plan sans titre',data:null});curDoc=docs.length-1;useDoc(null);if(name)$('#fname').value=name;fillMinis();setTool('select');view.s=40;view.ox=60;view.oy=H-60;after();saveDocs();renderTabs();}
function closeDoc(i){const nm=i===curDoc?$('#fname').value:docs[i].name;
 ask('Fermer l\'onglet « '+esc(nm)+' » ? Pense à l\'enregistrer avant si tu veux le garder.',[['Annuler'],['Fermer',()=>{if(i===curDoc){docs.splice(i,1);curDoc=Math.max(0,i-1);useDoc(docs[curDoc].data);docs[curDoc].data=null;fillMinis();setTool('select');zoomExt();after();}else{docs.splice(i,1);if(i<curDoc)curDoc--;}saveDocs();renderTabs();},'d']]);}

/* ---------- outils ---------- */
function promptText(){if(waitIn)return waitIn.label;const n=pts.length;
 if(padP)return 'Ajuste avec les flèches N S E O, puis touche « Poser »';
 if(tool.startsWith('el_')){const K=ELK[tool.slice(3)]||{n:'',w:0};return n?(K.two?'Fin de la rampe, ou longueur + flèche':'Point suivant ('+K.n.toLowerCase()+'), ou longueur + flèche — Terminer pour arrêter'):K.n.toUpperCase()+' : premier point'+(K.w?' (largeur '+uL(K.w)+')':'');}
 if(OPK[tool]&&!['door','door2','window'].includes(tool))return n?'Autre bord de l\'ouverture, ou largeur + flèche (ex : 1.20)':OPN[tool].toUpperCase()+' : premier bord, sur l\'axe du mur';
 if(tool==='arranger')return 'ARRANGER UNE PIÈCE : choisis son nom en bas, ou touche l\'intérieur de la pièce';
 if(tool==='rinfo')return 'MESURER LA PIÈCE : touche l\'intérieur d\'une pièce pour voir ses mesures et la place libre';
 if(tool==='zroom')return 'ALLER À UNE PIÈCE : choisis son nom en bas, ou touche l\'intérieur de la pièce';
 if(tool==='piece')return 'NOM + SURFACE : touche l\'intérieur d\'une pièce fermée';
 if(tool==='sol')return 'SOL : choisis le revêtement en bas, puis touche l\'intérieur d\'une pièce ou d\'un contour fermé';
 if(tool==='paint')return 'PEINTURE : choisis la couleur en bas, puis touche un mur (ou « Tous les murs »)';
 if(tool==='coupe')return n?'Fin du trait de coupe (on regarde du côté de la petite flèche)':'COUPE : premier point du trait de coupe, à travers la maison';
 switch(tool){
 case 'select':return sel.size?sel.size+' objet(s) sélectionné(s)':'Touche un objet pour le sélectionner, ou tape une commande (AIDE)';
 case 'line':return n?'Point suivant, ou longueur + flèche — Entrée pour finir':'LIGNE : premier point';
 case 'pline':return n?'Point suivant ou longueur — Entrée pour finir, F pour fermer':'POLYLIGNE : premier point';
 case 'wall':return n?'Fin du mur, ou longueur + flèche (épaisseur '+uL(S.wallT)+')':'MUR : point de départ (axe du mur)';
 case 'stair':return n?'Haut de l\'escalier (sens de la montée), ou longueur + flèche':'ESCALIER : départ en bas, au milieu de la largeur ('+uL(S.stairW)+')';
 case 'rect':return n?'Coin opposé (ou @largeur;hauteur, ex : @4;3)':'RECTANGLE : premier coin';
 case 'circle':return n?'Rayon : point ou valeur':'CERCLE : centre';
 case 'arc':return ['ARC : point de départ','Point de passage','Point d\'arrivée'][n];
 case 'hatch':return 'HACHURES : touche l\'intérieur d\'un rectangle, d\'un cercle ou d\'une polyligne fermée';
 case 'door':return n?'Fin de l\'ouverture, ou largeur + flèche (ex : 0.90)':'PORTE : point de la charnière, sur l\'axe du mur';
 case 'door2':return n?'Autre bord de l\'ouverture, ou largeur + flèche (ex : 1.60)':'PORTE DOUBLE : premier bord, sur l\'axe du mur';
 case 'gomme':return 'GOMME : touche un objet pour l\'effacer, ou glisse le doigt pour effacer une zone (↶ pour annuler)';
 case 'window':return n?'Fin de la fenêtre, ou largeur + flèche (ex : 1.20)':'FENÊTRE : premier bord, sur l\'axe du mur';
 case 'dim':return ['COTATION : premier point','Deuxième point','Position de la ligne de cote (ou décalage)'][n];
 case 'rdim':return tdata?'Où placer le texte du rayon':'COTE DE RAYON : touche un cercle ou un arc';
 case 'leader':return n?'Point où écrire le texte':'REPÈRE : point visé (la pointe de la flèche)';
 case 'area':return n?'Coin suivant — Terminer pour calculer':'SURFACE : touche l\'intérieur d\'une forme fermée, ou pose les coins de la pièce';
 case 'text':return 'TEXTE : point où écrire';
 case 'measure':return n?'Deuxième point':'DISTANCE : premier point';
 case 'move':return n?'Point de destination (ou longueur + flèche)':'DÉPLACER : point de base';
 case 'copy':return n?'Point de destination — Entrée pour finir':'COPIER : point de base';
 case 'rotate':return n?'Angle : point ou degrés (ex : 90)':'ROTATION : point de base';
 case 'mirror':return n?'Deuxième point de l\'axe du miroir':'MIROIR : premier point de l\'axe';
 case 'scale':return n?'Facteur d\'échelle (ex : 2 ou 0.5), puis Entrée':'ÉCHELLE : point de base';
 case 'offset':return tdata?'Touche le côté où placer la copie':'DÉCALER de '+uL(S.offD)+' : touche l\'objet (tape un nombre pour changer la distance)';
 case 'block':return 'BLOC « '+blkName(S.blockName)+' » : touche où le poser — tape un angle pour le tourner ('+(S.blkRot||0)+'°)';
 case 'calib':return n?'Deuxième point dont tu connais la vraie distance':'CALIBRER L\'IMAGE : premier point dont tu connais la distance';
 case 'imgmove':return n?'Nouvelle position':'DÉPLACER L\'IMAGE : point de base';
 case 'polygon':return n?'Rayon : point ou valeur':'POLYGONE à '+S.polySides+' côtés : centre (tape un nombre pour changer les côtés)';
 case 'ellipse':return ['ELLIPSE : centre','Fin du premier axe','Deuxième demi-axe : point ou valeur'][n];
 case 'spline':return n?'Point suivant — Terminer pour finir':'SPLINE (courbe) : premier point';
 case 'trim':return 'AJUSTER : touche la partie d\'une ligne ou d\'un mur à couper';
 case 'extend':return 'PROLONGER : touche une ligne ou un mur près du bout à rallonger';
 case 'fillet':return tdata?'Touche la deuxième ligne':'RACCORD (rayon '+uL(S.filletR)+') : touche la première ligne — tape un nombre pour changer le rayon';
 case 'chamfer':return tdata?'Touche la deuxième ligne':'CHANFREIN ('+uL(S.chamD)+') : touche la première ligne — tape un nombre pour changer la distance';
 case 'arrayP':return 'RÉSEAU POLAIRE ('+S.arrN+' éléments sur '+S.arrA+'°) : touche le centre';
 case 'dimc':return tdata?'Point suivant de la chaîne — Terminer pour finir':['COTES EN CHAÎNE : premier point','Deuxième point','Position de la ligne de cote'][n];
 case 'adim':return ['COTE D\'ANGLE : sommet de l\'angle','Point sur le premier côté','Point sur le deuxième côté','Position de l\'arc'][n];
 case 'ddim':return tdata?'Où placer le texte du diamètre':'COTE DE DIAMÈTRE : touche un cercle ou un arc';
 case 'rtable':return 'TABLEAU DES PIÈCES : touche où placer le coin en haut à gauche';
 case 'stretch':return !tdata?'ÉTIRER : trace un cadre autour des points à déplacer':(pts.length?'Point de destination (ou longueur + flèche)':'Point de base');
 case 'brk':return tdata?'Deuxième point (touche le même point pour couper en deux)':'COUPER : touche la ligne ou le mur au premier point';
 case 'bbase':return 'POINT DE BASE du bloc « '+(blkPending?blkPending.name:'')+' »';
 case 'ucs':return 'ORIGINE (SCU) : touche le point qui devient 0;0';
 case 'zwin':return 'ZOOM FENÊTRE : trace un cadre autour de la zone à agrandir';
 case 'idpt':return 'POINT : touche un point pour lire ses coordonnées exactes';
 case 'pan':return 'PANORAMIQUE : glisse le dessin avec le doigt';}return '';}
const LEN_TOOLS=['line','wall','pline','stair','door','door2','window','move','copy','measure','mirror','area','imgmove','spline','stretch','coupe',...Object.keys(OPK),...Object.keys(ELK).map(k=>'el_'+k)];
function updPrompt(){$('#cmd').placeholder=promptText();let h='';const n=pts.length;
 if(n&&LEN_TOOLS.includes(tool)&&!waitIn)h+='<button class="dir" data-c="d0">→</button><button class="dir" data-c="d90">↑</button><button class="dir" data-c="d180">←</button><button class="dir" data-c="d270">↓</button>';
 const chain=tool.startsWith('el_')&&ELK[tool.slice(3)]&&!ELK[tool.slice(3)].two;
 if(n&&(['line','wall','pline','area'].includes(tool)||chain))h+='<button data-c="back">↶ Point</button>';
 if(chain&&n)h+='<button class="p" data-c="done">Terminer</button>';
 if(tool==='paint'&&!waitIn){h+=PAINTS.map(([c,nm])=>'<button class="sw'+(S.paintCol===c?' on':'')+'" data-c="pc:'+c+'" title="'+nm+'" style="background:'+c+'"></button>').join('')+'<button data-c="pc:none" class="'+(S.paintCol==='none'?'p':'')+'">Sans</button><button data-c="pc:all">Tous les murs</button>';}
 if(tool==='sol'&&!waitIn)h+=Object.entries(FLOORM).map(([k,m])=>'<button data-c="sm:'+k+'" class="'+(S.solMat===k?'p':'')+'"><i style="background:rgb('+m.c.join(',')+')"></i>'+m.n+'</button>').join('');
 if(tool==='arranger')h+=roomList().map((r,i)=>'<button data-c="ar:'+i+'">🛋 '+esc(r.n)+'</button>').join('');
 if(tool==='zroom')h+=roomList().map((r,i)=>'<button data-c="zr:'+i+'">🏠 '+esc(r.n)+'</button>').join('');
 if(waitIn&&waitIn.kind==='room')h+=ROOMN.map(r=>'<button data-c="rn:'+r+'">'+r+'</button>').join('');
 if(tool==='pline'&&n>2)h+='<button data-c="close">Fermer</button>';
 if((n&&['line','wall','pline','copy'].includes(tool))||(tool==='area'&&n>2)||(tool==='spline'&&n>1)||(tool==='dimc'&&tdata))h+='<button class="p" data-c="done">Terminer</button>';
 if(!NOCROSS.includes(tool)||waitIn||tool==='gomme'||tool==='zwin')h+='<button data-c="esc">✕</button>';
 $('#ctx').innerHTML=h;}
function setTool(t){extNext=false;if(TNAMES[t]&&!sel.size){log('Sélectionne d\'abord les objets (outil Sélection), puis choisis « '+TNAMES[t]+' ».');t='select';}
 if((t==='calib'||t==='imgmove')&&!bgImg){log('Insère d\'abord une image (onglet Insérer › Image)');t='select';}
 {const tp=toolPhase(t);if(tp!=null&&tp!==curStep())setStep(tp,true);}
 pts=[];waitIn=null;tdata=null;cursor=null;snapHit=null;padP=null;padGrip=null;tool=t;if(t!=='rinfo')ROOMHL=$('#roomw').classList.contains('on')?ROOMHL:null;
 if(!NOCROSS.includes(t)&&!TNAMES[t]){lastTool=t;sel.clear();}
 document.querySelectorAll('.tb[data-id]').forEach(b=>b.classList.toggle('on',b.dataset.id===t||(t==='block'&&b.dataset.id===S.blockName)));{const vg=$('#vGomme');if(vg)vg.classList.toggle('on',t==='gomme');}
 refreshProp();updPrompt();draw();}
function finish(){
 if(padP){padOk();return;}
 if(waitIn){waitIn=null;}
 else if(tool==='pline'&&pts.length>1){add({t:'pline',p:pts.slice(),closed:false});pts=[];}
 else if(tool==='spline'&&pts.length>1){add({t:'spline',p:pts.slice()});pts=[];}
 else if(tool==='area'&&pts.length>2){const P=pts.slice();let per=0;for(let i=0;i<P.length;i++)per+=dist(P[i],P[(i+1)%P.length]);placeAreaLabel(centroid(P),Math.abs(polyArea(P)),per);pts=[];}
 else if(pts.length||tdata){pts=[];tdata=null;sel.clear();if(TNAMES[tool]){setTool('select');return;}}
 else if(NOCROSS.includes(tool)){setTool(lastTool);return;}
 else{setTool('select');return;}
 updPrompt();draw();}
function escape(){if(padP){padP=null;updPrompt();draw();return;}if(waitIn){waitIn=null;log('Annulé');}else if(tool==='select'){sel.clear();refreshProp();}else setTool('select');pts=[];tdata=null;updPrompt();draw();}
function closePline(){if(tool==='pline'&&pts.length>2){add({t:'pline',p:pts.slice(),closed:true});pts=[];updPrompt();draw();}}
function backPoint(){if(!pts.length)return;if((tool==='line'||tool==='wall'||(tool.startsWith('el_')&&ELK[tool.slice(3)]&&!ELK[tool.slice(3)].two))&&pts.length>1)undo();pts.pop();updPrompt();draw();}
function xPoint(p){
 if(tool.startsWith('el_')){const k=tool.slice(3),K=ELK[k];if(!K)return false;if(K.two){pts.push(p);if(pts.length===2){if(dist(pts[0],p)>1e-9)add(mkElem(k,pts[0],p));pts=[];}}else{if(pts.length&&dist(last(),p)>1e-9)add(mkElem(k,last(),p));pts.push(p);}return true;}
 if(OPK[tool]){pts.push(p);if(pts.length===2){if(dist(pts[0],p)>1e-9)add(mkOpen(tool,pts[0],p));pts=[];}return true;}
 if(tool==='piece'){roomLabel(p);return true;}
 if(tool==='paint'){paintAt(p);return true;}
 if(tool==='sol'){floorAt(p);return true;}
 if(tool==='rinfo'){roomInfo(p);return true;}
 if(tool==='arranger'){const r=roomAt(p);if(!r||r.open){log('Touche l\'intérieur d\'une pièce fermée');return true;}const lab=roomList().find(x=>pointInPoly(x.p,r.poly));startArrange({n:lab?lab.n:'Pièce',poly:r.poly,fl:S.curFl|0});return true;}
 if(tool==='zroom'){const r=roomAt(p);if(!r||r.open){log('Touche l\'intérieur d\'une pièce fermée');return true;}zoomBox(scrBox(r.poly));setTool('select');log('Pièce agrandie : '+fmt(r.area).replace('.',',')+' m²');return true;}
 if(tool==='coupe'){pts.push(p);if(pts.length===2){const [a,b]=pts;pts=[];if(dist(a,b)>0.3)openSection(a,b);else log('Trait de coupe trop court');}return true;}
 return false;}
/* ---------- pièces : détection automatique ---------- */
function roomAt(p){const segs=[],polys=[];
 for(const e of ents){if(!visible(e))continue;
  if(e.t==='wall')polys.push(wallPoly(e));
  else if(e.t==='door'||e.t==='window')segs.push([e.a,e.b,(e.th||S.wallT)/2]);
  else if(e.t==='elem'){if(['cloture','limite','haie','garde'].includes(e.k)){const Q=elemPoly(e);if(Q&&e.w)polys.push(Q);else segs.push([e.a,e.b,0]);}}
  else if(e.t==='line')segs.push([e.a,e.b,0]);
  else if(e.t==='pline'&&!e.mat&&!e.ext)segsOf(e).forEach(sg=>segs.push([sg[0],sg[1],0]));
  else if(e.t==='block'&&(BLOCKS[e.name]||{}).struct){const g=blockPrims(e);if(g.l.length>=4)polys.push([g.l[0][0],g.l[1][0],g.l[2][0],g.l[3][0]]);}}
 if(!polys.length&&!segs.length)return null;
 let x0=Infinity,y0=Infinity,x1=-Infinity,y1=-Infinity;const ex=q=>{x0=Math.min(x0,q[0]);y0=Math.min(y0,q[1]);x1=Math.max(x1,q[0]);y1=Math.max(y1,q[1]);};polys.forEach(Q=>Q.forEach(ex));segs.forEach(sg=>{ex(sg[0]);ex(sg[1]);});
 if(p[0]<=x0||p[0]>=x1||p[1]<=y0||p[1]>=y1)return {open:true};
 let cs=0.02;for(const c of [0.02,0.025,0.05,0.1,0.2,0.5]){cs=c;if((x1-x0)*(y1-y0)/(c*c)<2.5e6)break;}
 const gx=Math.floor(x0/cs)*cs-2*cs,gy=Math.floor(y0/cs)*cs-2*cs,nx=Math.ceil((x1-gx)/cs)+3,ny=Math.ceil((y1-gy)/cs)+3,B=new Uint8Array(nx*ny);
 const ci=x=>Math.floor((x-gx)/cs),cx=i=>gx+(i+0.5)*cs,cy=j=>gy+(j+0.5)*cs;
 polys.forEach(Q=>{const b=scrBox(Q),i0=Math.max(0,ci(b[0])),i1=Math.min(nx-1,ci(b[2])),j0=Math.max(0,Math.floor((b[1]-gy)/cs)),j1=Math.min(ny-1,Math.floor((b[3]-gy)/cs));for(let j=j0;j<=j1;j++)for(let i=i0;i<=i1;i++){const k=j*nx+i;if(!B[k]&&pointInPoly([cx(i),cy(j)],Q))B[k]=1;}});
 segs.forEach(([a,b,hw])=>{const r=Math.max(hw,cs*0.75),i0=Math.max(0,ci(Math.min(a[0],b[0])-r)),i1=Math.min(nx-1,ci(Math.max(a[0],b[0])+r)),j0=Math.max(0,Math.floor((Math.min(a[1],b[1])-r-gy)/cs)),j1=Math.min(ny-1,Math.floor((Math.max(a[1],b[1])+r-gy)/cs));for(let j=j0;j<=j1;j++)for(let i=i0;i<=i1;i++){const k=j*nx+i;if(!B[k]&&segDist([cx(i),cy(j)],a,b)[0]<=r)B[k]=1;}});
 const si=ci(p[0]),sj=Math.floor((p[1]-gy)/cs);if(si<0||sj<0||si>=nx||sj>=ny||B[sj*nx+si])return null;
 const Fl=new Uint8Array(nx*ny),q=new Int32Array(nx*ny);let qh=0,qt=0,open=false,cnt=0;q[qt++]=sj*nx+si;Fl[sj*nx+si]=1;
 while(qh<qt){const k=q[qh++],i=k%nx,j=(k-i)/nx;cnt++;if(i===0||j===0||i===nx-1||j===ny-1){open=true;break;}for(const kk of [k-1,k+1,k-nx,k+nx])if(!Fl[kk]&&!B[kk]){Fl[kk]=1;q[qt++]=kk;}}
 if(open)return {open:true};
 const V=new Map(),key=(i,j)=>j*(nx+1)+i,ad=(a,b)=>{let l=V.get(a);if(!l)V.set(a,l=[]);l.push(b);},f=(i,j)=>Fl[j*nx+i]===1;
 for(let j=1;j<ny-1;j++)for(let i=1;i<nx-1;i++){if(!f(i,j))continue;if(!f(i,j-1))ad(key(i,j),key(i+1,j));if(!f(i+1,j))ad(key(i+1,j),key(i+1,j+1));if(!f(i,j+1))ad(key(i+1,j+1),key(i,j+1));if(!f(i-1,j))ad(key(i,j+1),key(i,j));}
 const loops=[];while(V.size){const s0=V.keys().next().value,lp=[s0];let cur=s0,g=0;for(;g<4e6;g++){const l=V.get(cur);if(!l)break;const nx2=l.pop();if(!l.length)V.delete(cur);cur=nx2;if(cur===s0)break;lp.push(cur);}loops.push(lp);}
 const W1=nx+1,toW=k=>{const i=k%W1,j=(k-i)/W1;return [gx+i*cs,gy+j*cs];};
 const simp=Q=>{let A=Q.map(toW),ch=true;const rm=tol=>{ch=true;while(ch&&A.length>3){ch=false;for(let i=0;i<A.length&&A.length>3;i++){const a=A[(i-1+A.length)%A.length],b=A[i],c=A[(i+1)%A.length];if(segLineDist(b,a,c)<tol&&projT(b,a,c)>-1e-9&&projT(b,a,c)<1+1e-9){A.splice(i,1);ch=true;i--;}}}};rm(1e-9);rm(cs*1.05);return A.map(rnd);};
 const XS=[],YS=[];polys.forEach(Q=>Q.forEach(q=>{XS.push(q[0]);YS.push(q[1]);}));const snp=(v,A)=>{let b=v,bd=cs*0.75;for(const a of A){const d=Math.abs(a-v);if(d<bd){bd=d;b=a;}}return b;};
 const L2=loops.map(simp).map(Q=>Q.map(q=>rnd([snp(q[0],XS),snp(q[1],YS)]))).map(Q=>({Q,a:polyArea(Q)}));let outer=null;L2.forEach(o=>{if(o.a>0&&(!outer||o.a>outer.a))outer=o;});if(!outer)return null;
 const holes=L2.filter(o=>o.a<-cs*cs*4).map(o=>o.Q);const ar=outer.a+holes.reduce((s2,H)=>s2+polyArea(H),0);
 return {poly:outer.Q,holes,area:ar};}
function roomLabel(p){const r=roomAt(p);if(!r){log('Touche l\'intérieur d\'une pièce, pas un mur');return;}if(r.open){log('Cette pièce n\'est pas fermée : ferme les murs (portes et fenêtres comptent comme fermées)');return;}
 askIn('room','Nom de la pièce : choisis en bas ou écris-le, puis Entrée (surface '+fmt(r.area).replace('.',',')+' m²)',nm=>{const s2=String(nm).trim()||'Pièce',h=S.txtH,ls=[s2,fmt(r.area).replace('.',',')+' m²'],w=Math.max(...ls.map(x=>x.length))*h*0.6;add({t:'text',p:rnd([p[0]-w/2,p[1]+h*0.3]),s:ls.join('\n'),h,room:true});log(s2+' : '+fmt(r.area).replace('.',',')+' m²');});}
function paintAt(p){ALLOWLOCK=true;const e=hitTest(p,16/view.s,['wall','elem']);ALLOWLOCK=false;if(!e){log('Touche un mur pour le peindre');return;}snapshot();if(S.paintCol==='none')delete e.paint;else e.paint=S.paintCol;after();log(S.paintCol==='none'?'Peinture enlevée':'Mur peint : '+(PAINTS.find(x=>x[0]===S.paintCol)||['',''])[1]);}
function floorAt(p){const m=FLOORM[S.solMat]?S.solMat:'carrelage';
 const ex=ents.filter(e=>e.t==='pline'&&e.mat&&visible(e)&&pointInPoly(p,e.p)&&!(e.holes||[]).some(H=>pointInPoly(p,H))).sort((a,b)=>area(a)-area(b));
 if(ex.length){snapshot();ex[0].mat=m;after();log('Revêtement changé : '+FLOORM[m].n);return;}
 const r=roomAt(p);
 if(!r||r.open){const cl=ents.filter(e=>e.t==='pline'&&e.closed&&!e.mat&&visible(e)&&pointInPoly(p,e.p)).sort((a,b)=>area(a)-area(b))[0];if(cl){snapshot();cl.mat=m;after();log(FLOORM[m].n+' posé : '+fmt(area(cl))+' m²');return;}
  log('Zone non fermée : entoure-la d\'abord (murs, clôture, limite ou rectangle), puis touche dedans');return;}
 const e={t:'pline',p:r.poly,closed:true,mat:m,layer:layerOf('Sols')?'Sols':curLayer};if(r.holes.length)e.holes=r.holes;add(e,true);log(FLOORM[m].n+' posé : '+fmt(r.area).replace('.',',')+' m²');}
function askIn(kind,label,fn){waitIn={kind,label,fn};updPrompt();setTimeout(()=>$('#cmd').focus(),60);}
function handlePoint(p){if(!p)return;padP=null;
 if(xPoint(p)){updPrompt();draw();return;}
 switch(tool){
 case 'line':if(pts.length&&dist(last(),p)>1e-9)add({t:'line',a:last(),b:p});pts.push(p);break;
 case 'wall':if(pts.length&&dist(last(),p)>1e-9)add({t:'wall',a:last(),b:p,th:S.wallT});pts.push(p);break;
 case 'pline':case 'area':if(tool==='area'&&!pts.length){const e=closedAt(p);if(e){placeAreaLabel(e.t==='circle'?e.c:centroid(e.p),e.t==='circle'?Math.PI*e.r*e.r:area(e),e.t==='circle'?2*Math.PI*e.r:perim(e));break;}}pts.push(p);break;
 case 'stair':pts.push(p);if(pts.length===2){const L=dist(pts[0],p);if(L>1e-9)add({t:'stair',a:pts[0],b:p,w:S.stairW,n:Math.max(2,Math.round(L/0.28))});pts=[];}break;
 case 'rect':pts.push(p);if(pts.length===2){const [a,b]=pts;if(Math.abs(a[0]-b[0])>1e-9&&Math.abs(a[1]-b[1])>1e-9)add({t:'pline',p:[a,[b[0],a[1]],b,[a[0],b[1]]],closed:true});pts=[];afterExt();}break;
 case 'circle':pts.push(p);if(pts.length===2){const r=dist(pts[0],p);if(r>1e-9)add({t:'circle',c:pts[0],r});pts=[];afterExt();}break;
 case 'arc':pts.push(p);if(pts.length===3){const a=arc3(pts[0],pts[1],pts[2]);if(a)add(a);else log('Les trois points sont alignés : pas d\'arc possible');pts=[];}break;
 case 'hatch':{const e=closedAt(p);if(!e){log('Touche l\'intérieur d\'un rectangle, d\'un cercle ou d\'une polyligne fermée');return;}snapshot();e.hatch=e.hatch?false:(S.hatchPat||'diag');save();log(e.hatch?'Hachures ajoutées':'Hachures retirées');break;}
 case 'door':case 'door2':case 'window':pts.push(p);if(pts.length===2){if(dist(pts[0],p)>1e-9){const ne={t:tool==='window'?'window':'door',a:pts[0],b:p,th:S.wallT,flip:false};if(tool==='door2')ne.dbl=true;add(ne);}pts=[];}break;
 case 'dim':pts.push(p);if(pts.length===3){if(dist(pts[0],pts[1])>1e-9)add({t:'dim',a:pts[0],b:pts[1],o:p,h:S.dimTxt});pts=[];}break;
 case 'rdim':{if(!tdata){const e=hitTest(p,18/view.s,['circle','arc']);if(!e||(e.t!=='circle'&&e.t!=='arc')){log('Touche un cercle ou un arc');return;}tdata=e;sel=new Set([e]);break;}add({t:'rdim',c:tdata.c.slice(),r:tdata.r,p,h:S.dimTxt});tdata=null;sel.clear();break;}
 case 'leader':pts.push(p);if(pts.length===2){const [a,b]=pts;pts=[];askIn('text','Texte du repère, puis Entrée',s=>{add({t:'leader',a,b,s,h:S.txtH});log('Repère ajouté');});draw();return;}break;
 case 'text':askIn('text','Tape le texte puis Entrée (le signe | va à la ligne)',s=>{add({t:'text',p,s:s.replace(/\s*\|\s*/g,'\n'),h:S.txtH,rot:0});log('Texte ajouté');});log('Tape le texte en bas, puis Entrée');draw();return;
 case 'measure':pts.push(p);if(pts.length===2){const [a,b]=pts;log('Distance : '+uL(dist(a,b))+'   (ΔX '+fmtL(b[0]-a[0])+' · ΔY '+fmtL(b[1]-a[1])+')');pts=[];}break;
 case 'block':{const q={t:'block',name:S.blockName,p,rot:(S.blkRot||0)*Math.PI/180,sc:1,m:1};const sn=S.wallSnap!==false&&snapBlock(q,0.3);add(q);log(blkName(S.blockName)+' posé'+(sn?' contre le mur':'')+' — touche ailleurs pour en poser un autre');break;}
 case 'offset':{if(!tdata){const e=hitTest(p,18/view.s,['line','wall','circle','arc','pline']);if(!e||!['line','wall','circle','arc','pline'].includes(e.t)){log('Touche une ligne, un mur, un cercle, un arc ou une polyligne');return;}tdata=e;sel=new Set([e]);break;}
  const ne=offsetEnt(tdata,S.offD,p);if(ne)add(ne,true);else log('Décalage impossible ici');tdata=null;sel.clear();break;}
 case 'polygon':pts.push(p);if(pts.length===2){polyAt(pts[0],dist(pts[0],p),Math.atan2(p[1]-pts[0][1],p[0]-pts[0][0]));pts=[];}break;
 case 'ellipse':pts.push(p);if(pts.length===3){const c0=pts[0],a=pts[1],rx=dist(c0,a),ry=segLineDist(p,c0,a);if(rx>1e-9&&ry>1e-9)add({t:'ellipse',c:c0,rx,ry,rot:Math.atan2(a[1]-c0[1],a[0]-c0[0])});pts=[];}break;
 case 'spline':pts.push(p);break;
 case 'trim':case 'extend':{const e=hitTest(p,18/view.s,['line','wall']);if(!e||(e.t!=='line'&&e.t!=='wall')){log('Touche une ligne ou un mur');return;}log(tool==='trim'?trimE(e,p):extendE(e,p));break;}
 case 'fillet':case 'chamfer':{const e=hitTest(p,18/view.s,['line','wall']);if(!e||(e.t!=='line'&&e.t!=='wall')){log('Touche une ligne ou un mur');return;}if(!tdata){tdata={e,p};sel=new Set([e]);break;}if(e===tdata.e){log('Touche une autre ligne');return;}const r=cornerE(tdata.e,tdata.p,e,p,tool);tdata=null;sel.clear();log(r);break;}
 case 'arrayP':{snapshot();const nw=[],n=Math.max(2,S.arrN|0),A=S.arrA*Math.PI/180,st=Math.abs(S.arrA)>=359.9?A/n:A/(n-1);for(let i=1;i<n;i++)sel.forEach(e=>{const q=cloneE(e);rotateE(q,p,st*i);mapPts(q,rnd);nw.push(q);});ents.push(...nw);after();setTool('select');log('Réseau polaire : '+nw.length+' copies');return;}
 case 'dimc':{if(tdata){const a=tdata.b,L=dist(a,p);if(L<1e-9)return;const nx=-(p[1]-a[1])/L,ny=(p[0]-a[0])/L;add({t:'dim',a,b:p,o:rnd([a[0]+nx*tdata.d,a[1]+ny*tdata.d]),h:S.dimTxt});tdata.b=p;break;}
  pts.push(p);if(pts.length===3){const e={t:'dim',a:pts[0],b:pts[1],o:p,h:S.dimTxt},g=dimGeom(e);if(g){add(e);tdata={b:pts[1],d:g.d};}pts=[];}break;}
 case 'adim':pts.push(p);if(pts.length===4){add({t:'adim',c:pts[0],p1:pts[1],p2:pts[2],o:p,h:S.dimTxt});pts=[];}break;
 case 'ddim':{if(!tdata){const e=hitTest(p,18/view.s,['circle','arc']);if(!e||(e.t!=='circle'&&e.t!=='arc')){log('Touche un cercle ou un arc');return;}tdata=e;sel=new Set([e]);break;}add({t:'rdim',dia:true,c:tdata.c.slice(),r:tdata.r,p,h:S.dimTxt});tdata=null;sel.clear();break;}
 case 'rtable':{const rows=roomRows();if(!rows.length){log('Dessine d\'abord les pièces en rectangle ou polyligne fermée, avec leur nom écrit à l\'intérieur');return;}add(makeTable(p,rows));setTool('select');log('Tableau des pièces ajouté');return;}
 case 'stretch':{if(!tdata){log('Trace d\'abord un cadre autour des points à étirer');return;}pts.push(p);if(pts.length===2){const d=[p[0]-pts[0][0],p[1]-pts[0][1]],bx=tdata.box;snapshot();sel.forEach(e=>stretchE(e,bx,d));pts=[];tdata=null;sel.clear();after();setTool('select');log('Étiré');return;}break;}
 case 'brk':{if(!tdata){const e=hitTest(p,18/view.s,['line','wall']);if(!e){log('Touche une ligne ou un mur');return;}tdata={e,p};sel=new Set([e]);break;}const r=breakE(tdata.e,tdata.p,p);tdata=null;sel.clear();log(r);break;}
 case 'bbase':{if(!blkPending){setTool('select');return;}const nm=blkPending.name,L=blkPending.ents;blkPending=null;snapshot();const rm=new Set(L);ublocks[nm]={ents:L.map(e=>{const q=cloneE(e);delete q.id;translate(q,[-p[0],-p[1]]);mapPts(q,rnd);return q;})};ents=ents.filter(e=>!rm.has(e));ents.push({t:'block',name:'u:'+nm,p,rot:0,sc:1,m:1,layer:L[0].layer||'0'});after();setTool('select');log('Bloc « '+nm+' » créé : retrouve-le dans Insérer › Mes blocs');return;}
 case 'ucs':S.ucs=[p[0],p[1]];save();setTool('select');log('Nouvelle origine : les coordonnées partent maintenant de ce point (Général pour revenir)');return;
 case 'idpt':log('Point : X '+fmtL(p[0]-U()[0])+' · Y '+fmtL(p[1]-U()[1])+' '+S.unit+(snapHit?' ('+snapHit.ty+')':''));break;
 case 'move':case 'copy':pts.push(p);if(pts.length===2){const d=[p[0]-pts[0][0],p[1]-pts[0][1]];snapshot();
   if(tool==='move'){sel.forEach(e=>{translate(e,d);mapPts(e,rnd);});pts=[];after();setTool('select');return;}
   const nw=[];sel.forEach(e=>{const q=cloneE(e);translate(q,d);mapPts(q,rnd);nw.push(q);});ents.push(...nw);pts=[pts[0]];save();}break;
 case 'rotate':pts.push(p);if(pts.length===2){rotateSel(pts[0],Math.atan2(p[1]-pts[0][1],p[0]-pts[0][0]));return;}break;
 case 'mirror':pts.push(p);if(pts.length===2){mirrorSel(pts[0],p);return;}break;
 case 'scale':pts=[p];log('Tape le facteur d\'échelle en bas (ex : 2 ou 0.5), puis Entrée');setTimeout(()=>$('#cmd').focus(),60);break;
 case 'imgmove':pts.push(p);if(pts.length===2){bgImg.x+=p[0]-pts[0][0];bgImg.y+=p[1]-pts[0][1];saveBg();pts=[];setTool('select');log('Image déplacée');return;}break;
 case 'calib':pts.push(p);if(pts.length===2){const [a,b]=pts,d=dist(a,b);pts=[];if(d<1e-9)break;askIn('num','Vraie distance entre ces deux points ('+S.unit+'), puis Entrée',n=>{const f=inM(n)/d;if(!(f>0)){log('Distance non valable');return;}bgImg.x=a[0]+(bgImg.x-a[0])*f;bgImg.y=a[1]+(bgImg.y-a[1])*f;bgImg.w*=f;bgImg.h*=f;saveBg();setTool('select');zoomBg();log('Image calibrée : elle est maintenant à la bonne échelle');});draw();return;}break;}
 updPrompt();draw();}
function typedNumber(n){const k=pts.length,L=inM(n);
 if(tool==='polygon'){if(k===0){const sd=Math.round(n);if(sd>=3&&sd<=64){S.polySides=sd;save();updPrompt();draw();log('Polygone à '+sd+' côtés');}else log('Entre 3 et 64 côtés');return;}if(L>0){polyAt(pts[0],L,0);pts=[];updPrompt();draw();}return;}
 if(tool==='ellipse'&&k===2){if(L>0){const c0=pts[0],a=pts[1];add({t:'ellipse',c:c0,rx:dist(c0,a),ry:L,rot:Math.atan2(a[1]-c0[1],a[0]-c0[0])});}pts=[];updPrompt();draw();return;}
 if(tool==='fillet'){if(L>=0){S.filletR=L;save();updPrompt();log('Rayon du raccord : '+uL(L));}return;}
 if(tool==='chamfer'){if(L>0){S.chamD=L;save();updPrompt();log('Distance du chanfrein : '+uL(L));}return;}
 if(tool==='scale'){if(k===1)scaleSel(pts[0],n);else log('Pose d\'abord le point de base');return;}
 if(tool==='offset'){if(L>0){S.offD=L;save();updPrompt();log('Distance de décalage : '+uL(L));}return;}
 if(tool==='block'){S.blkRot=n;updPrompt();draw();log('Les prochains blocs seront tournés de '+n+'°');return;}
 if(tool==='circle'&&k===1){if(L>0)add({t:'circle',c:pts[0],r:L});pts=[];updPrompt();draw();return;}
 if(tool==='rotate'&&k===1){rotateSel(pts[0],n*Math.PI/180);return;}
 if(tool==='dim'&&k===2){const [a,b]=pts,D=dist(a,b);if(D<1e-9)return;handlePoint(rnd([a[0]-(b[1]-a[1])/D*L,a[1]+(b[0]-a[0])/D*L]));return;}
 if(k>=1&&LEN_TOOLS.includes(tool)){const l=last();let dx=1,dy=0;if(cursor){const D=dist(l,cursor);if(D>1e-9){dx=(cursor[0]-l[0])/D;dy=(cursor[1]-l[1])/D;}}handlePoint(rnd([l[0]+dx*L,l[1]+dy*L]));return;}
 if(tool==='rect'&&k===1){log('Pour un rectangle, tape @largeur;hauteur (ex : @4;3)');return;}
 log('Pose d\'abord un point avec le doigt');}
function dirPoint(a){const v=$('#cmd').value.trim();if(!v){log('Tape d\'abord la longueur en bas (ex : 3.55), puis appuie sur la flèche');$('#cmd').focus();return;}
 const n=num(v);if(!isFinite(n)){log('Longueur non comprise : '+v);return;}$('#cmd').value='';const l=last(),r=a*Math.PI/180,L=inM(n);handlePoint(rnd([l[0]+L*Math.cos(r),l[1]+L*Math.sin(r)]));}
function onCmd(raw){const v=raw.trim();
 if(waitIn){const w=waitIn;if(!v&&w.kind==='room'){waitIn=null;w.fn('Pièce');}else if(!v){waitIn=null;log('Annulé');}else if(w.kind==='text'||w.kind==='room'){waitIn=null;w.fn(v);}else{const n=num(v);if(!isFinite(n)){log('Tape un nombre');return;}waitIn=null;w.fn(n);}
  $('#cmd').blur();updPrompt();draw();return;}
 if(!v){finish();return;}
 const up=v.toUpperCase().normalize('NFD').replace(/[̀-ͯ]/g,'');
 if(ALIAS[up]){act(ALIAS[up]);return;}
 if(up==='F'&&tool==='pline'){closePline();return;}
 if(up==='U'||up==='ANNULER'){undo();return;}
 if(up==='EF'||up==='EFFACER'){eraseSel();return;}
 if(up==='Z'||up==='ZOOM'||up==='TOUT'){zoomExt();return;}
 if(NOCROSS.includes(tool)){log('Commande inconnue : « '+v+' ». Tape AIDE pour la liste.');return;}
 let m;
 if((m=v.match(/^@\s*(-?[\d.,]+)\s*<\s*(-?[\d.,]+)$/))){if(!pts.length){log('Pose d\'abord un premier point');return;}const L=inM(num(m[1])),A=num(m[2])*Math.PI/180,l=last();handlePoint(rnd([l[0]+L*Math.cos(A),l[1]+L*Math.sin(A)]));return;}
 if((m=v.match(/^(@?)\s*(-?[\d.,]+)\s*[;\s]\s*(-?[\d.,]+)$/))){const x=inM(num(m[2])),y=inM(num(m[3])),rel=m[1]==='@';if(!isFinite(x)||!isFinite(y)){log('Coordonnées non comprises');return;}if(rel&&!pts.length){log('Pose d\'abord un premier point');return;}handlePoint(rnd(rel?[last()[0]+x,last()[1]+y]:[x+U()[0],y+U()[1]]));return;}
 if(/^-?\d+([.,]\d+)?$/.test(v)||/^-?[.,]\d+$/.test(v)){typedNumber(num(v));return;}
 log('Entrée non comprise : « '+v+' »');}

/* ---------- vue ---------- */
function extents(){let b=null;for(const e of ents){if(!visible(e))continue;const q=bbox(e);if(!isFinite(q[0]))continue;b=b?[Math.min(b[0],q[0]),Math.min(b[1],q[1]),Math.max(b[2],q[2]),Math.max(b[3],q[3])]:q;}return b;}
function pushView(){vhist.push({s:view.s,ox:view.ox,oy:view.oy});if(vhist.length>30)vhist.shift();}
function zoomTo(b){pushView();const w=Math.max(b[2]-b[0],0.5),h=Math.max(b[3]-b[1],0.5);view.s=clampS(Math.min(W/w,H/h)*0.85);view.ox=W/2-(b[0]+b[2])/2*view.s;view.oy=H/2+(b[1]+b[3])/2*view.s;draw();}
function zoomExt(){const b=extents();if(!b){if(bgImg){zoomBg();return;}view.s=40;view.ox=60;view.oy=H-60;draw();return;}zoomTo(b);}
function zoomBg(){if(bgImg)zoomTo([bgImg.x,bgImg.y,bgImg.x+bgImg.w,bgImg.y+bgImg.h]);}
function zoomAt(X,Y,f){const ns=clampS(view.s*f),wx=(X-view.ox)/view.s,wy=(Y-view.oy)/view.s;view.s=ns;view.ox=X-wx*ns;view.oy=Y-wy*ns;draw();}
function resize(){const r=$('#main').getBoundingClientRect();W=r.width;H=r.height;DPR=Math.max(1,window.devicePixelRatio||1);cv.width=Math.round(W*DPR);cv.height=Math.round(H*DPR);cv.style.width=W+'px';cv.style.height=H+'px';if(!view.init&&W){view.init=true;view.ox=60;view.oy=H-60;}draw();}
function updCoord(p){if(!p)return;const u=U();$('#coord').textContent=(u[0]||u[1]?'SCU · ':'')+'X '+fmtL(p[0]-u[0])+' · Y '+fmtL(p[1]-u[1])+' '+S.unit;}

/* ---------- pointeurs ---------- */
const ptrs=new Map();let gest=null,down=null,gripDrag=null,blockUp=false,bodyDrag=null;
function bodyEnd(){const B=bodyDrag;bodyDrag=null;if(!B||!B.started)return false;FAST=false;CACHE=null;if(typeof BVER!=='undefined')BVER++;after();log(B.list.length===1?entLabel(B.list[0])+' déplacé':B.list.length+' objets déplacés');return true;}
const pos=e=>{const r=cv.getBoundingClientRect();return [e.clientX-r.left,e.clientY-r.top];};
cv.addEventListener('pointerdown',e=>{try{cv.setPointerCapture(e.pointerId);}catch(_){}const [X,Y]=pos(e);ptrs.set(e.pointerId,{X,Y});
 if(e.pointerType!=='mouse'&&document.activeElement===$('#cmd')&&!waitIn)$('#cmd').blur();
 if(ptrs.size===2){bodyEnd();const [p1,p2]=[...ptrs.values()];gest={d:Math.max(1,Math.hypot(p1.X-p2.X,p1.Y-p2.Y)),mx:(p1.X+p2.X)/2,my:(p1.Y+p2.Y)/2,s:view.s,ox:view.ox,oy:view.oy};down=null;boxSel=null;if(gripDrag){gripDrag=null;CACHE=null;after();}blockUp=true;capScene([]);draw();return;}
 if(ptrs.size>2)return;
 const panMode=tool==='pan'||e.button===1||e.button===2;
 down={X,Y,moved:false,pan:panMode,ox:view.ox,oy:view.oy};if(panMode){capScene([]);return;}
 if(tool==='zwin'||tool==='gomme'||(tool==='stretch'&&!tdata))return;
 if(tool==='select'){const g=grips().find(g=>{const s=w2s(g.p);return Math.abs(s[0]-X)<16&&Math.abs(s[1]-Y)<16;});if(g){gripDrag=g;snapshot();capScene([g.e]);return;}
  const hp=s2w(X,Y),h=hitTest(hp,14/view.s);if(h&&(sel.has(h)||!['wall','dim','adim','rdim'].includes(h.t)))bodyDrag={h,p0:hp,started:false};return;}
 cursor=pick(X,Y);updCoord(cursor);draw();});
cv.addEventListener('pointermove',e=>{const [X,Y]=pos(e);if(ptrs.has(e.pointerId))ptrs.set(e.pointerId,{X,Y});
 if(gest&&ptrs.size>=2){const [p1,p2]=[...ptrs.values()];const d=Math.hypot(p1.X-p2.X,p1.Y-p2.Y),mx=(p1.X+p2.X)/2,my=(p1.Y+p2.Y)/2,ns=clampS(gest.s*d/gest.d);
  const wx=(gest.mx-gest.ox)/gest.s,wy=(gest.my-gest.oy)/gest.s;view.s=ns;view.ox=mx-wx*ns;view.oy=my-wy*ns;FAST=true;draw();return;}
 if(blockUp)return;
 if(down){if(Math.hypot(X-down.X,Y-down.Y)>6)down.moved=true;
  if(down.pan){view.ox=down.ox+(X-down.X);view.oy=down.oy+(Y-down.Y);FAST=true;draw();return;}
  if(bodyDrag&&tool==='select'){if(!down.moved)return;const B=bodyDrag;if(!B.started){B.started=true;if(!sel.has(B.h)){sel.clear();sel.add(B.h);}snapshot();B.list=[...sel];B.orig=B.list.map(x=>JSON.stringify(x));FAST=true;padGrip=null;capScene(B.list);}
   const p=s2w(X,Y),st=S.snap?Math.max(0.005,Math.min(0.05,S.padStep||0.01)):0.001,d=[Math.round((p[0]-B.p0[0])/st)*st,Math.round((p[1]-B.p0[1])/st)*st];
   B.list.forEach((x,i)=>{const o=JSON.parse(B.orig[i]);Object.keys(x).forEach(k=>{if(!(k in o))delete x[k];});Object.assign(x,o);translate(x,d);mapPts(x,rnd);});
   if(B.list.length===1&&B.list[0].t==='block'&&S.wallSnap!==false)snapBlock(B.list[0],0.12);updCoord(p);draw();return;}
  if(gripDrag){const p=pick(X,Y);if(gripDrag.i!=null)gripDrag.e.p[gripDrag.i]=p;else gripDrag.e[gripDrag.k]=p;gripDrag.p=p;updCoord(p);draw();return;}
  if(tool==='zwin'||(tool==='stretch'&&!tdata)){if(down.moved){boxSel={x0:down.X,y0:down.Y,x1:X,y1:Y};draw();}return;}
  if(tool==='select'||tool==='gomme'){if(down.moved){boxSel={x0:down.X,y0:down.Y,x1:X,y1:Y};draw();}return;}}
 if(!NOCROSS.includes(tool)&&((e.pointerType==='mouse'&&!padP)||down)){cursor=pick(X,Y);updCoord(cursor);draw();}
 else updCoord(s2w(X,Y));});
function pUp(e){ptrs.delete(e.pointerId);if(!ptrs.size&&CACHE&&!bodyDrag&&!gripDrag){CACHE=null;draw();}if(FAST&&!zA&&!ptrs.size){FAST=false;draw();}
 if(blockUp){if(ptrs.size<2)gest=null;if(ptrs.size===0){blockUp=false;down=null;}return;}
 if(!down)return;const d=down;down=null;if(d.pan)return;
 if(bodyDrag){const was=bodyDrag.started;if(bodyEnd()||was)return;bodyDrag=null;}
 if(gripDrag){CACHE=null;if(gripDrag.e.t==='block'&&gripDrag.k==='p'&&d.moved&&S.wallSnap!==false)snapBlock(gripDrag.e,0.15);padGrip={e:gripDrag.e,k:gripDrag.k,i:gripDrag.i,p:gripDrag.p.slice()};gripDrag=null;snapHit=null;after();return;}
 const [X,Y]=pos(e);
 if(tool==='gomme'){let hit=[];if(boxSel){const a=s2w(boxSel.x0,boxSel.y0),b=s2w(boxSel.x1,boxSel.y1),bx=[Math.min(a[0],b[0]),Math.min(a[1],b[1]),Math.max(a[0],b[0]),Math.max(a[1],b[1])];const cr=boxSel.x1<boxSel.x0;boxSel=null;hit=ents.filter(e=>{if(!visible(e)||locked(e))return false;const q=bbox(e);return cr?!(q[2]<bx[0]||q[0]>bx[2]||q[3]<bx[1]||q[1]>bx[3]):(q[0]>=bx[0]&&q[2]<=bx[2]&&q[1]>=bx[1]&&q[3]<=bx[3]);});}else{const e=hitTest(s2w(X,Y),16/view.s);if(e)hit=[e];}
  if(hit.length){snapshot();const rm=new Set(hit);ents=ents.filter(e=>!rm.has(e));sel.clear();after();log(hit.length+' objet(s) effacé(s) — touche ↶ en haut pour annuler');}else{log('Rien à effacer ici');draw();}return;}
 if(tool==='stretch'&&!tdata){if(boxSel){const a=s2w(boxSel.x0,boxSel.y0),b=s2w(boxSel.x1,boxSel.y1),bx=[Math.min(a[0],b[0]),Math.min(a[1],b[1]),Math.max(a[0],b[0]),Math.max(a[1],b[1])];boxSel=null;const hit=ents.filter(e=>{if(!visible(e)||locked(e))return false;const q=bbox(e);return !(q[2]<bx[0]||q[0]>bx[2]||q[3]<bx[1]||q[1]>bx[3]);});if(!hit.length){log('Aucun objet dans ce cadre');draw();return;}tdata={box:bx};sel=new Set(hit);updPrompt();draw();}return;}
 if(tool==='zwin'){if(boxSel&&Math.abs(boxSel.x1-boxSel.x0)>8&&Math.abs(boxSel.y1-boxSel.y0)>8){const a=s2w(boxSel.x0,boxSel.y0),b=s2w(boxSel.x1,boxSel.y1);boxSel=null;zoomTo([Math.min(a[0],b[0]),Math.min(a[1],b[1]),Math.max(a[0],b[0]),Math.max(a[1],b[1])]);view.s/=0.85;const cx=(a[0]+b[0])/2,cy=(a[1]+b[1])/2;view.ox=W/2-cx*view.s;view.oy=H/2+cy*view.s;}boxSel=null;setTool(prevTool&&prevTool!=='zwin'?prevTool:'select');draw();return;}
 if(tool==='select'){padGrip=null;if(boxSel){selectBox(boxSel);boxSel=null;}else hitSelect(X,Y);refreshProp();updPrompt();draw();return;}
 if(waitIn)return;
 cursor=pick(X,Y);if(S.loupe){padP=cursor;updCoord(cursor);updPrompt();draw();return;}handlePoint(cursor);}
cv.addEventListener('pointerup',pUp);
cv.addEventListener('pointercancel',e=>{ptrs.delete(e.pointerId);if(!ptrs.size){bodyEnd();CACHE=null;FAST=false;down=null;gest=null;blockUp=false;boxSel=null;if(gripDrag){gripDrag=null;after();}draw();}});
cv.addEventListener('pointerleave',e=>{if(e.pointerType==='mouse'&&!down){cursor=null;snapHit=null;draw();}});
cv.addEventListener('wheel',e=>{e.preventDefault();const [X,Y]=pos(e);zoomAt(X,Y,Math.exp(-e.deltaY*0.0015));},{passive:false});
cv.addEventListener('contextmenu',e=>e.preventDefault());

/* ---------- fenêtres ---------- */
function refreshProp(){const w=$('#prop');obarBuild();if(!sel.size||tool!=='select'){w.classList.remove('on');propOpen=false;return;}if(!propOpen){w.classList.remove('on');return;}
 const arr=[...sel],one=arr.length===1?arr[0]:null;
 const row=(l,v)=>'<div class="fr"><label>'+l+'</label><b>'+v+'</b></div>';
 const inp=(l,id,v)=>'<div class="fr"><label>'+l+'</label><input id="'+id+'" value="'+esc(v)+'" inputmode="decimal"></div>';
 let h=row('Objet',one?entLabel(one):arr.length+' objets');if(one&&(one.fl|0)>0)h+=row('Étage',flName(one.fl|0));
 h+='<div class="fr"><label>Calque</label><select id="pLay">'+(arr.every(e=>e.layer===arr[0].layer)?'':'<option selected disabled>(plusieurs)</option>')+layers.map(l=>'<option value="'+esc(l.n)+'" '+(arr.every(e=>e.layer===l.n)?'selected':'')+'>'+esc(l.n)+'</option>').join('')+'</select></div>';
 if(one)switch(one.t){
  case 'line':break;
  case 'wall':h+=inp('Épaisseur (m)','pTh',fmt(one.th))+'<div class="fr"><label>Peinture</label><select id="pPaint"><option value="">Sans peinture</option>'+PAINTS.map(([c,nm])=>'<option value="'+c+'" '+(one.paint===c?'selected':'')+'>'+nm+'</option>').join('')+'</select></div>';break;
  case 'elem':h+=(one.w||one.k!=='limite'?inp('Largeur (m)','pW',fmt(one.w)):'')+(['cloture','haie','rampe'].includes(one.k)?inp('Hauteur (m)','pHz',fmt(one.hz||(one.k==='cloture'?S.clotH:one.k==='haie'?1.2:0.5))):'')+row('Longueur',uL(dist(one.a,one.b)));break;
  case 'door':case 'window':h+=inp('Épaisseur mur (m)','pTh',fmt(one.th));break;
  case 'stair':h+=inp('Largeur (m)','pW',fmt(one.w))+inp('Nombre de marches','pN',one.n);break;
  case 'circle':h+=inp('Rayon (m)','pR',fmt(one.r))+row('Surface',fmt(Math.PI*one.r*one.r)+' m²');break;
  case 'arc':h+=row('Rayon',uL(one.r));break;
  case 'pline':h+=row(one.closed?'Périmètre':'Longueur',uL(perim(one)))+(one.closed?row('Surface',fmt(area(one)+(one.holes||[]).reduce((a,H)=>a-Math.abs(polyArea(H)),0))+' m²'):'');if(one.closed)h+='<div class="fr"><label>Revêtement</label><select id="pMat"><option value="">Aucun</option>'+Object.entries(FLOORM).map(([k,m])=>'<option value="'+k+'" '+(one.mat===k?'selected':'')+'>'+m.n+'</option>').join('')+'</select></div>';break;
  case 'text':h+='<div class="fr"><label>Texte</label><input id="pTx" value="'+esc(String(one.s).replace(/\n/g,' | '))+'"></div>'+inp('Hauteur (m)','pTxH',fmt(one.h));break;
  case 'leader':h+='<div class="fr"><label>Texte</label><input id="pTx" value="'+esc(String(one.s).replace(/\n/g,' | '))+'"></div>';break;
  case 'dim':h+=row('Mesure',uL(dist(one.a,one.b)));break;
  case 'rdim':h+=row(one.dia?'Diamètre':'Rayon',uL(one.dia?2*one.r:one.r));break;
  case 'ellipse':h+=row('Demi-axes',uL(one.rx)+' × '+uL(one.ry))+row('Surface',fmt(Math.PI*one.rx*one.ry)+' m²');break;
  case 'adim':h+=row('Angle',adimGeom(one).txt);break;}
 if(one)h+=coordHTML(one,inp);
 if(one&&one.hatch)h+='<div class="fr"><label>Motif hachures</label><select id="pHp">'+Object.entries(HPAT).map(([k,l])=>'<option value="'+k+'" '+((typeof one.hatch==='string'?one.hatch:'diag')===k?'selected':'')+'>'+l+'</option>').join('')+'</select></div>';
 if(one&&((one.t==='pline'&&one.closed)||one.t==='circle'))h+=inp('Hauteur 3D (m)','pExt',fmt(one.ext||0))+inp('Élévation 3D (m)','pZ',fmt(one.z||0));
 if(one){const cs=cons.filter(c=>c.ids.includes(one.id));if(cs.length)h+=row('Contraintes',cs.map(c=>CNAME[c.t]).join(', '));}
 h+='<div class="brow">';
 if(one&&one.t==='door'&&!one.k)h+='<button class="bt" data-pa="dbl">'+(one.dbl?'Porte simple':'Porte double')+'</button>';
 if(one&&(one.t==='window'&&one.k==='double'||(one.t==='elem'&&ELK[one.k]&&ELK[one.k].side)))h+='<button class="bt" data-pa="flip">Changer de côté</button>';
 if(one&&one.t==='door')h+='<button class="bt" data-pa="flip">Inverser l\'ouverture</button><button class="bt" data-pa="hinge">Changer la charnière</button>';
 if(one&&one.t==='table')h+='<button class="bt p" data-pa="tupd">Mettre à jour</button>';
 if(one&&((one.t==='pline'&&one.closed)||one.t==='circle'))h+='<button class="bt" data-pa="hatch">'+(one.hatch?'Retirer les hachures':'Hachures')+'</button>';
 h+='<button class="bt" data-pa="rot90">Tourner 90°</button><button class="bt" data-pa="move">Déplacer</button><button class="bt" data-pa="copy">Copier</button><button class="bt" data-pa="rotate">Rotation</button><button class="bt" data-pa="mirror">Miroir</button><button class="bt" data-pa="scale">Échelle</button><button class="bt d" data-pa="erase">Effacer</button></div>';
 w.querySelector('.wb').innerHTML=h;w.classList.add('on');
 const on=(id,fn)=>{const x=w.querySelector('#'+id);if(x)x.addEventListener('change',()=>fn(x.value));};
 on('pLay',v=>{snapshot();arr.forEach(e=>e.layer=v);after();});
 on('pTh',v=>{const n=num(v);if(n>0){snapshot();one.th=n;after();}});
 on('pW',v=>{const n=num(v);if(n>0){snapshot();one.w=n;after();}});on('pHz',v=>{const n=num(v);if(n>0){snapshot();one.hz=n;after();}});on('pPaint',v=>{snapshot();if(v)one.paint=v;else delete one.paint;after();});on('pMat',v=>{snapshot();if(v)one.mat=v;else{delete one.mat;delete one.holes;}after();});
 on('pN',v=>{const n=Math.round(num(v));if(n>=1&&n<200){snapshot();one.n=n;after();}});
 on('pR',v=>{const n=num(v);if(n>0){snapshot();one.r=n;after();}});
 on('pTx',v=>{if(v.trim()){snapshot();one.s=one.t==='text'?v.replace(/\s*\|\s*/g,'\n'):v;after();}});
 on('pTxH',v=>{const n=num(v);if(n>0){snapshot();one.h=n;after();}});
 on('pHp',v=>{snapshot();one.hatch=v;after();});on('pExt',v=>{const n=num(v);if(n>=0){snapshot();one.ext=n;one.z=one.z||0;after();}});on('pZ',v=>{const n=num(v);if(isFinite(n)){snapshot();one.z=n;after();}});
 const setPt=(key,i,v)=>{const n=inM(num(v));if(!isFinite(n))return;snapshot();const q=one[key].slice();q[i]=+(n+U()[i]).toFixed(6);one[key]=q;after();};
 on('pAx',v=>setPt('a',0,v));on('pAy',v=>setPt('a',1,v));on('pBx',v=>setPt('b',0,v));on('pBy',v=>setPt('b',1,v));on('pCx',v=>setPt('c',0,v));on('pCy',v=>setPt('c',1,v));on('pPx',v=>setPt('p',0,v));on('pPy',v=>setPt('p',1,v));
 on('pL',v=>{const L=inM(num(v));if(L>0){snapshot();setLen(one,L);after();}});
 on('pAng',v=>{const A=num(v)*Math.PI/180;if(isFinite(A)){snapshot();const L=dist(one.a,one.b);one.b=rnd([one.a[0]+L*Math.cos(A),one.a[1]+L*Math.sin(A)]);after();}});
 w.querySelectorAll('[data-pa]').forEach(b=>b.onclick=()=>{const a=b.dataset.pa;
  if(a==='flip'){snapshot();one.flip=!one.flip;after();}
  else if(a==='hinge'){snapshot();const t=one.a;one.a=one.b;one.b=t;one.flip=!one.flip;after();}
  else if(a==='dbl'){snapshot();one.dbl=!one.dbl;after();}
  else if(a==='hatch'){snapshot();one.hatch=one.hatch?false:(S.hatchPat||'diag');after();}
  else if(a==='tupd'){const rows=roomRows();if(!rows.length){log('Aucune pièce fermée trouvée');return;}snapshot();one.rows=makeTable(one.p,rows).rows;after();log('Tableau mis à jour');}
  else if(a==='rot90'){snapshot();const c=selCenter();sel.forEach(e=>{rotateE(e,c,Math.PI/2);mapPts(e,rnd);});after();}
  else if(a==='erase')eraseSel();else setTool(a);});}
function fillMinis(){const s=$('#laysel');if(s)s.innerHTML=layers.map(l=>'<option value="'+esc(l.n)+'" '+(l.n===curLayer?'selected':'')+'>'+esc(l.n)+'</option>').join('');
 const setv=(id,v)=>{const x=$('#'+id);if(x){x.value=String(v);if(x.value!==String(v)){const o=el('option',null,esc(v));o.value=String(v);x.appendChild(o);x.value=String(v);}}};
 setv('wallT',S.wallT);setv('txtH',S.txtH);setv('unitSel',S.unit);setv('decSel',S.dec);setv('hatchPat',S.hatchPat||'diag');}
function renderLayers(){const b=$('#layw .wb');
 b.innerHTML=layers.map((l,i)=>'<div class="lay '+(l.n===curLayer?'cur':'')+'" data-i="'+i+'"><input type="color" value="'+l.c+'" data-k="c"><span class="nm">'+esc(l.n)+'</span><select class="ls" data-k="lt">'+Object.keys(DASH).map(o=>'<option value="'+o+'" '+((l.lt||'continu')===o?'selected':'')+'>'+LTN[o]+'</option>').join('')+'</select><select class="ls" data-k="lw">'+Object.keys(LWF).map(o=>'<option value="'+o+'" '+((l.lw||'normal')===o?'selected':'')+'>'+LWN[o]+'</option>').join('')+'</select><button data-k="v" title="Afficher ou cacher">'+(l.v?'👁':'🚫')+'</button><button data-k="cur" title="Calque courant">'+(l.n===curLayer?'✔':'○')+'</button>'+(l.n==='0'?'<span style="width:27px"></span>':'<button data-k="del" title="Supprimer">🗑</button>')+'</div>').join('')
 +'<div class="fr"><input id="newLay" placeholder="Nom du nouveau calque"><button class="bt p" id="addLay">Ajouter</button></div><div class="note">Avec le calque « 0 », chaque outil range tout seul son dessin (Murs, Portes, Fenêtres, Escaliers, Cotes, Texte, Mobilier). Choisis un autre calque (✔) pour tout y mettre. Chaque calque a son type de ligne (continu, pointillé, caché, axe) et son épaisseur.</div>';
 b.querySelectorAll('.lay').forEach(r=>{const L=layers[+r.dataset.i];
  r.querySelector('[data-k=c]').addEventListener('input',ev=>{L.c=ev.target.value;save();draw();});
  r.querySelector('[data-k=lt]').addEventListener('change',ev=>{L.lt=ev.target.value;save();draw();});r.querySelector('[data-k=lw]').addEventListener('change',ev=>{L.lw=ev.target.value;save();draw();});
  r.querySelector('[data-k=v]').onclick=()=>{L.v=!L.v;if(!L.v)[...sel].forEach(e=>{if(e.layer===L.n)sel.delete(e);});save();renderLayers();refreshProp();draw();};
  r.querySelector('[data-k=cur]').onclick=()=>{curLayer=L.n;L.v=true;save();fillMinis();renderLayers();draw();};
  const d=r.querySelector('[data-k=del]');if(d)d.onclick=()=>{ask('Supprimer le calque « '+esc(L.n)+' » ? Ses objets passeront dans le calque 0.',[['Annuler'],['Supprimer',()=>{snapshot();ents.forEach(e=>{if(e.layer===L.n)e.layer='0';});layers=layers.filter(x=>x!==L);if(curLayer===L.n)curLayer='0';fillMinis();renderLayers();after();},'d']]);};});
 b.querySelector('#addLay').onclick=()=>{const n=b.querySelector('#newLay').value.trim();if(!n)return;if(layerOf(n)){log('Ce calque existe déjà');return;}layers.push({n,c:'#ffffff',v:true});curLayer=n;save();fillMinis();renderLayers();};}
function quant(){const MF=multiFl(),NF=MF?nFl():Math.max(1,S.floors|0),kf=MF?1:NF,walls=ents.filter(e=>e.t==='wall'),doors=ents.filter(e=>e.t==='door'),wins=ents.filter(e=>e.t==='window'),rooms=ents.filter(e=>e.t==='pline'&&e.closed&&!(e.mat&&FLOORM[e.mat]&&FLOORM[e.mat].ext)),BT=BRICKS[S.brick]||BRICKS.b4020;
 const Lw=walls.reduce((a,w)=>a+dist(w.a,w.b),0)*kf,gross=Lw*S.wallH,op=(doors.reduce((a,d)=>{const z=opZ(d);return a+dist(d.a,d.b)*(z[1]-z[0]);},0)+wins.reduce((a,d)=>{const z=opZ(d);return a+dist(d.a,d.b)*(z[1]-z[0]);},0))*kf,net=Math.max(0,gross-op),nb=Math.ceil(net*BT.per*1.05);
 let bb=null;walls.forEach(w=>{const q=bbox(w);bb=bb?[Math.min(bb[0],q[0]),Math.min(bb[1],q[1]),Math.max(bb[2],q[2]),Math.max(bb[3],q[3])]:q;});
 const slab=bb?(bb[2]-bb[0]+0.6)*(bb[3]-bb[1]+0.6)*NF:0,ov=S.roofOv==null?0.5:S.roofOv,rp=bb?(bb[2]-bb[0]+2*ov)*(bb[3]-bb[1]+2*ov):0,roofA=S.roofType==='plat'?rp:rp/Math.cos((S.roofPitch||25)*Math.PI/180);
 const mA=e=>area(e)-(e.holes||[]).reduce((s2,H)=>s2+Math.abs(polyArea(H)),0),solA=ents.filter(e=>e.t==='pline'&&e.mat&&FLOORM[e.mat]&&!FLOORM[e.mat].ext).reduce((a,e)=>a+mA(e),0)*(MF?1:1),extA=ents.filter(e=>e.t==='pline'&&e.mat&&FLOORM[e.mat]&&FLOORM[e.mat].ext).reduce((a,e)=>a+mA(e),0),peintA=walls.filter(w=>w.paint).reduce((a,w)=>a+dist(w.a,w.b)*S.wallH*2,0)*kf,clo=ents.filter(e=>e.t==='elem'&&e.k==='cloture').reduce((a,e)=>a+dist(e.a,e.b),0),pot=ents.filter(e=>e.t==='block'&&BLOCKS[e.name]&&BLOCKS[e.name].struct).length*kf;
 return {NF,k:kf,walls,doors,wins,rooms,BT,Lw,gross,op,net,nb,slab,roofA,ra:rooms.reduce((a,e)=>a+mA(e),0),solA,extA,peintA,clo,pot};}
function costs(q){const it=[['Blocs',q.nb,'u',S.pBloc,1],['Ciment des murs',Math.ceil(q.net*S.cimM2),'sacs',S.pCiment,1],['Ciment des dalles',Math.ceil(q.slab*S.cimDalle),'sacs',S.pCiment,0],['Portes',q.doors.length*q.k,'u',S.pPorte,2],['Fenêtres',q.wins.length*q.k,'u',S.pFen,2],['Toiture',Math.ceil(q.roofA),'m²',S.pToit,3],['Revêtements de sol',Math.ceil(q.solA+q.extA),'m²',S.pSol,4],['Peinture',Math.ceil(q.peintA),'m²',S.pPeint,4]].map(([n,qt,u,pu,ph])=>({n,qt,u,pu:+pu||0,tot:qt*(+pu||0),ph}));
 const mat=it.reduce((a,x)=>a+x.tot,0),mo=mat*(+S.moPct||0)/100,byPh=[0,0,0,0,0,0];it.forEach(x=>byPh[x.ph]+=x.tot);if(mat>0)byPh.forEach((v,i)=>byPh[i]=v+mo*v/mat);
 return {it,mat,mo,total:mat+mo,byPh};}
const money=v=>S.cur==='CDF'?Math.round(v*(+S.taux||1)).toLocaleString('fr-FR')+' FC':(Math.round(v*100)/100).toLocaleString('fr-FR')+' $';
function renderQuant(){const b=$('#quantw .wb'),q=quant(),C=costs(q);
 const inp=(l,id,v)=>'<div class="fr"><label>'+l+'</label><input id="'+id+'" value="'+v+'" inputmode="decimal"></div>';
 b.innerHTML=inp('Hauteur des murs (m)','qH',fmt(S.wallH))+inp('Hauteur des portes (m)','qD',fmt(S.doorH))+inp('Hauteur des fenêtres (m)','qW',fmt(S.winH))+(q.k===1&&multiFl()?'<div class="fr"><label>Étages dessinés</label><b>'+q.NF+'</b></div><input id="qF" type="hidden" value="1">':inp('Nombre d\'étages','qF',q.NF))
 +'<div class="fr"><label>Type de bloc</label><select id="qB">'+Object.entries(BRICKS).map(([k,v])=>'<option value="'+k+'" '+(k===S.brick?'selected':'')+'>'+v.n+'</option>').join('')+'</select></div>'
 +'<table class="tbl"><tr><td>Murs (tous les étages)</td><td>'+q.walls.length*q.k+'</td></tr><tr><td>Longueur des murs (axe)</td><td>'+fmt(q.Lw)+' m</td></tr><tr><td>Surface brute des murs</td><td>'+fmt(q.gross)+' m²</td></tr>'
 +'<tr><td>Portes / fenêtres</td><td>'+q.doors.length*q.k+' / '+q.wins.length*q.k+'</td></tr><tr><td>Surface des ouvertures</td><td>− '+fmt(q.op)+' m²</td></tr><tr><td>Surface nette à maçonner</td><td>'+fmt(q.net)+' m²</td></tr>'
 +'<tr class="big"><td>'+q.BT.n+' (+5 % de pertes)</td><td>≈ '+q.nb+'</td></tr><tr><td>Dalles (sol et étages)</td><td>'+fmt(q.slab)+' m²</td></tr><tr><td>Toiture</td><td>'+fmt(q.roofA)+' m²</td></tr>'
 +(q.rooms.length?'<tr><td>Pièces fermées dessinées ('+q.rooms.length+')</td><td>'+fmt(q.ra)+' m²</td></tr>':'')+(q.solA?'<tr><td>Sols intérieurs (carrelage…)</td><td>'+fmt(q.solA)+' m²</td></tr>':'')+(q.extA?'<tr><td>Sols extérieurs (pelouse, pavés…)</td><td>'+fmt(q.extA)+' m²</td></tr>':'')+(q.peintA?'<tr><td>Murs peints (2 faces)</td><td>'+fmt(q.peintA)+' m²</td></tr>':'')+(q.pot?'<tr><td>Poteaux</td><td>'+q.pot+'</td></tr>':'')+(q.clo?'<tr><td>Mur de clôture</td><td>'+fmt(q.clo)+' m · '+Math.ceil(q.clo*(S.clotH||2)*q.BT.per*1.05)+' blocs</td></tr>':'')+'</table>'
 +'<h4 style="color:var(--ac);margin-top:6px">Coûts estimés (5D)</h4>'
 +'<div class="fr"><label>Afficher en</label><select id="qCur"><option value="USD">Dollars ($)</option><option value="CDF">Francs congolais (FC)</option></select></div>'+inp('Taux : 1 $ = … FC','qTx',S.taux)
 +inp('Prix d\'un bloc ($)','qPB',S.pBloc)+inp('Prix du sac de ciment ($)','qPC',S.pCiment)+inp('Sacs par m² de mur','qCM',S.cimM2)+inp('Sacs par m² de dalle','qCD',S.cimDalle)+inp('Prix d\'une porte ($)','qPP',S.pPorte)+inp('Prix d\'une fenêtre ($)','qPF',S.pFen)+inp('Toiture, prix du m² ($)','qPT',S.pToit)+inp('Sol posé, prix du m² ($)','qPS',S.pSol)+inp('Peinture, prix du m² ($)','qPPe',S.pPeint)+inp('Main-d\'œuvre (% des matériaux)','qMO',S.moPct)
 +'<table class="tbl">'+C.it.map(x=>'<tr><td>'+x.n+' : '+x.qt+' '+x.u+'</td><td>'+money(x.tot)+'</td></tr>').join('')+'<tr><td>Matériaux</td><td>'+money(C.mat)+'</td></tr><tr><td>Main-d\'œuvre ('+S.moPct+' %)</td><td>'+money(C.mo)+'</td></tr><tr class="big"><td>TOTAL ESTIMÉ</td><td>'+money(C.total)+'</td></tr></table>'
 +'<div class="note">Les prix déjà remplis sont des exemples : remplace-les par les prix de ton marché. Calcul sur l\'axe des murs, sans fondations profondes, crépissage, électricité ni plomberie. Fais toujours vérifier par un maçon avant d\'acheter.</div>';
 const on=(id,k,int)=>{b.querySelector('#'+id).addEventListener('change',ev=>{const n=num(ev.target.value);if(n>=0&&isFinite(n)){S[k]=int?Math.max(1,Math.round(n)):n;save();}renderQuant();});};
 on('qH','wallH');on('qD','doorH');on('qW','winH');on('qF','floors',1);on('qTx','taux');on('qPB','pBloc');on('qPC','pCiment');on('qCM','cimM2');on('qCD','cimDalle');on('qPP','pPorte');on('qPF','pFen');on('qPT','pToit');on('qPS','pSol');on('qPPe','pPeint');on('qMO','moPct');
 b.querySelector('#qB').addEventListener('change',ev=>{S.brick=ev.target.value;save();renderQuant();});
 const cu=b.querySelector('#qCur');cu.value=S.cur;cu.addEventListener('change',()=>{S.cur=cu.value;save();renderQuant();});}
function renderSettings(){const b=$('#setw .wb');const inp=(l,id,v)=>'<div class="fr"><label>'+l+'</label><input id="'+id+'" value="'+v+'" inputmode="decimal"></div>';
 b.innerHTML='<div class="fr"><label>Unité</label><select id="sU"><option value="m">Mètres (m)</option><option value="cm">Centimètres (cm)</option><option value="mm">Millimètres (mm)</option></select></div>'
 +'<div class="fr"><label>Précision affichée</label><select id="sDec"><option value="2">0,01 m (1 cm)</option><option value="3">0,001 m (1 mm)</option><option value="4">0,0001 m (0,1 mm)</option></select></div><div class="fr"><label>Pas de l\'aimant</label><select id="sSS"><option value="0">Automatique (grille)</option><option value="0.001">1 mm</option><option value="0.005">5 mm</option><option value="0.01">1 cm</option><option value="0.05">5 cm</option><option value="0.1">10 cm</option></select></div>'
 +'<div class="fr"><label>Accrochage</label><div class="brow" id="sOsm">'+Object.entries({fin:'Extrémité',milieu:'Milieu',centre:'Centre',quadrant:'Quadrant',proche:'Proche',insertion:'Insertion',intersection:'Intersection',perpendiculaire:'Perpendiculaire',tangente:'Tangente'}).map(([k,l])=>'<label style="min-width:0;color:var(--tx);display:flex;gap:3px;align-items:center"><input type="checkbox" data-o="'+k+'" '+((S.osm||{})[k]!==false?'checked':'')+'>'+l+'</label>').join('')+'</div></div>'
 +'<div class="fr"><label>Rayon d\'accrochage</label><select id="sTol"><option value="10">Petit</option><option value="16">Moyen</option><option value="24">Grand</option><option value="34">Très grand (doigt)</option></select></div>'
 +'<div class="fr"><label>Réticule</label><select id="sCr"><option value="plein">Plein écran</option><option value="petit">Petit</option></select></div>'
 +'<div class="fr"><label>Traits à l\'écran</label><select id="sLw"><option value="0.8">Fins</option><option value="1">Normaux</option><option value="1.5">Épais</option></select></div>'
 +'<div class="fr"><label>Police</label><select id="sF"><option value="sans">Sans empattement</option><option value="serif">Avec empattement</option><option value="mono">Machine à écrire</option></select></div>'
 +'<div class="fr"><label>Extrémités des cotes</label><select id="sAr"><option value="trait">Trait oblique</option><option value="fleche">Flèche</option><option value="point">Point</option></select></div>'
 +inp('Texte des cotes (m)','sDT',fmt(S.dimTxt))
 +inp('Épaisseur des murs (m)','sWT',fmt(S.wallT))+inp('Hauteur du texte (m)','sTH',fmt(S.txtH))+inp('Largeur escalier (m)','sSW',fmt(S.stairW))+inp('Écart des hachures (m)','sHS',fmt(S.hatchSp))+inp('Distance de décalage (m)','sOD',fmt(S.offD))+inp('Hauteur des murs (m)','sWH',fmt(S.wallH))+inp('Hauteur des portes (m)','sDH',fmt(S.doorH))+inp('Hauteur des fenêtres (m)','sWiH',fmt(S.winH))+inp('Allège des fenêtres (m)','sSiH',fmt(S.sillH))
 +'<div class="note">Les points sont toujours gardés au millième de millimètre près. L\'unité et la précision changent l\'affichage des cotes et les longueurs que tu tapes. Les réglages restent gardés dans le téléphone.</div>';
 b.querySelector('#sDec').value=String(S.dec);b.querySelector('#sDec').addEventListener('change',ev=>{S.dec=+ev.target.value;save();fillMinis();updPrompt();refreshProp();draw();});
 b.querySelector('#sSS').value=String(S.snapStep||0);b.querySelector('#sSS').addEventListener('change',ev=>{S.snapStep=+ev.target.value;save();});
 b.querySelectorAll('#sOsm input').forEach(x=>x.addEventListener('change',()=>{S.osm=Object.assign({},S.osm);S.osm[x.dataset.o]=x.checked;save();}));
 const sel2=(id,k,cast)=>{const x=b.querySelector('#'+id);x.value=String(S[k]);x.addEventListener('change',()=>{S[k]=cast?+x.value:x.value;save();draw();});};sel2('sTol','snapTol',1);sel2('sCr','cross');sel2('sLw','lwScr',1);sel2('sF','font');sel2('sAr','arrow');
 b.querySelector('#sU').value=S.unit;b.querySelector('#sU').addEventListener('change',ev=>{S.unit=ev.target.value;save();fillMinis();updPrompt();refreshProp();draw();});
 [['sDT','dimTxt'],['sWT','wallT'],['sTH','txtH'],['sSW','stairW'],['sHS','hatchSp'],['sOD','offD'],['sWH','wallH'],['sDH','doorH'],['sWiH','winH'],['sSiH','sillH']].forEach(([id,k])=>b.querySelector('#'+id).addEventListener('change',ev=>{const n=num(ev.target.value);if(n>0){S[k]=n;save();fillMinis();updPrompt();draw();}}));}
function form(title,fields,onOK){const w=$('#dlg');w.querySelector('.wh').firstChild.textContent=title;const b=w.querySelector('.wb');
 b.innerHTML=fields.map(([l,id,v])=>'<div class="fr"><label>'+l+'</label><input id="'+id+'" value="'+esc(v)+'" inputmode="decimal"></div>').join('')+'<div class="brow" style="justify-content:flex-end"><button class="bt" id="fCancel">Annuler</button><button class="bt p" id="fOk">OK</button></div>';
 w.classList.add('on');b.querySelector('#fCancel').onclick=()=>w.classList.remove('on');
 b.querySelector('#fOk').onclick=()=>{const v={};fields.forEach(([,id])=>v[id]=num(b.querySelector('#'+id).value));w.classList.remove('on');onOK(v);};}
function ask(msg,btns){const w=$('#dlg');w.querySelector('.wh').firstChild.textContent='Lushi Plan';w.querySelector('.wb').innerHTML='<div style="line-height:1.45">'+msg+'</div><div class="brow" style="justify-content:flex-end"></div>';const row=w.querySelector('.brow');
 btns.forEach(([t,fn,cls])=>{const b=el('button','bt'+(cls?' '+cls:''),t);b.onclick=()=>{w.classList.remove('on');if(fn)fn();};row.appendChild(b);});w.classList.add('on');}

/* ---------- fichiers ---------- */

/* ---------- Mes plans : bibliothèque dans le téléphone + enregistrement natif (APK) ---------- */
const CAP=()=>{try{return window.Capacitor&&window.Capacitor.isNativePlatform&&window.Capacitor.isNativePlatform()?(window.Capacitor.Plugins||{}):null;}catch(e){return null;}};
let LIBDB=null;
function libDB(){if(LIBDB)return Promise.resolve(LIBDB);return new Promise((res,rej)=>{let r;try{r=indexedDB.open('lushiplan_lib',1);}catch(e){rej(e);return;}r.onupgradeneeded=()=>{r.result.createObjectStore('plans',{keyPath:'name'});};r.onsuccess=()=>{LIBDB=r.result;res(LIBDB);};r.onerror=()=>rej(r.error);});}
function libTx(mode,fn){return libDB().then(db=>new Promise((res,rej)=>{const t=db.transaction('plans',mode),st=t.objectStore('plans');let out;const q=fn(st);if(q)q.onsuccess=()=>{out=q.result;};t.oncomplete=()=>res(out);t.onerror=()=>rej(t.error);t.onabort=()=>rej(t.error);}));}
const libPut=(name,data,n)=>libTx('readwrite',st=>st.put({name,data,n,date:Date.now()}));
const libAll=()=>libTx('readonly',st=>st.getAll()).then(a=>(a||[]).sort((x,y)=>y.date-x.date));
const libGet=name=>libTx('readonly',st=>st.get(name));
const libDel=name=>libTx('readwrite',st=>st.delete(name));
async function blobB64(b){const u=new Uint8Array(await b.arrayBuffer());let s='';for(let i=0;i<u.length;i+=0x8000)s+=String.fromCharCode.apply(null,u.subarray(i,i+0x8000));return btoa(s);}
async function nativeShare(name,blob){const P=CAP();if(!P||!P.Filesystem||!P.Share)return false;try{const r=await P.Filesystem.writeFile({path:name,data:await blobB64(blob),directory:'CACHE'});await P.Share.share({title:name,files:[r.uri],dialogTitle:'Envoyer ou garder « '+name+' »'});return true;}catch(e){return !!(e&&/cancel/i.test(e.message||''));}}
async function nativeSave(name,blob){const P=CAP();if(!P||!P.Filesystem){log('Pour enregistrer dans le téléphone, mets à jour l\'APK (nouvelle version). Le plan reste dans « Mes plans ».');return;}
 try{await P.Filesystem.writeFile({path:'LushiPlan/'+name,data:await blobB64(blob),directory:'DOCUMENTS',recursive:true});log('✓ Enregistré dans le téléphone : Documents › LushiPlan › '+name);}
 catch(e){if(!(await nativeShare(name,blob)))log('Le téléphone refuse d\'écrire dans Documents : '+(e&&e.message||e));}}
function openLib(){const w=$('#libw'),b=w.querySelector('.wb');w.classList.add('on');b.innerHTML='<div class="note">Chargement…</div>';
 libAll().then(list=>{const fd=t=>new Date(t).toLocaleString('fr-FR',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'});
  b.innerHTML='<div class="brow"><button class="bt p" id="libSave">💾 Enregistrer le plan actuel</button><button class="bt" id="libFile">📂 Fichier du téléphone</button></div>'
  +(list.length?list.map((x,i)=>'<div class="fr" style="align-items:center;gap:6px"><div style="flex:1;min-width:0"><b>'+esc(x.name)+'</b><div class="note" style="margin:0">'+fd(x.date)+(x.n?' · '+x.n+' objets':'')+'</div></div><button class="bt p" data-lo="'+i+'">Ouvrir</button><button class="bt" data-ls="'+i+'">↗</button><button class="bt d" data-ld="'+i+'">🗑</button></div>').join(''):'<div class="note">Aucun plan enregistré pour le moment. Touche « Enregistrer le plan actuel ».</div>')
  +'<div class="note">Les plans enregistrés restent ici, dans l\'application. ↗ envoie le fichier (WhatsApp, Drive…).</div>';
  b.querySelector('#libSave').onclick=()=>{saveFile().then(openLib);};b.querySelector('#libFile').onclick=()=>{w.classList.remove('on');$('#fileIn').click();};
  b.querySelectorAll('[data-lo]').forEach(x=>x.onclick=()=>{const it=list[+x.dataset.lo];try{const d=JSON.parse(it.data);loadList(d.ents,it.name+'.lplan',d.layers,d.bg,d.cons,d.views,d.ublocks);w.classList.remove('on');}catch(e){log('Plan illisible : '+(e&&e.message||e));}});
  b.querySelectorAll('[data-ls]').forEach(x=>x.onclick=()=>{const it=list[+x.dataset.ls];const bl=new Blob([it.data],{type:'application/json'});if(CAP())nativeShare(it.name+'.lplan',bl).then(ok=>{if(!ok)nativeSave(it.name+'.lplan',bl);});else download(it.name+'.lplan',bl,'application/json');});
  b.querySelectorAll('[data-ld]').forEach(x=>x.onclick=()=>{const it=list[+x.dataset.ld];ask('Effacer le plan « '+esc(it.name)+' » de Mes plans ?',[['Annuler'],['Effacer',()=>{libDel(it.name).then(openLib);},'d']]);});
 }).catch(e=>{b.innerHTML='<div class="note">Mes plans indisponible ici ('+esc(String(e&&e.message||e))+'). Utilise « Fichier du téléphone ».</div><div class="brow"><button class="bt" id="libFile">📂 Fichier du téléphone</button></div>';b.querySelector('#libFile').onclick=()=>{w.classList.remove('on');$('#fileIn').click();};});}
function download(name,data,type){const blob=data instanceof Blob?data:new Blob([data],{type});if(CAP()){nativeSave(name,blob);return;}const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},2000);}
const safeName=()=>($('#fname').value.trim()||'plan').replace(/[\\/:*?"<>|]+/g,'_');
const docJSON=()=>JSON.stringify({app:'LushiPlan',v:4,ents,cons,views,ublocks,layers,bg:bgImg});
async function saveFile(){save();const nm=safeName(),js=docJSON();let inLib=false;try{await libPut(nm,js,ents.length);inLib=true;}catch(e){}
 if(CAP()){log(inLib?'✓ « '+nm+' » enregistré dans Mes plans':'Enregistrement…');await nativeSave(nm+'.lplan',new Blob([js],{type:'application/json'}));}
 else{download(nm+'.lplan',js,'application/json');log((inLib?'✓ « '+nm+' » enregistré dans Mes plans et ':'Plan ')+'téléchargé : '+nm+'.lplan');}}
function toDXF(){const o=['0','SECTION','2','ENTITIES'];
 const lay=n=>String(n||'0').normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^A-Za-z0-9_-]/g,'_');const f=v=>(+v).toFixed(6);
 const L=(a,b,y)=>o.push('0','LINE','8',y,'10',f(a[0]),'20',f(a[1]),'30','0','11',f(b[0]),'21',f(b[1]),'31','0');
 const C=(c,r,y)=>o.push('0','CIRCLE','8',y,'10',f(c[0]),'20',f(c[1]),'30','0','40',f(r));
 const A=(c,r,a0,a1,y)=>o.push('0','ARC','8',y,'10',f(c[0]),'20',f(c[1]),'30','0','40',f(r),'50',f(deg(norm(a0))),'51',f(deg(norm(a1))));
 const T=(p,h,s,rot,y,center)=>{o.push('0','TEXT','8',y,'10',f(p[0]),'20',f(p[1]),'30','0','40',f(h),'1',String(s).replace(/[\r\n]+/g,' '),'50',f(deg(rot||0)));if(center)o.push('72','1','73','2','11',f(p[0]),'21',f(p[1]),'31','0');};
 const ex=e=>{const y=lay(e.layer);switch(e.t){
  case 'line':L(e.a,e.b,y);break;
  case 'pline':segsOf(e).forEach(s=>L(s[0],s[1],y));break;
  case 'circle':C(e.c,e.r,y);break;
  case 'arc':A(e.c,e.r,e.a0,e.a1,y);break;
  case 'wall':{const P=wallPoly(e);for(let i=0;i<4;i++)L(P[i],P[(i+1)%4],y);break;}
  case 'door':case 'window':{const g=openPrims(e);if(!g)break;g.l.forEach(s=>L(s[0],s[1],y));if(g.arc)A(g.arc[0],g.arc[1],g.arc[2],g.arc[3],y);if(g.arc2)A(g.arc2[0],g.arc2[1],g.arc2[2],g.arc2[3],y);break;}
  case 'elem':{const Q=elemPoly(e);if(!Q)break;if(!e.w){L(e.a,e.b,y);break;}for(let i=0;i<4;i++)L(Q[i],Q[(i+1)%4],y);break;}
  case 'stair':{const g=stairGeom(e);if(!g)break;for(let i=0;i<4;i++)L(g.C[i],g.C[(i+1)%4],y);g.steps.forEach(s=>L(s[0],s[1],y));g.arrow.forEach(s=>L(s[0],s[1],y));break;}
  case 'block':{if(String(e.name).startsWith('u:')){userBlockEnts(e).forEach(ex);break;}const g=blockPrims(e);g.l.forEach(s=>L(s[0],s[1],y));g.c.forEach(([c,r])=>C(c,r,y));break;}
  case 'leader':{const g=leaderGeom(e);L(e.a,e.b,y);L(e.b,g.land,y);L(g.head[0],g.head[1],y);L(g.head[0],g.head[2],y);L(g.head[1],g.head[2],y);T(g.dir>0?g.tp:[g.land[0],g.tp[1]],g.h,e.s,0,y);break;}
  case 'rdim':{const g=rdimGeom(e);L(g.q2||e.c,e.p,y);if(g.head2){L(g.head2[0],g.head2[1],y);L(g.head2[0],g.head2[2],y);}L(g.head[0],g.head[1],y);L(g.head[0],g.head[2],y);T(g.right?e.p:[e.p[0]-g.txt.length*g.h*0.6,e.p[1]],g.h,g.txt,0,y);break;}
  case 'dim':{const g=dimGeom(e);if(!g)break;const {ux,uy,nx,ny,sg,A:P1,B:P2,h}=g,gap=Math.min(Math.abs(g.d),0.03),ext=h*0.4,t=h*0.3;
   L([e.a[0]+nx*sg*gap,e.a[1]+ny*sg*gap],[P1[0]+nx*sg*ext,P1[1]+ny*sg*ext],y);L([e.b[0]+nx*sg*gap,e.b[1]+ny*sg*gap],[P2[0]+nx*sg*ext,P2[1]+ny*sg*ext],y);
   L([P1[0]-ux*ext,P1[1]-uy*ext],[P2[0]+ux*ext,P2[1]+uy*ext],y);const tx=(ux+nx)*t*0.7071,ty=(uy+ny)*t*0.7071;L([P1[0]-tx,P1[1]-ty],[P1[0]+tx,P1[1]+ty],y);L([P2[0]-tx,P2[1]-ty],[P2[0]+tx,P2[1]+ty],y);
   let ang=Math.atan2(uy,ux);if(ang>Math.PI/2+1e-6||ang<=-Math.PI/2+1e-6)ang+=Math.PI;T(g.T,h,fmtL(g.L),ang,y,true);break;}
  case 'ellipse':case 'spline':segsOf(e).forEach(sg=>L(sg[0],sg[1],y));break;
  case 'adim':{const g=adimGeom(e);A(e.c,g.r,g.s,g.t,y);for(const a of [g.s,g.t])L([e.c[0]+Math.cos(a)*g.r*0.85,e.c[1]+Math.sin(a)*g.r*0.85],[e.c[0]+Math.cos(a)*(g.r+g.h*0.4),e.c[1]+Math.sin(a)*(g.r+g.h*0.4)],y);T(g.T,g.h,g.txt,0,y,true);break;}
  case 'table':{const g=tableGeom(e);g.lines.forEach(l=>L(l[0],l[1],y));g.cells.forEach(t=>T([t.p[0],t.p[1]-e.h*0.5],e.h,t.s,0,y));break;}
  case 'text':{String(e.s).split('\n').forEach((t,i)=>T([e.p[0]+Math.sin(e.rot||0)*i*e.h*1.3,e.p[1]-Math.cos(e.rot||0)*i*e.h*1.3],e.h,t,e.rot,y));break;}}};
 ents.forEach(ex);
 o.push('0','ENDSEC','0','EOF');return o.join('\r\n')+'\r\n';}
function parseDXF(txt){const Ls=txt.split(/\r?\n/),pr=[];for(let j=0;j+1<Ls.length;j+=2)pr.push([Ls[j].trim(),Ls[j+1].trim()]);
 const out=[];let cur=null,section='';
 const flush=()=>{if(!cur)return;const g=cur.g,la=cur.layer||'0',n=k=>parseFloat(g[k]);
  switch(cur.type){
  case 'LINE':out.push({t:'line',a:[n('10'),n('20')],b:[n('11'),n('21')],layer:la});break;
  case 'CIRCLE':out.push({t:'circle',c:[n('10'),n('20')],r:n('40'),layer:la});break;
  case 'ARC':out.push({t:'arc',c:[n('10'),n('20')],r:n('40'),a0:n('50')*Math.PI/180,a1:n('51')*Math.PI/180,layer:la});break;
  case 'TEXT':case 'MTEXT':out.push({t:'text',p:[n('10'),n('20')],s:String(g['1']||'').replace(/\\P/g,' ').replace(/[{}]/g,''),h:n('40')||0.2,rot:(n('50')||0)*Math.PI/180,layer:la});break;
  case 'LWPOLYLINE':if(cur.vx.length>1)out.push({t:'pline',p:cur.vx,closed:(parseInt(g['70']||'0',10)&1)===1,layer:la});break;}
  cur=null;};
 for(let j=0;j<pr.length;j++){const [c,v]=pr[j];
  if(c==='0'){flush();if(v==='SECTION'){section=pr[j+1]?pr[j+1][1]:'';continue;}if(section==='ENTITIES'&&['LINE','CIRCLE','ARC','TEXT','MTEXT','LWPOLYLINE'].includes(v))cur={type:v,g:{},vx:[]};continue;}
  if(!cur)continue;
  if(c==='8')cur.layer=v;else if(cur.type==='LWPOLYLINE'&&c==='10')cur.vx.push([parseFloat(v),0]);else if(cur.type==='LWPOLYLINE'&&c==='20'){if(cur.vx.length)cur.vx[cur.vx.length-1][1]=parseFloat(v);}else if(!(c in cur.g))cur.g[c]=v;}
 flush();
 const ok=x=>Array.isArray(x)?x.every(ok):(typeof x!=='number'||isFinite(x));
 return out.filter(e=>Object.values(e).every(ok));}
function renderImage(Wp,Hp){const c2=document.createElement('canvas');c2.width=Wp;c2.height=Hp;const g=c2.getContext('2d');g.fillStyle='#fff';g.fillRect(0,0,Wp,Hp);
 const m=Math.round(Wp*0.04),tb=Math.round(Hp*0.07),bb=extents();
 if(bb){const w=Math.max(bb[2]-bb[0],0.5),h=Math.max(bb[3]-bb[1],0.5),aw=Wp-2*m,ah=Hp-2*m-tb;const k=Math.min(aw/w,ah/h);
  const ox=m+(aw-w*k)/2-bb[0]*k,oy=m+(ah-h*k)/2+bb[3]*k;const tf=p=>[p[0]*k+ox,-p[1]*k+oy];
  renderScene(g,tf,k,{print:true,lw:Math.max(1.5,Wp/1300),bg:'#fff',wallFill:'#d6d6d6',minTxt:0});}
 const y0=Hp-m/2-tb;g.strokeStyle='#000';g.lineWidth=2;g.strokeRect(m/2,m/2,Wp-m,Hp-m);g.beginPath();g.moveTo(m/2,y0);g.lineTo(Wp-m/2,y0);g.stroke();
 g.fillStyle='#000';g.textBaseline='middle';g.font='bold '+Math.round(tb*0.38)+'px '+FONT();g.fillText($('#fname').value||'Plan',m,y0+tb/2);
 g.font=Math.round(tb*0.26)+'px '+FONT();g.textAlign='right';g.fillText('Lushi Plan · '+new Date().toLocaleDateString('fr-FR')+' · cotes en '+({m:'mètres',cm:'centimètres',mm:'millimètres'})[S.unit],Wp-m,y0+tb/2);g.textAlign='left';return c2;}
function niceLen(x){const p=Math.pow(10,Math.floor(Math.log10(Math.max(x,1e-9))));for(const m of [1,2,5,10])if(m*p>=x)return m*p;return 10*p;}
function renderSheet(dpi){const PS=({A4:[297,210],A3:[420,297]})[S.paper]||[297,210],pm=dpi/25.4,Wp=Math.round(PS[0]*pm),Hp=Math.round(PS[1]*pm),c2=document.createElement('canvas');c2.width=Wp;c2.height=Hp;const r=renderSheetTo(c2.getContext('2d'),Wp,Hp,pm);r.c=c2;return r;}
function renderPdf(){const PS=({A4:[297,210],A3:[420,297]})[S.paper]||[297,210],pm=72/25.4,Wp=PS[0]*pm,Hp=PS[1]*pm,g=PdfCtx(Wp,Hp),r=renderSheetTo(g,Wp,Hp,pm);r.blob=g.build();return r;}
function render3DImage(w,h){const c=document.createElement('canvas');c.width=w;c.height=h;const keep=JSON.stringify(V3);V3.d4=false;V3.yaw=-Math.PI/4;V3.pitch=0.55;fit3D();render3D(c.getContext('2d'),w,h);Object.assign(V3,JSON.parse(keep));return c;}
function renderSheetTo(g,Wp,Hp,pm){g.fillStyle='#fff';g.fillRect(0,0,Wp,Hp);
 const m=10*pm,cH=30*pm,cW=Math.min(160*pm,Wp-2*m),ax=m+4*pm,ay=m+4*pm,awAll=Wp-2*m-8*pm,ah=Hp-2*m-cH-14*pm,has3=!!S.p3d&&ents.some(e=>e.t==='wall'),aw=has3?awAll*0.62:awAll;
 const bb=extents();let warn='',den=0;
 if(bb){const w=Math.max(bb[2]-bb[0],0.1),h=Math.max(bb[3]-bb[1],0.1);let k;
  if(S.pscale==='fit'){k=Math.min(aw/w,ah/h);den=1000*pm/k;}
  else{den=Number(S.pscale)||100;k=1000*pm/den;if(w*k>aw+1||h*k>ah+1)warn='Le plan ne tient pas à 1/'+den+' sur '+S.paper+' : choisis A3 ou l\'échelle 1/'+(den*2)+'.';}
  const ox=ax+(aw-w*k)/2-bb[0]*k,oy=ay+(ah-h*k)/2+bb[3]*k,tf=p=>[p[0]*k+ox,-p[1]*k+oy];
  g.save();g.beginPath();g.rect(ax,ay,aw,ah);g.clip();renderScene(g,tf,k,{print:true,lw:Math.max(0.6,0.25*pm),bg:'#fff',wallFill:'#cfcfcf',minTxt:0});g.restore();
  const bl=niceLen((aw/6)/k),bpx=bl*k,bx=ax+2*pm,by=ay+ah+8*pm;g.fillStyle='#000';g.strokeStyle='#000';g.lineWidth=Math.max(0.5,0.3*pm);g.setLineDash([]);
  for(let i=0;i<4;i+=2)g.fillRect(bx+i*bpx/4,by-1.5*pm,bpx/4,1.5*pm);g.strokeRect(bx,by-1.5*pm,bpx,1.5*pm);
  g.font=Math.round(2.6*pm)+'px '+FONT();g.textBaseline='bottom';g.textAlign='left';g.fillText('0',bx,by-2*pm);g.textAlign='right';g.fillText(fmtL(bl)+' '+S.unit,bx+bpx,by-2*pm);g.textAlign='left';}
 if(has3){const bx=ax+awAll*0.65,bw=awAll*0.35,bh=Math.min(ah,bw*0.72),img=render3DImage(900,Math.max(200,Math.round(900*bh/bw)));g.drawImage(img,bx,ay,bw,bh);g.strokeStyle='#000';g.lineWidth=Math.max(0.5,0.3*pm);g.strokeRect(bx,ay,bw,bh);g.fillStyle='#000';g.font='bold '+Math.round(3*pm)+'px '+FONT();g.textBaseline='top';g.textAlign='left';g.fillText('VUE 3D',bx,ay+bh+2*pm);}
 g.strokeStyle='#000';g.lineWidth=Math.max(1,0.5*pm);g.strokeRect(m,m,Wp-2*m,Hp-2*m);
 const cx=Wp-m-cW,cy=Hp-m-cH,rh=cH/4,cw1=cW*0.64;g.lineWidth=Math.max(0.6,0.35*pm);g.strokeRect(cx,cy,cW,cH);g.beginPath();g.moveTo(cx+cw1,cy);g.lineTo(cx+cw1,cy+cH);for(let i=1;i<4;i++){g.moveTo(cx,cy+i*rh);g.lineTo(cx+cW,cy+i*rh);}g.stroke();
 const sc=S.pscale==='fit'?(den?'env. 1/'+Math.round(den):'—'):'1/'+den,L1=[['PROJET',S.proj||'—'],['PLAN',$('#fname').value||'Plan'],['DESSINATEUR',S.author||'—'],['CLIENT / LIEU',S.client||'—']],L2=[['ÉCHELLE',sc],['DATE',new Date().toLocaleDateString('fr-FR')],['FORMAT',S.paper+' paysage'],['LOGICIEL','Lushi Plan']];
 const cell=(x,y,w,l,v)=>{g.save();g.beginPath();g.rect(x,y,w,rh);g.clip();g.fillStyle='#000';g.textAlign='left';g.textBaseline='top';g.font='bold '+Math.round(1.9*pm)+'px '+FONT();g.fillText(l,x+1.5*pm,y+1*pm);g.textBaseline='bottom';g.font=Math.round(3*pm)+'px '+FONT();g.fillText(v,x+1.5*pm,y+rh-0.8*pm);g.restore();};
 L1.forEach((r,i)=>cell(cx,cy+i*rh,cw1,r[0],r[1]));L2.forEach((r,i)=>cell(cx+cw1,cy+i*rh,cW-cw1,r[0],r[1]));
 return {warn,sc};}
function PdfCtx(Wpt,Hpt){const ops=[],imgs=[],stack=[],AL={},mctx=document.createElement('canvas').getContext('2d');let st={sc:'0 0 0',fc:'0 0 0',lw:1,dash:[],fs:10,bold:false,font:'10px sans-serif',ta:'left',tb:'alphabetic',lc:0,lj:0,ss:'#000',fs2:'#000'},path='',open=false,sx=0,sy=0;
 const f=v=>{const r=Math.round(v*1000)/1000;return Object.is(r,-0)?'0':String(r);};
 const col=c=>{c=String(c||'#000').trim();let r=0,g=0,b=0,m;if(c[0]==='#'){if(c.length===4){r=parseInt(c[1]+c[1],16);g=parseInt(c[2]+c[2],16);b=parseInt(c[3]+c[3],16);}else{r=parseInt(c.substr(1,2),16);g=parseInt(c.substr(3,2),16);b=parseInt(c.substr(5,2),16);}}else if((m=c.match(/rgba?\(([^)]+)\)/))){const p=m[1].split(',').map(parseFloat);r=p[0];g=p[1];b=p[2];}return f(r/255)+' '+f(g/255)+' '+f(b/255);};
 const MAP={'€':128,'’':146,'‘':145,'“':147,'”':148,'–':150,'—':151,'•':149,'…':133,'œ':156,'Œ':140};
 const enc=t=>{let o='';for(const ch of String(t)){let k=ch.charCodeAt(0);if(MAP[ch])k=MAP[ch];else if(k>255)k=63;if(k===40||k===41||k===92)o+='\\'+String.fromCharCode(k);else if(k<32||k>126)o+='\\'+k.toString(8).padStart(3,'0');else o+=String.fromCharCode(k);}return o;};
 const gs=()=>'['+st.dash.map(f).join(' ')+'] 0 d '+f(st.lw)+' w '+st.lc+' J '+st.lj+' j';
 const C={
  get strokeStyle(){return st.ss;},set strokeStyle(v){st.ss=v;st.sc=col(v);},
  get fillStyle(){return st.fs2;},set fillStyle(v){st.fs2=v;st.fc=col(v);},
  get lineWidth(){return st.lw;},set lineWidth(v){st.lw=+v||1;},
  get lineCap(){return 'butt';},set lineCap(v){st.lc=v==='round'?1:v==='square'?2:0;},
  get lineJoin(){return 'miter';},set lineJoin(v){st.lj=v==='round'?1:v==='bevel'?2:0;},
  get globalAlpha(){return st.ga==null?1:st.ga;},set globalAlpha(v){v=Math.round(Math.max(0,Math.min(1,+v||0))*100)/100;st.ga=v;let nm=AL[v];if(!nm){nm='GA'+(Object.keys(AL).length+1);AL[v]=nm;}ops.push('/'+nm+' gs');},
  get font(){return st.font;},set font(v){st.font=v;const mm=/(\d+(?:\.\d+)?)px/.exec(v);st.fs=mm?+mm[1]:10;st.bold=/bold/.test(v);},
  get textAlign(){return st.ta;},set textAlign(v){st.ta=v;},get textBaseline(){return st.tb;},set textBaseline(v){st.tb=v;},
  setLineDash(d){st.dash=(d||[]).slice();},
  save(){stack.push(JSON.stringify(st));ops.push('q');},restore(){if(stack.length)st=JSON.parse(stack.pop());ops.push('Q');},
  translate(x,y){ops.push('1 0 0 1 '+f(x)+' '+f(y)+' cm');},
  rotate(a){const c=Math.cos(a),s2=Math.sin(a);ops.push(f(c)+' '+f(s2)+' '+f(-s2)+' '+f(c)+' 0 0 cm');},
  setTransform(){},
  beginPath(){path='';open=false;},
  moveTo(x,y){path+=f(x)+' '+f(y)+' m ';sx=x;sy=y;open=true;},
  lineTo(x,y){if(!open){this.moveTo(x,y);return;}path+=f(x)+' '+f(y)+' l ';},
  closePath(){if(open)path+='h ';},
  rect(x,y,w,h){path+=f(x)+' '+f(y)+' '+f(w)+' '+f(h)+' re ';open=false;},
  arc(x,y,r,a0,a1,acw){const T=2*Math.PI;let sw;if(acw){sw=a0-a1;sw=sw>=T?T:((sw%T)+T)%T;sw=-sw;}else{sw=a1-a0;sw=sw>=T?T:((sw%T)+T)%T;}
   const n=Math.max(1,Math.ceil(Math.abs(sw)/(Math.PI/2))),d=sw/n,px=x+r*Math.cos(a0),py=y+r*Math.sin(a0);if(open)this.lineTo(px,py);else this.moveTo(px,py);
   for(let i=0;i<n;i++){const t0=a0+i*d,t1=t0+d,kk=4/3*Math.tan(d/4),x0=x+r*Math.cos(t0),y0=y+r*Math.sin(t0),x3=x+r*Math.cos(t1),y3=y+r*Math.sin(t1);path+=f(x0-kk*r*Math.sin(t0))+' '+f(y0+kk*r*Math.cos(t0))+' '+f(x3+kk*r*Math.sin(t1))+' '+f(y3-kk*r*Math.cos(t1))+' '+f(x3)+' '+f(y3)+' c ';}},
  ellipse(x,y,rx,ry,rot,a0,a1){const N=60,c=Math.cos(rot),s2=Math.sin(rot);for(let i=0;i<=N;i++){const t=a0+(a1-a0)*i/N,ex=rx*Math.cos(t),ey=ry*Math.sin(t),X=x+ex*c-ey*s2,Y=y+ex*s2+ey*c;if(i===0&&!open)this.moveTo(X,Y);else this.lineTo(X,Y);}},
  stroke(){if(path)ops.push(st.sc+' RG '+gs()+' '+path+'S');},
  fill(r){if(path)ops.push(st.fc+' rg '+path+(r==='evenodd'?'f*':'f'));},
  clip(r){if(path)ops.push(path+(r==='evenodd'?'W* n':'W n'));},
  fillRect(x,y,w,h){ops.push(st.fc+' rg '+f(x)+' '+f(y)+' '+f(w)+' '+f(h)+' re f');},
  strokeRect(x,y,w,h){ops.push(st.sc+' RG '+gs()+' '+f(x)+' '+f(y)+' '+f(w)+' '+f(h)+' re S');},
  measureText(t){mctx.font=st.font;return mctx.measureText(t);},
  fillText(t,x,y){t=String(t);mctx.font=st.font;const w=mctx.measureText(t).width;let X=x,Y=y;if(st.ta==='center')X-=w/2;else if(st.ta==='right'||st.ta==='end')X-=w;
   if(st.tb==='middle')Y+=st.fs*0.35;else if(st.tb==='top'||st.tb==='hanging')Y+=st.fs*0.78;else if(st.tb==='bottom')Y-=st.fs*0.22;
   ops.push('BT '+st.fc+' rg /'+(st.bold?'F2':'F1')+' '+f(st.fs)+' Tf 1 0 0 -1 '+f(X)+' '+f(Y)+' Tm ('+enc(t)+') Tj ET');},
  drawImage(im,x,y,w,h){const d=im.toDataURL('image/jpeg',0.85),bs=atob(d.split(',')[1]),u=new Uint8Array(bs.length);for(let i=0;i<bs.length;i++)u[i]=bs.charCodeAt(i);imgs.push({u,w:im.width,h:im.height});ops.push('q '+f(w)+' 0 0 '+f(-h)+' '+f(x)+' '+f(y+h)+' cm /Im'+imgs.length+' Do Q');},
  createLinearGradient(){return {addColorStop(){}};}};
 C.build=()=>{const te=new TextEncoder(),parts=[],offs=[];let len=0;const push=x=>{const u=typeof x==='string'?te.encode(x):x;parts.push(u);len+=u.length;};
  const obj=(i,body)=>{offs[i]=len;push(i+' 0 obj\n'+body+'\nendobj\n');};
  push('%PDF-1.4\n');push(new Uint8Array([37,226,227,207,211,10]));
  const alv=Object.keys(AL),g0=6,n0=6+alv.length,gsRefs=alv.map((v,i)=>'/'+AL[v]+' '+(g0+i+1)+' 0 R').join(' '),imgRefs=imgs.map((im,i)=>'/Im'+(i+1)+' '+(n0+i+1)+' 0 R').join(' ');
  obj(1,'<< /Type /Catalog /Pages 2 0 R >>');obj(2,'<< /Type /Pages /Kids [3 0 R] /Count 1 >>');
  obj(3,'<< /Type /Page /Parent 2 0 R /MediaBox [0 0 '+f(Wpt)+' '+f(Hpt)+'] /Contents 4 0 R /Resources << /Font << /F1 5 0 R /F2 6 0 R >> /XObject << '+imgRefs+' >> /ExtGState << '+gsRefs+' >> >> >>');
  const cb=te.encode('1 0 0 -1 0 '+f(Hpt)+' cm\n'+ops.join('\n'));offs[4]=len;push('4 0 obj\n<< /Length '+cb.length+' >>\nstream\n');push(cb);push('\nendstream\nendobj\n');
  obj(5,'<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>');obj(6,'<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>');alv.forEach((v,i)=>obj(g0+i+1,'<< /Type /ExtGState /ca '+v+' /CA '+v+' >>'));
  imgs.forEach((im,i)=>{const k=n0+i+1;offs[k]=len;push(k+' 0 obj\n<< /Type /XObject /Subtype /Image /Width '+im.w+' /Height '+im.h+' /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length '+im.u.length+' >>\nstream\n');push(im.u);push('\nendstream\nendobj\n');});
  const N=n0+imgs.length,xr=len;let x='xref\n0 '+(N+1)+'\n0000000000 65535 f \n';for(let i=1;i<=N;i++)x+=String(offs[i]).padStart(10,'0')+' 00000 n \n';push(x+'trailer\n<< /Size '+(N+1)+' /Root 1 0 R >>\nstartxref\n'+xr+'\n%%EOF\n');
  return new Blob(parts,{type:'application/pdf'});};
 return C;}
function openPrint(){const w=$('#printw'),b=w.querySelector('.wb');w.classList.add('on');
 const t=(l,id,v)=>'<div class="fr"><label>'+l+'</label><input id="'+id+'" value="'+esc(v)+'"></div>';
 b.innerHTML=t('Projet','prProj',S.proj)+t('Dessinateur','prAut',S.author)+t('Client / lieu','prCli',S.client)
 +'<div class="fr"><label>Papier</label><select id="prPap"><option value="A4">A4 paysage</option><option value="A3">A3 paysage</option></select></div>'
 +'<div class="fr"><label>Échelle</label><select id="prSc"><option value="fit">Ajuster à la page</option><option value="20">1/20</option><option value="50">1/50</option><option value="100">1/100</option><option value="200">1/200</option><option value="500">1/500</option></select></div>'
 +'<label style="display:flex;gap:6px;align-items:center"><input type="checkbox" id="pr3d">Ajouter la vue 3D sur la feuille (présentation)</label><div class="note" id="prWarn"></div><img id="prImg" alt="Aperçu"><div class="brow"><button class="bt p" id="prPdf">PDF en traits</button><button class="bt" id="prGo">Imprimer</button><button class="bt" id="prPng">Image</button></div>'
 +'<div class="note">Dans la fenêtre d\'impression, choisis « Taille réelle » ou 100 % pour que l\'échelle soit exacte. La barre d\'échelle sur la feuille permet de vérifier.</div>';
 b.querySelector('#prPap').value=S.paper;b.querySelector('#prSc').value=S.pscale;
 const prev=()=>{const r=renderSheet(60);b.querySelector('#prImg').src=r.c.toDataURL('image/png');b.querySelector('#prWarn').textContent=r.warn||('Échelle : '+r.sc);b.querySelector('#prWarn').style.color=r.warn?'#ff8a8d':'';};
 [['prProj','proj'],['prAut','author'],['prCli','client'],['prPap','paper'],['prSc','pscale']].forEach(([id,k])=>b.querySelector('#'+id).addEventListener('change',ev=>{S[k]=ev.target.value;save();prev();}));
 b.querySelector('#prGo').onclick=doPrint;b.querySelector('#prPdf').onclick=()=>act('pdfv');{const c3b=b.querySelector('#pr3d');c3b.checked=!!S.p3d;c3b.addEventListener('change',()=>{S.p3d=c3b.checked;save();prev();});}b.querySelector('#prPng').onclick=()=>act('png');prev();}
function doPrint(){if(!ents.length){log('Le plan est vide');return;}const r=renderSheet(200);if(r.warn)log(r.warn);let ps=$('#pageStyle');if(!ps){ps=el('style');ps.id='pageStyle';document.head.appendChild(ps);}
 ps.textContent='@media print{@page{size:'+S.paper+' landscape;margin:0}#printArea img{width:100%;height:auto;display:block}}';
 const img=new Image();img.onload=()=>{setTimeout(()=>{try{window.print();}catch(e){log('Impression impossible ici : utilise « Image »');}},150);};img.src=r.c.toDataURL('image/png');const pa=$('#printArea');pa.innerHTML='';pa.appendChild(img);}
async function share(kind){if(!ents.length){log('Le plan est vide');return;}try{let file;
 if(kind==='img'){const b=await new Promise(r=>renderSheet(150).c.toBlob(r));file=new File([b],safeName()+'.png',{type:'image/png'});}
 else file=new File([docJSON()],safeName()+'.lplan',{type:'application/json'});
 if(CAP()){if(!(await nativeShare(file.name,file)))nativeSave(file.name,file);return;}
 if(navigator.canShare&&navigator.canShare({files:[file]})){await navigator.share({files:[file],title:$('#fname').value});log('Plan partagé');}
 else{download(file.name,file,file.type);log('Partage direct impossible ici : le fichier est téléchargé, envoie-le par WhatsApp');}}
 catch(e){if(!e||e.name!=='AbortError')log('Partage impossible : '+(e&&e.message||''));}}
function printPlan(){if(!ents.length){log('Le plan est vide');return;}const img=new Image();img.onload=()=>{setTimeout(()=>{try{window.print();}catch(e){log('Impression impossible ici : utilise « Image »');}},150);};img.src=renderImage(2400,1700).toDataURL('image/png');const pa=$('#printArea');pa.innerHTML='';pa.appendChild(img);log('Choisis « Enregistrer en PDF » dans la fenêtre d\'impression');}

