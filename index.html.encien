 wc:{n:'WC',g:[['r',0,.5,.4,.2],['c',.2,.27,.2]]},
 sink:{n:'Lavabo',g:[['r',0,0,.6,.45],['c',.3,.2,.15],['c',.3,.38,.02]]},
 shower:{n:'Douche',g:[['r',0,0,.9,.9],['l',0,0,.9,.9],['l',0,.9,.9,0],['c',.45,.45,.05]]},
 bath:{n:'Baignoire',g:[['r',0,0,.75,1.7],['r',.08,.08,.59,1.54],['c',.375,1.5,.04]]},
