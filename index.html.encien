 for(let i=0;i<n1;i++)eL.st.push([rq(0,i*t,1,t),(i+1)/NL]);eL.st.push([rq(0,F1,1,1),(n1+1)/NL]);for(let j=0;j<n1;j++)eL.st.push([rq(1+j*t,F1,t,1),(n1+2+j)/NL]);
 const eU={g:[R(0,0,1,F1),R(0,F1,2.1,1),R(1.1,0,1,F1)],st:[]};
 for(let i=1;i<n1;i++)eU.g.push(L(0,i*t,1,i*t),L(1.1,i*t,2.1,i*t));
 eU.g.push(L(.5,.15,.5,F1+.5),L(.5,F1+.5,1.6,F1+.5),L(1.6,F1+.5,1.6,.15),L(1.6,.15,1.48,.35),L(1.6,.15,1.72,.35));
 for(let i=0;i<n1;i++)eU.st.push([rq(0,i*t,1,t),(i+1)/NL]);eU.st.push([rq(0,F1,2.1,1),(n1+1)/NL]);for(let j=0;j<n1;j++)eU.st.push([rq(1.1,F1-(j+1)*t,1,t),(n1+2+j)/NL]);
 const sp={g:[C(0,0,.9),C(0,0,.1)],st:[]},ns=12;
 for(let i=0;i<ns;i++){const a=i/ns*2*Math.PI,b=(i+1)/ns*2*Math.PI;sp.g.push(L(.1*Math.cos(a),.1*Math.sin(a),.9*Math.cos(a),.9*Math.sin(a)));const Q=[[.1*Math.cos(a),.1*Math.sin(a)]];for(let k=0;k<=3;k++){const u=a+(b-a)*k/3;Q.push([.9*Math.cos(u),.9*Math.sin(u)]);}Q.push([.1*Math.cos(b),.1*Math.sin(b)]);sp.st.push([Q,(i+1)/(ns+1)]);}
