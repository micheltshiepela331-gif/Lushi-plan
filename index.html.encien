const ELK={poutre:{n:'Poutre',w:0.2,lay:'Structure'},semelle:{n:'Semelle filante',w:0.6,lay:'Structure'},cloture:{n:'Mur de clôture',w:0.15,lay:'Extérieur'},limite:{n:'Limite de parcelle',w:0,lay:'Extérieur'},garde:{n:'Garde-corps',w:0.05,lay:'Escaliers'},rampe:{n:'Rampe d\'accès',w:1.2,lay:'Escaliers',two:true},ptrav:{n:'Plan de travail',w:0.6,lay:'Mobilier',side:true},haie:{n:'Haie',w:0.6,lay:'Jardin'},allee:{n:'Allée',w:1.0,lay:'Jardin'}};
const OPK={door:['door',{}],door2:['door',{dbl:true}],dcoul:['door',{k:'coul'}],garage:['door',{k:'garage'}],portail:['door',{k:'portail',dbl:true}],pvitree:['door',{k:'vitree'}],passage:['door',{k:'pass'}],window:['window',{}],win2:['window',{k:'double'}],wcoul:['window',{k:'coul'}],baie:['window',{k:'baie'}],vitre:['window',{k:'vitre'}]};
const OPN={door:'Porte',door2:'Porte double',dcoul:'Porte coulissante',garage:'Porte de garage',portail:'Portail',pvitree:'Porte vitrée',passage:'Baie libre',window:'Fenêtre',win2:'Fenêtre à 2 battants',wcoul:'Fenêtre coulissante',baie:'Baie vitrée',vitre:'Vitrage fixe'};
const OPKN={door:{coul:'Porte coulissante',garage:'Porte de garage',portail:'Portail',vitree:'Porte vitrée',pass:'Baie libre'},window:{double:'Fenêtre 2 battants',coul:'Fenêtre coulissante',baie:'Baie vitrée',vitre:'Vitrage fixe'}};
const FLOORM={carrelage:{n:'Carrelage',c:[214,196,160],p:'grid',s:0.4},gcarreau:{n:'Grand carreau',c:[232,226,214],p:'grid',s:0.6},marbre:{n:'Marbre',c:[236,236,240],p:'grid',s:0.8},parquet:{n:'Parquet',c:[176,128,84],p:'plank',s:0.15},beton:{n:'Béton ciré',c:[192,192,186],p:'none',s:1},pelouse:{n:'Pelouse',c:[96,170,76],p:'grass',s:0.25,ext:true},paves:{n:'Pavés',c:[172,150,128],p:'brick',s:0.2,ext:true},gravier:{n:'Gravier',c:[196,190,174],p:'dots',s:0.12,ext:true},terrasse:{n:'Terrasse bois',c:[150,108,72],p:'plank',s:0.14,ext:true}};
const STEPS6=[['Fondation','implantation et fondation'],['Murs','murs, poteaux, clôture'],['Ouvertures','portes et fenêtres'],['Étages et toit','escaliers, étages, toiture'],['Finitions','sols, peinture, électricité, plomberie'],['Design','meubles et jardin']];
const curStep=()=>S.step==null?1:Math.max(0,Math.min(5,S.step|0));
function phaseOf(e){switch(e.t){case 'wall':return 1;case 'door':case 'window':return 2;case 'stair':return 3;
 case 'elem':{const v={limite:0,semelle:0,cloture:1,poutre:1,garde:3,rampe:3,ptrav:5,haie:5,allee:5}[e.k];return v==null?-1:v;}
 case 'block':{if(String(e.name).startsWith('u:'))return 5;const B=BLOCKS[e.name]||{};if(e.name==='semelle')return 0;if(B.struct)return 1;if(B.st)return 3;if(B.lay==='Réseaux')return 4;return 5;}
 case 'pline':return e.mat?(FLOORM[e.mat]&&FLOORM[e.mat].ext?5:4):-1;
 case 'text':return e.room?4:-1;}return -1;}
function toolPhase(t){if(OPK[t])return 2;if(t==='wall')return 1;if(t==='stair')return 3;if(t.startsWith('el_')){const v={limite:0,semelle:0,cloture:1,poutre:1,garde:3,rampe:3,ptrav:5,haie:5,allee:5}[t.slice(3)];return v==null?null:v;}
 if(t==='block')return String(S.blockName).startsWith('u:')?5:phaseOf({t:'block',name:S.blockName});if(t==='sol')return FLOORM[S.solMat]&&FLOORM[S.solMat].ext?5:4;if(t==='paint'||t==='piece')return 4;return null;}
let ALLOWLOCK=false;const locked=e=>{if(ALLOWLOCK)return false;const ph=phaseOf(e);if(ph>=0&&ph!==curStep())return true;if(ARR&&ph>=0&&!arrRoomOf(e))return true;return false;};
const PAINTS=[['#ffffff','Blanc'],['#f3ead2','Crème'],['#e8d6b0','Beige'],['#f6d65a','Jaune'],['#f2a65a','Orange'],['#c8553d','Brique'],['#e8a0b4','Rose'],['#9fd3f0','Bleu ciel'],['#3f7cc4','Bleu'],['#9fd8c2','Vert d\'eau'],['#5aa85a','Vert'],['#b9bcc0','Gris'],['#4a4f57','Anthracite'],['#8a5a3c','Marron']];
const ROOMN=['Salon','Chambre','Cuisine','Salle à manger','Douche','WC','Salle de bain','Bureau','Couloir','Garage','Terrasse','Véranda','Magasin','Buanderie'];
const BRICKS={b4020:{n:'Bloc ciment 40 × 20 cm',per:12.5},b5025:{n:'Bloc 50 × 25 cm',per:8},br2211:{n:'Brique 22 × 11 cm',per:36}};

/* ---------- géométrie ---------- */
const dist=(a,b)=>Math.hypot(b[0]-a[0],b[1]-a[1]);
const mid=(a,b)=>[(a[0]+b[0])/2,(a[1]+b[1])/2];
const last=()=>pts[pts.length-1];
const w2s=p=>[p[0]*view.s+view.ox,-p[1]*view.s+view.oy];
const s2w=(X,Y)=>[(X-view.ox)/view.s,-(Y-view.oy)/view.s];
const norm=a=>{a%=2*Math.PI;return a<0?a+2*Math.PI:a;};
const fmt=v=>(Math.round(v*100)/100).toFixed(2);
function fmtL(v){const u=S.unit||'m',x=v*UF[u],d=Math.max(0,(S.dec||2)-({m:0,cm:2,mm:3})[u]);return x.toFixed(d);}
const uL=v=>fmtL(v)+' '+S.unit;
const inM=n=>n/UF[S.unit||'m'];
const rnd=p=>p.map(v=>+(+v).toFixed(6));
const deg=r=>r*180/Math.PI;
const num=s=>parseFloat(String(s).replace(',','.'));
const clampS=s=>Math.min(20000,Math.max(0.05,s));
function segDist(p,a,b){const dx=b[0]-a[0],dy=b[1]-a[1],l2=dx*dx+dy*dy;let t=l2?((p[0]-a[0])*dx+(p[1]-a[1])*dy)/l2:0;t=Math.max(0,Math.min(1,t));const q=[a[0]+t*dx,a[1]+t*dy];return [Math.hypot(p[0]-q[0],p[1]-q[1]),q];}
function arc3(p1,p2,p3){const [ax,ay]=p1,[bx,by]=p2,[cx,cy]=p3;const d=2*(ax*(by-cy)+bx*(cy-ay)+cx*(ay-by));if(Math.abs(d)<1e-12)return null;
 const ux=((ax*ax+ay*ay)*(by-cy)+(bx*bx+by*by)*(cy-ay)+(cx*cx+cy*cy)*(ay-by))/d;
 const uy=((ax*ax+ay*ay)*(cx-bx)+(bx*bx+by*by)*(ax-cx)+(cx*cx+cy*cy)*(bx-ax))/d;
 const r=Math.hypot(ax-ux,ay-uy);const a1=Math.atan2(ay-uy,ax-ux),a2=Math.atan2(by-uy,bx-ux),a3=Math.atan2(cy-uy,cx-ux);
 return norm(a2-a1)<norm(a3-a1)?{t:'arc',c:[ux,uy],r,a0:a1,a1:a3}:{t:'arc',c:[ux,uy],r,a0:a3,a1:a1};}
const arcEnd=(e,i)=>{const a=i?e.a1:e.a0;return [e.c[0]+e.r*Math.cos(a),e.c[1]+e.r*Math.sin(a)];};
const near=(a,b)=>Math.abs(a[0]-b[0])<1e-6&&Math.abs(a[1]-b[1])<1e-6;
function pointInPoly(p,P){let ins=false;for(let i=0,j=P.length-1;i<P.length;j=i++){const [xi,yi]=P[i],[xj,yj]=P[j];if(((yi>p[1])!==(yj>p[1]))&&(p[0]<(xj-xi)*(p[1]-yi)/(yj-yi)+xi))ins=!ins;}return ins;}
function polyArea(P){let s=0;for(let i=0;i<P.length;i++){const a=P[i],b=P[(i+1)%P.length];s+=a[0]*b[1]-b[0]*a[1];}return s/2;}
function centroid(P){const A=polyArea(P);if(Math.abs(A)<1e-12){let x=0,y=0;P.forEach(p=>{x+=p[0];y+=p[1];});return [x/P.length,y/P.length];}let cx=0,cy=0;for(let i=0;i<P.length;i++){const a=P[i],b=P[(i+1)%P.length],f=a[0]*b[1]-b[0]*a[1];cx+=(a[0]+b[0])*f;cy+=(a[1]+b[1])*f;}return [cx/(6*A),cy/(6*A)];}
function lineInt(l1,l2){const [a,b]=l1,[c,d]=l2,r=[b[0]-a[0],b[1]-a[1]],s=[d[0]-c[0],d[1]-c[1]],den=r[0]*s[1]-r[1]*s[0];if(Math.abs(den)<1e-12)return null;const t=((c[0]-a[0])*s[1]-(c[1]-a[1])*s[0])/den;return [a[0]+t*r[0],a[1]+t*r[1]];}
function wallJoined(w,p){for(const o of ents)if(o!==w&&o.t==='wall'&&(near(o.a,p)||near(o.b,p)))return true;return false;}
function wallPoly(w,noExt){let [ax,ay]=w.a,[bx,by]=w.b;const dx=bx-ax,dy=by-ay,L=Math.hypot(dx,dy)||1e-9,ux=dx/L,uy=dy/L,nx=-uy,ny=ux,h=w.th/2;
 if(!noExt){const ea=wallJoined(w,w.a)?h:0,eb=wallJoined(w,w.b)?h:0;ax-=ux*ea;ay-=uy*ea;bx+=ux*eb;by+=uy*eb;}
 return [[ax+nx*h,ay+ny*h],[bx+nx*h,by+ny*h],[bx-nx*h,by-ny*h],[ax-nx*h,ay-ny*h]];}
function segsOf(e){switch(e.t){case 'ellipse':case 'spline':{const P=curvePts(e),s=[];for(let i=0;i<P.length-1;i++)s.push([P[i],P[i+1]]);return s;}case 'line':case 'wall':case 'door':case 'window':case 'stair':case 'leader':case 'elem':return [[e.a,e.b]];
 case 'pline':{const s=[];for(let i=0;i<e.p.length-1;i++)s.push([e.p[i],e.p[i+1]]);if(e.closed&&e.p.length>2)s.push([e.p[e.p.length-1],e.p[0]]);return s;}}return [];}
function curvePts(e){if(e.t==='ellipse'){const n=72,out=[],co=Math.cos(e.rot||0),si=Math.sin(e.rot||0);for(let i=0;i<=n;i++){const a=i/n*2*Math.PI,x=e.rx*Math.cos(a),y=e.ry*Math.sin(a);out.push([e.c[0]+x*co-y*si,e.c[1]+x*si+y*co]);}return out;}
 if(e.t==='spline'){const P=e.p;if(P.length<3)return P.slice();const out=[],g=i=>P[Math.max(0,Math.min(P.length-1,i))];
  for(let i=0;i<P.length-1;i++){const p0=g(i-1),p1=g(i),p2=g(i+1),p3=g(i+2);for(let s=0;s<12;s++){const t=s/12,t2=t*t,t3=t2*t,f=j=>0.5*((2*p1[j])+(-p0[j]+p2[j])*t+(2*p0[j]-5*p1[j]+4*p2[j]-p3[j])*t2+(-p0[j]+3*p1[j]-3*p2[j]+p3[j])*t3);out.push([f(0),f(1)]);}}
  out.push(P[P.length-1]);return out;}return [];}
function projT(p,a,b){const dx=b[0]-a[0],dy=b[1]-a[1],l2=dx*dx+dy*dy;return l2?((p[0]-a[0])*dx+(p[1]-a[1])*dy)/l2:0;}
const lerp=(a,b,t)=>rnd([a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t]);
function segLineDist(p,a,b){const L=dist(a,b)||1;return Math.abs((b[0]-a[0])*(p[1]-a[1])-(b[1]-a[1])*(p[0]-a[0]))/L;}
function adimGeom(e){const r=Math.max(dist(e.c,e.o),1e-6),a1=Math.atan2(e.p1[1]-e.c[1],e.p1[0]-e.c[0]),a2=Math.atan2(e.p2[1]-e.c[1],e.p2[0]-e.c[0]),ao=Math.atan2(e.o[1]-e.c[1],e.o[0]-e.c[0]);
 let s=a1,t=a2;if(norm(ao-a1)>norm(a2-a1)){s=a2;t=a1;}const sw=norm(t-s),m=s+sw/2,h=e.h||0.15;
 return {r,s,t,sw,h,txt:deg(sw).toFixed(Math.max(1,(S.dec||2)-1))+'°',T:[e.c[0]+(r+h*0.9)*Math.cos(m),e.c[1]+(r+h*0.9)*Math.sin(m)]};}
function tableGeom(e){const h=e.h||0.2,nc=e.head.length,cw=[];for(let j=0;j<nc;j++){let m=String(e.head[j]).length;e.rows.forEach(r=>{m=Math.max(m,String(r[j]==null?'':r[j]).length);});cw.push(m*h*0.62+h*1.2);}
 const rh=h*1.9,Wt=cw.reduce((a,b)=>a+b,0),n=e.rows.length+2,Ht=rh*n,[x0,y0]=e.p,lines=[],cells=[];
 for(let i=0;i<=n;i++)lines.push([[x0,y0-i*rh],[x0+Wt,y0-i*rh]]);lines.push([[x0,y0],[x0,y0-Ht]]);lines.push([[x0+Wt,y0],[x0+Wt,y0-Ht]]);
 let x=x0;cw.forEach((w,j)=>{if(j)lines.push([[x,y0-rh],[x,y0-Ht]]);x+=w;});
 cells.push({s:e.title,p:[x0+h*0.6,y0-rh/2],b:true});x=x0;
 cw.forEach((w,j)=>{cells.push({s:String(e.head[j]),p:[x+h*0.6,y0-rh*1.5],b:true});e.rows.forEach((r,i)=>cells.push({s:String(r[j]==null?'':r[j]),p:[x+h*0.6,y0-rh*(2.5+i)],b:i===e.rows.length-1}));x+=w;});
 return {lines,cells,w:Wt,h:Ht};}
function perim(e){let s=0;for(const [a,b] of segsOf(e))s+=dist(a,b);return s;}
const area=e=>Math.abs(polyArea(e.p));
function dimGeom(e){const [ax,ay]=e.a,[bx,by]=e.b,L=Math.hypot(bx-ax,by-ay);if(L<1e-9)return null;const ux=(bx-ax)/L,uy=(by-ay)/L,nx=-uy,ny=ux;
 const d=(e.o[0]-ax)*nx+(e.o[1]-ay)*ny,sg=d>=0?1:-1,h=e.h||0.15;
 return {L,ux,uy,nx,ny,d,sg,h,A:[ax+nx*d,ay+ny*d],B:[bx+nx*d,by+ny*d],T:[(ax+bx)/2+nx*(d+sg*h*0.9),(ay+by)/2+ny*(d+sg*h*0.9)]};}
function openPrims(e){const [ax,ay]=e.a,[bx,by]=e.b,L=Math.hypot(bx-ax,by-ay);if(L<1e-9)return null;const ux=(bx-ax)/L,uy=(by-ay)/L,nx=-uy,ny=ux,h=e.th/2;
 const l=[[[ax+nx*h,ay+ny*h],[ax-nx*h,ay-ny*h]],[[bx+nx*h,by+ny*h],[bx-nx*h,by-ny*h]]];let arc=null;
 let arc2=null;const K=e.k;if(K==='coul'||K==='baie'){const g=Math.max(h*0.35,0.012),m=L/2+0.05;l.push([[ax+nx*g,ay+ny*g],[ax+ux*m+nx*g,ay+uy*m+ny*g]]);l.push([[bx-nx*g,by-ny*g],[bx-ux*m-nx*g,by-uy*m-ny*g]]);if(K==='baie'){const g2=g*0.4;l.push([[ax+nx*g2,ay+ny*g2],[ax+ux*m+nx*g2,ay+uy*m+ny*g2]]);l.push([[bx-nx*g2,by-ny*g2],[bx-ux*m-nx*g2,by-uy*m-ny*g2]]);}}
 else if(K==='garage'){const f=e.flip?-1:1,dd=Math.min(L*0.8,2.5);l.push([[ax,ay],[bx,by]]);l.push([[ax-nx*h*f,ay-ny*h*f],[bx-nx*h*f,by-ny*h*f]]);l.push([[ax+nx*h*f,ay+ny*h*f],[ax+nx*f*(h+dd),ay+ny*f*(h+dd)]]);l.push([[bx+nx*h*f,by+ny*h*f],[bx+nx*f*(h+dd),by+ny*f*(h+dd)]]);}
 else if(K==='pass'){}
 else if(e.t==='door'||K==='double'){const f=e.flip?-1:1,au=Math.atan2(uy,ux);if(K==='double'){const gg=Math.min(h*0.3,0.03);for(const o of [h,-h,gg,-gg])l.push([[ax+nx*o,ay+ny*o],[bx+nx*o,by+ny*o]]);}if(e.dbl||K==='double'){const R=L/2;l.push([[ax,ay],[ax+nx*f*R,ay+ny*f*R]]);l.push([[bx,by],[bx+nx*f*R,by+ny*f*R]]);arc=f>0?[e.a,R,au,au+Math.PI/2]:[e.a,R,au-Math.PI/2,au];arc2=f>0?[e.b,R,au+Math.PI/2,au+Math.PI]:[e.b,R,au+Math.PI,au+1.5*Math.PI];}else{l.push([[ax,ay],[ax+nx*f*L,ay+ny*f*L]]);arc=f>0?[e.a,L,au,au+Math.PI/2]:[e.a,L,au-Math.PI/2,au];if(K==='vitree'){const q=[ax+nx*f*L,ay+ny*f*L],o2=0.05;l.push([[ax+ux*o2,ay+uy*o2],[q[0]+ux*o2,q[1]+uy*o2]]);}}}
 else{const g=Math.min(h*0.3,0.03);if(K==='vitre')l.push([[ax,ay],[bx,by]]);for(const o of [h,-h,g,-g])l.push([[ax+nx*o,ay+ny*o],[bx+nx*o,by+ny*o]]);}
 return {l,arc,arc2,L,ux,uy,nx,ny,h};}
function elemPoly(e){const [ax,ay]=e.a,[bx,by]=e.b,L=Math.hypot(bx-ax,by-ay);if(L<1e-9)return null;const ux=(bx-ax)/L,uy=(by-ay)/L,nx=-uy,ny=ux,K=ELK[e.k]||{},w=e.w||0,f=e.flip?-1:1;let o0=-w/2,o1=w/2;if(K.side){o0=0;o1=w*f;}
 return [[ax+nx*o0,ay+ny*o0],[bx+nx*o0,by+ny*o0],[bx+nx*o1,by+ny*o1],[ax+nx*o1,ay+ny*o1]];}
function mkElem(k,a,b){const e={t:'elem',k,a,b,w:ELK[k].w};if(ELK[k].side){const L=dist(a,b);if(L>1e-9){const m=mid(a,b),q=[m[0]-(b[1]-a[1])/L*0.03,m[1]+(b[0]-a[0])/L*0.03];if(ents.some(w=>w.t==='wall'&&visible(w)&&pointInPoly(q,wallPoly(w))))e.flip=true;}}return e;}
function mkOpen(tl,a,b){const d=OPK[tl]||OPK.door,w=ents.find(x=>(x.t==='wall'||(x.t==='elem'&&x.k==='cloture'))&&visible(x)&&segDist(a,x.a,x.b)[0]<(x.th||x.w)/2+1e-3);return Object.assign({t:d[0],a,b,th:w?(w.th||w.w):S.wallT,flip:false},d[1]);}
function opZ(o){const Hh=S.wallH;if(o.t==='door')return [0,(o.k==='garage'||o.k==='portail')?Math.min(Hh-0.1,2.4):S.doorH];if(o.k==='baie')return [0,S.doorH];if(o.k==='vitre')return [0,Math.max(S.doorH,Hh-0.3)];return [S.sillH,S.sillH+S.winH];}
function entLabel(e){if(e.t==='block')return blkName(e.name);if(e.t==='elem')return (ELK[e.k]||{n:'Élément'}).n;if((e.t==='door'||e.t==='window')&&e.k&&OPKN[e.t][e.k])return OPKN[e.t][e.k];if(e.t==='door'&&e.dbl)return 'Porte double';if(e.t==='pline'&&e.mat&&FLOORM[e.mat])return 'Sol : '+FLOORM[e.mat].n;if(e.t==='text'&&e.room)return 'Nom de pièce';return NAMES[e.t];}
function stairGeom(e){const [ax,ay]=e.a,[bx,by]=e.b,L=Math.hypot(bx-ax,by-ay);if(L<1e-9)return null;const ux=(bx-ax)/L,uy=(by-ay)/L,nx=-uy,ny=ux,hw=e.w/2,n=Math.max(1,e.n|0);
 const C=[[ax+nx*hw,ay+ny*hw],[bx+nx*hw,by+ny*hw],[bx-nx*hw,by-ny*hw],[ax-nx*hw,ay-ny*hw]];const steps=[];
 for(let i=1;i<n;i++){const t=L*i/n,px=ax+ux*t,py=ay+uy*t;steps.push([[px+nx*hw,py+ny*hw],[px-nx*hw,py-ny*hw]]);}
 const al=Math.min(0.3,L*0.2),aw=Math.min(0.15,hw*0.5),bs=[bx-ux*al,by-uy*al];
 return {C,steps,arrow:[[e.a,e.b],[e.b,[bs[0]+nx*aw,bs[1]+ny*aw]],[e.b,[bs[0]-nx*aw,bs[1]-ny*aw]]]};}
function blockPrims(e){const B=BLOCKS[e.name],out={l:[],c:[],st:[]};if(!B)return out;const co=Math.cos(e.rot||0),si=Math.sin(e.rot||0),s=e.sc||1,m=e.m||1;
 const T=(x,y)=>{x*=m*s*(e.sx||1);y*=s*(e.sy||1);return [e.p[0]+x*co-y*si,e.p[1]+x*si+y*co];};
 for(const g of B.g){if(g[0]==='r'){const [,x,y,w,h]=g,P=[T(x,y),T(x+w,y),T(x+w,y+h),T(x,y+h)];for(let i=0;i<4;i++)out.l.push([P[i],P[(i+1)%4]]);}
  else if(g[0]==='l')out.l.push([T(g[1],g[2]),T(g[3],g[4])]);else if(g[0]==='c')out.c.push([T(g[1],g[2]),g[3]*s*Math.min(e.sx||1,e.sy||1)]);}
 if(B.st)out.st=B.st.map(([Q,f])=>[Q.map(q=>T(q[0],q[1])),f]);out.T=T;
 return out;}
function leaderGeom(e){const [ax,ay]=e.a,[bx,by]=e.b,h=e.h||0.2,dir=bx>=ax?1:-1,L=Math.hypot(ax-bx,ay-by)||1e-9,ux=(ax-bx)/L,uy=(ay-by)/L,al=Math.min(h*0.8,L*0.4),aw=al*0.35,bs=[ax-ux*al,ay-uy*al];
 return {dir,h,head:[[ax,ay],[bs[0]-uy*aw,bs[1]+ux*aw],[bs[0]+uy*aw,bs[1]-ux*aw]],land:[bx+dir*(String(e.s).length*h*0.62+h*0.4),by],tp:[bx+dir*h*0.2,by+h*0.25]};}
function rdimGeom(e){const [cx,cy]=e.c,L=Math.hypot(e.p[0]-cx,e.p[1]-cy)||1e-9,ux=(e.p[0]-cx)/L,uy=(e.p[1]-cy)/L,q=[cx+ux*e.r,cy+uy*e.r],h=e.h||0.15,al=Math.min(h*0.8,e.r*0.5),aw=al*0.35,bs=[q[0]-ux*al,q[1]-uy*al];
 const q2=e.dia?[cx-ux*e.r,cy-uy*e.r]:null,b2=q2?[q2[0]+ux*al,q2[1]+uy*al]:null;return {q,q2,h,head:[q,[bs[0]-uy*aw,bs[1]+ux*aw],[bs[0]+uy*aw,bs[1]-ux*aw]],head2:q2?[q2,[b2[0]-uy*aw,b2[1]+ux*aw],[b2[0]+uy*aw,b2[1]-ux*aw]]:null,txt:e.dia?'Ø'+fmtL(2*e.r):'R'+fmtL(e.r),right:e.p[0]>=cx};}
function mapPts(e,f){for(const k of ['a','b','o','c','p1','p2'])if(e[k])e[k]=f(e[k]);if(e.holes)e.holes=e.holes.map(H=>H.map(f));if(e.p){if(Array.isArray(e.p[0]))e.p=e.p.map(f);else e.p=f(e.p);}}
function translate(e,d){mapPts(e,p=>[p[0]+d[0],p[1]+d[1]]);}
function rotateE(e,c,ang){const co=Math.cos(ang),si=Math.sin(ang);mapPts(e,p=>{const x=p[0]-c[0],y=p[1]-c[1];return [c[0]+x*co-y*si,c[1]+x*si+y*co];});if(e.t==='arc'){e.a0+=ang;e.a1+=ang;}if(e.t==='text'||e.t==='block'||e.t==='ellipse')e.rot=(e.rot||0)+ang;}
function scaleE(e,c,f){mapPts(e,p=>[c[0]+(p[0]-c[0])*f,c[1]+(p[1]-c[1])*f]);for(const k of ['r','th','h','w','rx','ry'])if(typeof e[k]==='number')e[k]*=f;if(e.t==='block')e.sc=(e.sc||1)*f;}
function mirrorE(e,P0,th){const c2=Math.cos(2*th),s2=Math.sin(2*th);mapPts(e,p=>{const x=p[0]-P0[0],y=p[1]-P0[1];return [P0[0]+x*c2+y*s2,P0[1]+x*s2-y*c2];});
 if(e.t==='arc'){const a0=2*th-e.a1,a1=2*th-e.a0;e.a0=a0;e.a1=a1;}if(e.t==='door'||(e.t==='elem'&&ELK[e.k]&&ELK[e.k].side))e.flip=!e.flip;if(e.t==='ellipse')e.rot=2*th-(e.rot||0);if(e.t==='block'){e.rot=2*th-(e.rot||0)+Math.PI;e.m=-(e.m||1);}}
const cloneE=e=>JSON.parse(JSON.stringify(e));
function bbox(e){let P;switch(e.t){case 'pline':P=e.p;break;case 'circle':case 'arc':P=[[e.c[0]-e.r,e.c[1]-e.r],[e.c[0]+e.r,e.c[1]+e.r]];break;case 'wall':P=wallPoly(e,true);break;
 case 'door':{const L=dist(e.a,e.b);P=[[e.a[0]-L,e.a[1]-L],[e.a[0]+L,e.a[1]+L],e.b];break;}
 case 'dim':{const g=dimGeom(e);P=g?[e.a,e.b,g.A,g.B,g.T]:[e.a,e.b];break;}
 case 'text':{const ls=String(e.s).split('\n'),w=Math.max(...ls.map(x=>x.length))*e.h*0.6,dn=(ls.length-1)*e.h*1.3,r=e.rot||0,co=Math.cos(r),si=Math.sin(r);P=[];[0,w].forEach(a=>[-dn,e.h].forEach(b=>P.push([e.p[0]+a*co-b*si,e.p[1]+a*si+b*co])));break;}
 case 'stair':{const g=stairGeom(e);P=g?g.C:[e.a,e.b];break;}
 case 'elem':P=elemPoly(e)||[e.a,e.b];break;
 case 'block':{if(String(e.name).startsWith('u:')){P=[];userBlockEnts(e).forEach(q=>{const bq=bbox(q);if(isFinite(bq[0]))P.push([bq[0],bq[1]],[bq[2],bq[3]]);});if(!P.length)P=[e.p];break;}const g=blockPrims(e);P=[];g.l.forEach(s=>P.push(s[0],s[1]));g.c.forEach(([c,r])=>P.push([c[0]-r,c[1]-r],[c[0]+r,c[1]+r]));if(!P.length)P=[e.p];break;}
 case 'leader':{const g=leaderGeom(e);P=[e.a,e.b,g.land,[e.b[0],e.b[1]+g.h*1.2]];break;}
 case 'rdim':P=[e.c,e.p];break;
 case 'ellipse':case 'spline':P=curvePts(e);break;
 case 'adim':{const g=adimGeom(e);P=[e.c,e.p1,e.p2,e.o,g.T];break;}
 case 'table':{const g=tableGeom(e);P=[e.p,[e.p[0]+g.w,e.p[1]-g.h]];break;}
 default:P=[e.a,e.b];}
 let x0=Infinity,y0=Infinity,x1=-Infinity,y1=-Infinity;for(const p of P){x0=Math.min(x0,p[0]);y0=Math.min(y0,p[1]);x1=Math.max(x1,p[0]);y1=Math.max(y1,p[1]);}return [x0,y0,x1,y1];}

/* ---------- calques, sauvegarde, annuler ---------- */
const layerOf=n=>layers.find(l=>l.n===n);
let ALLFL=false;const multiFl=()=>ents.some(e=>(e.fl|0)>0);const nFl=()=>{let m=(S.curFl|0)+1;for(const e of ents)m=Math.max(m,(e.fl|0)+1);return m;};const flName=i=>i?'Étage '+i:'Rez-de-chaussée';
const visible=e=>{if(!ALLFL&&(e.fl|0)!==(S.curFl|0))return false;const L=layerOf(e.layer);return !L||L.v;};
function pickLayer(t,e){const a=(e&&e.t==='elem'&&ELK[e.k]&&ELK[e.k].lay)||(e&&e.t==='block'&&BLOCKS[e.name]&&BLOCKS[e.name].lay)||AUTO[t];if(curLayer==='0'&&a&&layerOf(a))return a;return curLayer;}
const KEY='lushiplan_v1';
function settingsObj(){const o={};PERSIST.forEach(k=>o[k]=S[k]);return o;}
function save(){ensureIds();if(docs[curDoc]&&docs[curDoc].name!==$('#fname').value){docs[curDoc].name=$('#fname').value;renderTabs();saveDocs();}try{localStorage.setItem(KEY,JSON.stringify({ents,cons,views,ublocks,layers,curLayer,name:$('#fname').value,S:settingsObj()}));}catch(e){}}
function saveBg(){try{localStorage.setItem(KEY+'_bg',JSON.stringify(bgImg));}catch(e){log('Image trop lourde pour rester dans le téléphone : enregistre le plan (.lplan) pour la garder.');}}
function load(){let ok=false;try{const d=JSON.parse(localStorage.getItem(KEY)||'null');if(d&&Array.isArray(d.ents)){ents=d.ents;cons=d.cons||[];views=d.views||[];ublocks=d.ublocks||{};layers=d.layers&&d.layers.length?d.layers:JSON.parse(JSON.stringify(DEF_LAYERS));curLayer=d.curLayer||'0';$('#fname').value=d.name||'Plan sans titre';if(d.S)PERSIST.forEach(k=>{if(d.S[k]!=null)S[k]=d.S[k];});if(d.wallT)S.wallT=d.wallT;ok=true;}}catch(e){}
 try{const b=JSON.parse(localStorage.getItem(KEY+'_bg')||'null');if(b&&b.src)setBg(b);}catch(e){}return ok;}
function mergeDefaultLayers(){DEF_LAYERS.forEach(d=>{if(!layerOf(d.n))layers.push(Object.assign({},d));});}
function setBg(b){bgImg=b;bgEl=null;if(b&&b.src){const im=new Image();im.onload=()=>{bgEl=im;draw();};im.src=b.src;}}
const stateJ=()=>JSON.stringify({e:ents,c:cons});
function stateL(j){const d=JSON.parse(j);if(Array.isArray(d)){ents=d;}else{ents=d.e;cons=d.c||[];}}
function snapshot(){undoS.push(stateJ());if(undoS.length>150)undoS.shift();redoS=[];}
function undo(){if(!undoS.length){log('Rien à annuler');return;}redoS.push(stateJ());stateL(undoS.pop());sel.clear();after();}
function redo(){if(!redoS.length){log('Rien à rétablir');return;}undoS.push(stateJ());stateL(redoS.pop());sel.clear();after();}
function after(){if(typeof BVER!=='undefined')BVER++;solve();save();refreshProp();updPrompt();draw();if(ARR)updMini();if(typeof sched3==='function'&&$('#v3d').classList.contains('on')){sched3();fill3Fl();}}
function add(e,keepLayer){snapshot();if(!keepLayer)e.layer=pickLayer(e.t,e);ensureIds();e.id=nid++;ents.push(e);save();}
function log(m){$('#log').textContent=m;}

/* ---------- thème ---------- */
function TH(){return S.light?{bg:'#f5f3ee',g1:'rgba(0,0,0,.05)',g2:'rgba(0,0,0,.13)',wf:'#dcd8cf',ch:'rgba(0,0,0,.25)',cur:'#111',lbl:'rgba(255,255,255,.92)',lblT:'#111',pre:'#d9480f'}:{bg:'#1b1f24',g1:'rgba(255,255,255,.045)',g2:'rgba(255,255,255,.11)',wf:'#2c313a',ch:'rgba(255,255,255,.22)',cur:'#fff',lbl:'rgba(0,0,0,.75)',lblT:'#fff',pre:'#ffb35c'};}
function dispCol(c){if(!S.light)return c;const m=/^#?([0-9a-f]{6})$/i.exec(c||'');if(!m)return c;const v=parseInt(m[1],16),r=(v>>16&255)/255,g=(v>>8&255)/255,b=(v&255)/255;return (0.2126*r+0.7152*g+0.0722*b)>0.75?'#1d2128':c;}

/* ---------- dessin ---------- */
function pathPoly(c,P){c.beginPath();P.forEach((s,i)=>i?c.lineTo(s[0],s[1]):c.moveTo(s[0],s[1]));c.closePath();}
function arcPath(c,tf,k,cen,r,a0,a1){const s=tf(cen);c.arc(s[0],s[1],r*k,-a0,-a1,true);}
function seg(c,tf,p,q){const s=tf(p),t=tf(q);c.beginPath();c.moveTo(s[0],s[1]);c.lineTo(t[0],t[1]);c.stroke();}
function matFill(c,e,tf,k,M){const m=FLOORM[e.mat];if(!m)return;const P=e.p.map(tf),Hs=(e.holes||[]).map(H=>H.map(tf));
 c.save();c.beginPath();[P,...Hs].forEach(Q=>{Q.forEach((s,i)=>i?c.lineTo(s[0],s[1]):c.moveTo(s[0],s[1]));c.closePath();});c.clip('evenodd');
 const [r,g,b]=m.c,bx=scrBox(P);c.globalAlpha=M.print?0.45:0.62;c.fillStyle='rgb('+r+','+g+','+b+')';c.fillRect(bx[0],bx[1],bx[2]-bx[0],bx[3]-bx[1]);
 const sp=m.s*k;if(sp>=3.5&&m.p!=='none'&&!FAST){c.globalAlpha=0.75;const dk='rgb('+Math.round(r*.55)+','+Math.round(g*.55)+','+Math.round(b*.55)+')';c.strokeStyle=dk;c.fillStyle=dk;c.lineWidth=0.8;c.setLineDash([]);const o=tf([0,0]),[x0,y0,x1,y1]=bx;c.beginPath();
  const VX=()=>{for(let X=Math.ceil((x0-o[0])/sp)*sp+o[0];X<=x1;X+=sp){c.moveTo(X,y0);c.lineTo(X,y1);}},HY=()=>{for(let Y=Math.ceil((y0-o[1])/sp)*sp+o[1];Y<=y1;Y+=sp){c.moveTo(x0,Y);c.lineTo(x1,Y);}};
  const brick=(rh,bl,sh)=>{let row=Math.ceil((y0-o[1])/rh);for(let Y=row*rh+o[1];Y<=y1+rh;Y+=rh,row++){c.moveTo(x0,Y);c.lineTo(x1,Y);const off=(((row%sh)+sh)%sh)*bl/sh;for(let X=Math.floor((x0-o[0]-off)/bl)*bl+o[0]+off;X<=x1;X+=bl){c.moveTo(X,Y-rh);c.lineTo(X,Y);}}};
  if(m.p==='grid'){VX();HY();c.stroke();}else if(m.p==='plank'){brick(sp,sp*8,3);c.stroke();}else if(m.p==='brick'){brick(sp,sp*1.6,2);c.stroke();}
  else if(m.p==='grass'){for(let Y=Math.ceil((y0-o[1])/sp)*sp+o[1];Y<=y1+6;Y+=sp)for(let X=Math.ceil((x0-o[0])/sp)*sp+o[0];X<=x1;X+=sp){const j=(((Math.round((X-o[0])/sp)*7+Math.round((Y-o[1])/sp)*13)%5)+5)%5*sp*0.15;c.moveTo(X+j,Y);c.lineTo(X+j-2.2,Y-5);c.moveTo(X+j,Y);c.lineTo(X+j+2.2,Y-5);}c.strokeStyle='rgb(40,110,40)';c.stroke();}
  else if(m.p==='dots'){for(let Y=Math.ceil((y0-o[1])/sp)*sp+o[1];Y<=y1;Y+=sp)for(let X=Math.ceil((x0-o[0])/sp)*sp+o[0];X<=x1;X+=sp){const j=(((Math.round((X-o[0])/sp)*5+Math.round((Y-o[1])/sp)*3)%4)+4)%4*sp*0.2;c.moveTo(X+j+1.1,Y+j);c.arc(X+j,Y+j,1.1,0,Math.PI*2);}c.fill();}}
 c.restore();
 if(!M.print&&!FAST){const ce=centroid(e.p),sc=tf(ce),bw=bx[2]-bx[0],bh=bx[3]-bx[1];if(bw>70&&bh>34){c.save();c.setLineDash([]);c.font='bold 11px '+FONT();c.textAlign='center';const t='▦ '+m.n,tw=c.measureText(t).width;c.globalAlpha=0.85;c.fillStyle='rgba(0,0,0,.55)';c.fillRect(sc[0]-tw/2-4,sc[1]+12,tw+8,15);c.globalAlpha=1;c.fillStyle='#fff';c.fillText(t,sc[0],sc[1]+23);c.restore();}}}
function hatchFill(c,pathFn,box,tf,k,col,pat){pat=typeof pat==='string'?pat:'diag';const sp=S.hatchSp*k;c.save();pathFn();c.clip();const [x0,y0,x1,y1]=box,o=tf([0,0]);
 if(pat==='plein'||sp<4||FAST){c.globalAlpha=pat==='plein'?.35:.22;c.fillStyle=col;c.fillRect(x0,y0,x1-x0,y1-y0);c.restore();return;}
 c.lineWidth=Math.max(.6,c.lineWidth*.6);c.globalAlpha=.7;c.strokeStyle=col;c.fillStyle=col;c.setLineDash([]);c.beginPath();
 const diag=sg=>{if(sg>0){const O=o[0]+o[1];for(let K=Math.ceil((x0+y0-O)/sp)*sp+O;K<=x1+y1;K+=sp){c.moveTo(K-y1,y1);c.lineTo(K-y0,y0);}}else{const O=o[0]-o[1];for(let K=Math.ceil((x0-y1-O)/sp)*sp+O;K<=x1-y0;K+=sp){c.moveTo(K+y0,y0);c.lineTo(K+y1,y1);}}};
 if(pat==='diag')diag(1);else if(pat==='croise'){diag(1);diag(-1);}
 else if(pat==='horiz'){for(let Y=Math.ceil((y0-o[1])/sp)*sp+o[1];Y<=y1;Y+=sp){c.moveTo(x0,Y);c.lineTo(x1,Y);}}
 else if(pat==='brique'){const rh=sp*1.5,bl=sp*4;let row=Math.ceil((y0-o[1])/rh);for(let Y=row*rh+o[1];Y<=y1+rh;Y+=rh,row++){c.moveTo(x0,Y);c.lineTo(x1,Y);const off=(((row%2)+2)%2)*bl/2;for(let X=Math.floor((x0-o[0]-off)/bl)*bl+o[0]+off;X<=x1;X+=bl){c.moveTo(X,Y-rh);c.lineTo(X,Y);}}}
 else if(pat==='points'){c.beginPath();for(let Y=Math.ceil((y0-o[1])/sp)*sp+o[1];Y<=y1;Y+=sp)for(let X=Math.ceil((x0-o[0])/sp)*sp+o[0];X<=x1;X+=sp){c.moveTo(X+1.2,Y);c.arc(X,Y,1.2,0,Math.PI*2);}c.fill();c.restore();return;}
 c.stroke();c.restore();}
function scrBox(P){let x0=Infinity,y0=Infinity,x1=-Infinity,y1=-Infinity;P.forEach(p=>{x0=Math.min(x0,p[0]);y0=Math.min(y0,p[1]);x1=Math.max(x1,p[0]);y1=Math.max(y1,p[1]);});return [x0,y0,x1,y1];}
function drawEnt(c,e,tf,k,col,M){
 c.strokeStyle=col;c.fillStyle=col;
 switch(e.t){
 case 'line':seg(c,tf,e.a,e.b);break;
 case 'pline':{const P=e.p.map(tf);if(e.mat&&e.closed&&!M.noHatch)matFill(c,e,tf,k,M);if(e.hatch&&e.closed&&!M.noHatch)hatchFill(c,()=>pathPoly(c,P),scrBox(P),tf,k,col,e.hatch);c.beginPath();P.forEach((s,i)=>i?c.lineTo(s[0],s[1]):c.moveTo(s[0],s[1]));if(e.closed)c.closePath();c.stroke();break;}
 case 'circle':{const s=tf(e.c),R=e.r*k;if(e.hatch&&!M.noHatch)hatchFill(c,()=>{c.beginPath();c.arc(s[0],s[1],R,0,Math.PI*2);},[s[0]-R,s[1]-R,s[0]+R,s[1]+R],tf,k,col,e.hatch);c.beginPath();c.arc(s[0],s[1],R,0,Math.PI*2);c.stroke();break;}
 case 'arc':c.beginPath();arcPath(c,tf,k,e.c,e.r,e.a0,e.a1);c.stroke();break;
 case 'wall':pathPoly(c,wallPoly(e,true).map(tf));c.stroke();break;
 case 'door':case 'window':drawOpening(c,e,tf,k,col,M);break;
 case 'elem':{const Q=elemPoly(e);if(!Q)break;const P=Q.map(tf),kk=e.k;c.save();
  if(kk==='limite'||!e.w){c.setLineDash([14,4,2.5,4]);seg(c,tf,e.a,e.b);c.restore();break;}
  c.setLineDash(kk==='poutre'?[7,4]:kk==='semelle'?[3,3]:[]);
  if(!M.noHatch){if(kk==='cloture')hatchFill(c,()=>pathPoly(c,P),scrBox(P),tf,k,col,'diag');else if(kk==='haie'){c.save();c.globalAlpha=.25;c.fillStyle=M.print?'#8c8':'#5aa84a';pathPoly(c,P);c.fill();c.restore();hatchFill(c,()=>pathPoly(c,P),scrBox(P),tf,k,col,'points');}else if(kk==='allee')hatchFill(c,()=>pathPoly(c,P),scrBox(P),tf,k,col,'brique');else if(kk==='ptrav'){c.save();c.globalAlpha=.15;c.fillStyle=col;pathPoly(c,P);c.fill();c.restore();}}
  pathPoly(c,P);c.stroke();
  if(kk==='rampe'){const A=mid(Q[0],Q[3]),B=mid(Q[1],Q[2]),L=dist(A,B)||1,ux=(B[0]-A[0])/L,uy=(B[1]-A[1])/L,al=Math.min(.35,L*.25),aw=Math.min(.2,e.w*.3),bs=[B[0]-ux*al,B[1]-uy*al];c.setLineDash([]);seg(c,tf,A,B);seg(c,tf,B,[bs[0]-uy*aw,bs[1]+ux*aw]);seg(c,tf,B,[bs[0]+uy*aw,bs[1]-ux*aw]);}
  c.restore();break;}
 case 'dim':drawDim(c,e,tf,k,col,M);break;
 case 'stair':{const g=stairGeom(e);if(!g)break;pathPoly(c,g.C.map(tf));c.stroke();c.beginPath();g.steps.concat(g.arrow).forEach(s=>{const a=tf(s[0]),b=tf(s[1]);c.moveTo(a[0],a[1]);c.lineTo(b[0],b[1]);});c.stroke();const s0=tf(e.a);c.beginPath();c.arc(s0[0],s0[1],3,0,Math.PI*2);c.stroke();break;}
 case 'block':{if(String(e.name).startsWith('u:')){userBlockEnts(e).forEach(q=>drawEnt(c,q,tf,k,col,M));break;}const g=blockPrims(e);c.beginPath();g.l.forEach(s=>{const a=tf(s[0]),b=tf(s[1]);c.moveTo(a[0],a[1]);c.lineTo(b[0],b[1]);});g.c.forEach(([cc,r])=>{const s=tf(cc);c.moveTo(s[0]+r*k,s[1]);c.arc(s[0],s[1],r*k,0,Math.PI*2);});c.stroke();break;}
 case 'leader':{const g=leaderGeom(e);seg(c,tf,e.a,e.b);seg(c,tf,e.b,g.land);pathPoly(c,g.head.map(tf));c.fill();const px=Math.max(g.h*k,M.minTxt||0);if(px<3)break;const s=tf(g.tp);c.save();c.font=px+'px '+FONT();c.textAlign=g.dir>0?'left':'right';c.textBaseline='alphabetic';c.fillText(e.s,s[0],s[1]);c.restore();break;}
 case 'rdim':{const g=rdimGeom(e);seg(c,tf,g.q2||e.c,e.p);pathPoly(c,g.head.map(tf));c.fill();if(g.head2){pathPoly(c,g.head2.map(tf));c.fill();}const px=Math.max(g.h*k,M.minTxt||0);if(px<3)break;const s=tf(e.p);c.save();c.font=px+'px '+FONT();c.textAlign=g.right?'left':'right';c.textBaseline='bottom';c.fillText(g.txt,s[0]+(g.right?3:-3),s[1]-2);c.restore();break;}
 case 'ellipse':{const s=tf(e.c);c.beginPath();c.ellipse(s[0],s[1],Math.max(0,e.rx*k),Math.max(0,e.ry*k),-(e.rot||0),0,Math.PI*2);c.stroke();break;}
 case 'spline':{const P=curvePts(e).map(tf);c.beginPath();P.forEach((s,i)=>i?c.lineTo(s[0],s[1]):c.moveTo(s[0],s[1]));c.stroke();break;}
 case 'adim':{const g=adimGeom(e);c.beginPath();arcPath(c,tf,k,e.c,g.r,g.s,g.t);c.stroke();
  for(const a of [g.s,g.t]){const d1=Math.max(0,g.r-10/k),P0=[e.c[0]+Math.cos(a)*d1,e.c[1]+Math.sin(a)*d1],P1=[e.c[0]+Math.cos(a)*(g.r+6/k),e.c[1]+Math.sin(a)*(g.r+6/k)];seg(c,tf,P0,P1);}
  const px=Math.max(g.h*k,M.minTxt||0);if(px<3)break;const s=tf(g.T);c.save();c.font=px+'px '+FONT();c.textAlign='center';c.textBaseline='middle';c.fillText(g.txt,s[0],s[1]);c.restore();break;}
 case 'table':{const g=tableGeom(e);g.lines.forEach(l=>seg(c,tf,l[0],l[1]));const px=e.h*k;if(px<3)break;c.save();c.textBaseline='middle';g.cells.forEach(t=>{c.font=(t.b?'bold ':'')+px+'px '+FONT();const s=tf(t.p);c.fillText(t.s,s[0],s[1]);});c.restore();break;}
 case 'text':{const s=tf(e.p),px=e.h*k;if(px<3)break;c.save();c.translate(s[0],s[1]);c.rotate(-(e.rot||0));c.font=px+'px '+FONT();c.textBaseline='alphabetic';String(e.s).split('\n').forEach((ln,i)=>c.fillText(ln,0,i*px*1.3));c.restore();break;}
 }}
function drawOpening(c,e,tf,k,col,M){const g=openPrims(e);if(!g)return;const {nx,ny}=g;
 if(M.cover){const ext=g.h+(M.lw*1.6)/k,a=e.a,b=e.b;const q=[[a[0]-nx*ext,a[1]-ny*ext],[b[0]-nx*ext,b[1]-ny*ext],[b[0]+nx*ext,b[1]+ny*ext],[a[0]+nx*ext,a[1]+ny*ext]].map(tf);
  c.save();c.fillStyle=M.bg;pathPoly(c,q);c.fill();c.strokeStyle=M.wallCol||col;c.lineWidth=M.lw*1.4;seg(c,tf,g.l[0][0],g.l[0][1]);seg(c,tf,g.l[1][0],g.l[1][1]);c.restore();}
 else{seg(c,tf,g.l[0][0],g.l[0][1]);seg(c,tf,g.l[1][0],g.l[1][1]);}
 c.strokeStyle=col;c.beginPath();for(let i=2;i<g.l.length;i++){const a=tf(g.l[i][0]),b=tf(g.l[i][1]);c.moveTo(a[0],a[1]);c.lineTo(b[0],b[1]);}c.stroke();
 if(g.arc){c.beginPath();arcPath(c,tf,k,g.arc[0],g.arc[1],g.arc[2],g.arc[3]);c.stroke();}if(g.arc2){c.beginPath();arcPath(c,tf,k,g.arc2[0],g.arc2[1],g.arc2[2],g.arc2[3]);c.stroke();}}
function drawDim(c,e,tf,k,col,M){const g=dimGeom(e);if(!g)return;const {ux,uy,nx,ny,sg,A,B}=g;const gap=3/k,ext=6/k;const off=Math.abs(g.d)>gap?gap:0;
 seg(c,tf,[e.a[0]+nx*sg*off,e.a[1]+ny*sg*off],[A[0]+nx*sg*ext,A[1]+ny*sg*ext]);
 seg(c,tf,[e.b[0]+nx*sg*off,e.b[1]+ny*sg*off],[B[0]+nx*sg*ext,B[1]+ny*sg*ext]);
 seg(c,tf,[A[0]-ux*ext,A[1]-uy*ext],[B[0]+ux*ext,B[1]+uy*ext]);
 const t=5/k;c.save();if((S.arrow||'trait')==='trait'){const tx=(ux+nx)*t*0.7071,ty=(uy+ny)*t*0.7071;c.lineWidth*=1.8;seg(c,tf,[A[0]-tx,A[1]-ty],[A[0]+tx,A[1]+ty]);seg(c,tf,[B[0]-tx,B[1]-ty],[B[0]+tx,B[1]+ty]);}
 else if(S.arrow==='point'){[A,B].forEach(Q=>{const sq=tf(Q);c.beginPath();c.arc(sq[0],sq[1],2.5,0,Math.PI*2);c.fill();});}
 else{const al=8/k,aw=2.8/k;[[A,1],[B,-1]].forEach(([Q,sg2])=>{const bx=Q[0]+ux*al*sg2,by=Q[1]+uy*al*sg2;pathPoly(c,[Q,[bx+nx*aw,by+ny*aw],[bx-nx*aw,by-ny*aw]].map(tf));c.fill();});}c.restore();
 const px=Math.max(g.h*k,(M&&M.minTxt)||0);if(px<3)return;let ang=Math.atan2(uy,ux);if(ang>Math.PI/2+1e-6||ang<=-Math.PI/2+1e-6)ang+=Math.PI;
 const s=tf(g.T);c.save();c.translate(s[0],s[1]);c.rotate(-ang);c.font=px+'px '+FONT();c.textAlign='center';c.textBaseline='middle';c.fillStyle=col;c.fillText(fmtL(g.L),0,0);c.restore();}
const DASH={continu:[],pointille:[1.5,3.5],cache:[6,4],axe:[14,4,2.5,4]},LWF={fin:0.6,normal:1,epais:1.8,tres:2.6};
const LTN={continu:'Continu',pointille:'Pointillé',cache:'Caché',axe:'Axe'},LWN={fin:'Fin',normal:'Normal',epais:'Épais',tres:'Très épais'};
function styleL(c,e,M){const L=layerOf(e.layer)||{};c.lineWidth=M.lw*(LWF[L.lw]||1);c.setLineDash((DASH[L.lt]||[]).map(v=>v*Math.max(1,M.lw)));}
function renderScene(c,tf,k,M){
 const colOf=e=>M.print?'#000':dispCol((layerOf(e.layer)||{}).c||'#ffffff');
 const walls=ents.filter(e=>e.t==='wall'&&visible(e));const polys=walls.map(w=>wallPoly(w).map(tf));
 if((S.curFl|0)>0&&!M.print){ALLFL=true;const gw=ents.filter(e=>e.t==='wall'&&(e.fl|0)===(S.curFl|0)-1);ALLFL=false;c.save();c.strokeStyle='rgba(140,150,165,.5)';c.lineWidth=1;c.setLineDash([4,3]);gw.forEach(w=>{pathPoly(c,wallPoly(w).map(tf));c.stroke();});c.restore();}
 c.lineJoin='round';for(const e of ents)if(e.t==='pline'&&e.mat&&visible(e)){styleL(c,e,M);drawEnt(c,e,tf,k,colOf(e),M);}c.setLineDash([]);
 c.lineCap='round';c.lineJoin='miter';
 const fut=e=>!M.print&&phaseOf(e)>curStep();if(!M.print&&curStep()<1)c.globalAlpha=.4;
 {c.lineWidth=M.lw*2;let cur=null;c.beginPath();walls.forEach((w,i)=>{const cl=colOf(w);if(cl!==cur){if(cur!==null)c.stroke();c.strokeStyle=cur=cl;c.beginPath();}const P=polys[i];P.forEach((q,j)=>j?c.lineTo(q[0],q[1]):c.moveTo(q[0],q[1]));c.closePath();});if(cur!==null)c.stroke();}
 c.fillStyle=M.wallFill;c.beginPath();polys.forEach(P0=>{const P=polyArea(P0)<0?P0.slice().reverse():P0;P.forEach((q,j)=>j?c.lineTo(q[0],q[1]):c.moveTo(q[0],q[1]));c.closePath();});c.fill('nonzero');
 walls.forEach((w,i)=>{if(!w.paint)return;const P=polys[i];c.save();c.fillStyle=w.paint;pathPoly(c,P);c.fill();c.restore();});
 c.globalAlpha=1;c.lineJoin='round';c.lineWidth=M.lw;
 const wl=layerOf('Murs');const MM=Object.assign({},M,{cover:true,wallCol:M.print?'#000':dispCol(wl?wl.c:'#ffffff')});
 for(const e of ents)if((e.t==='door'||e.t==='window')&&visible(e)){c.globalAlpha=fut(e)?.4:1;styleL(c,e,M);drawEnt(c,e,tf,k,colOf(e),MM);}c.globalAlpha=1;
 for(const e of ents){if(e.t==='wall'||e.t==='door'||e.t==='window'||(e.t==='pline'&&e.mat)||!visible(e))continue;c.globalAlpha=fut(e)?.4:1;styleL(c,e,M);drawEnt(c,e,tf,k,colOf(e),M);}c.globalAlpha=1;c.setLineDash([]);c.lineWidth=M.lw;}
const STEPS=[0.01,0.05,0.1,0.5,1,5,10,50,100,500,1000];
function gridStep(){for(const s of STEPS)if(s*view.s>=12)return s;return 5000;}
function drawGrid(c,T){const st=gridStep();const [x0,y1]=s2w(0,0),[x1,y0]=s2w(W,H);c.lineWidth=1;
 for(const [step,col] of [[st,T.g1],[st*10,T.g2]]){c.strokeStyle=col;c.beginPath();
  for(let i=Math.ceil(x0/step);i*step<=x1;i++){const X=Math.round(i*step*view.s+view.ox)+.5;c.moveTo(X,0);c.lineTo(X,H);}
  for(let i=Math.ceil(y0/step);i*step<=y1;i++){const Y=Math.round(-i*step*view.s+view.oy)+.5;c.moveTo(0,Y);c.lineTo(W,Y);}c.stroke();}
 const o=w2s(U());c.lineWidth=1.5;c.strokeStyle='rgba(230,70,70,.6)';c.beginPath();c.moveTo(o[0],o[1]);c.lineTo(o[0]+36,o[1]);c.stroke();c.strokeStyle='rgba(60,190,100,.6)';c.beginPath();c.moveTo(o[0],o[1]);c.lineTo(o[0],o[1]-36);c.stroke();}
function grips(){const out=[];if(sel.size>40)return out;for(const e of sel){if(e.t==='pline')e.p.forEach((p,i)=>out.push({e,k:'p',i,p}));else for(const k of ['a','b','o','c','p','p1','p2'])if(e[k])out.push({e,k,p:e[k]});}return out;}
let boxSel=null;
let drawQ=0;function draw(){if(drawQ)return;drawQ=requestAnimationFrame(()=>{drawQ=0;drawNow();});}
let CACHE=null;
function capScene(excl){if(!W)return;const cv2=(CACHE&&CACHE.cv)||document.createElement('canvas');cv2.width=cv.width;cv2.height=cv.height;const c=cv2.getContext('2d'),T=TH();c.setTransform(DPR,0,0,DPR,0,0);c.fillStyle=T.bg;c.fillRect(0,0,W,H);
 if(bgImg&&bgEl){const tl=w2s([bgImg.x,bgImg.y+bgImg.h]);c.save();c.globalAlpha=bgImg.op||0.5;c.drawImage(bgEl,tl[0],tl[1],bgImg.w*view.s,bgImg.h*view.s);c.restore();}
 if(S.grid)drawGrid(c,T);const keep=ents,ex=new Set(excl||[]);ents=keep.filter(e=>!ex.has(e));try{renderScene(c,w2s,view.s,{bg:T.bg,lw:1.2*(S.lwScr||1),wallFill:T.wf,print:false,minTxt:10});}catch(e){}finally{ents=keep;}
 CACHE={cv:cv2,s:view.s,ox:view.ox,oy:view.oy,excl:[...ex],on:true};}
function dropCache(){if(CACHE){CACHE=null;draw();}}
function drawNow(){if(!W)return;if(drawQ){cancelAnimationFrame(drawQ);drawQ=0;}const c=ctx,T=TH();c.setTransform(DPR,0,0,DPR,0,0);c.fillStyle=T.bg;c.fillRect(0,0,W,H);
 if(CACHE&&CACHE.on){const k=view.s/CACHE.s;c.setTransform(1,0,0,1,0,0);c.drawImage(CACHE.cv,(view.ox-CACHE.ox*k)*DPR,(view.oy-CACHE.oy*k)*DPR,CACHE.cv.width*k,CACHE.cv.height*k);c.setTransform(DPR,0,0,DPR,0,0);if(CACHE.excl.length){const keep=ents;ents=CACHE.excl;try{renderScene(c,w2s,view.s,{bg:T.bg,lw:1.2*(S.lwScr||1),wallFill:T.wf,print:false,minTxt:10});}catch(e){}finally{ents=keep;}}}else{
 if(bgImg&&bgEl){const tl=w2s([bgImg.x,bgImg.y+bgImg.h]);c.save();c.globalAlpha=bgImg.op||0.5;c.drawImage(bgEl,tl[0],tl[1],bgImg.w*view.s,bgImg.h*view.s);c.restore();}
 if(S.grid)drawGrid(c,T);
 SAFE('plan',()=>renderScene(c,w2s,view.s,{bg:T.bg,lw:1.2*(S.lwScr||1),wallFill:T.wf,print:false,minTxt:10}));}c.globalAlpha=1;c.setLineDash([]);
 if(sel.size){c.save();c.setLineDash([6,4]);c.lineWidth=2;for(const e of sel)drawEnt(c,e,w2s,view.s,'#33b5ff',{lw:2,bg:T.bg,cover:false,noHatch:true,minTxt:10});c.setLineDash([]);c.fillStyle='#33b5ff';if(tool==='select')for(const g of grips()){const s=w2s(g.p);c.fillRect(s[0]-5,s[1]-5,10,10);}c.restore();}
 SAFE('pièce',()=>{if(!ARR)return;const Q=ARR.poly.map(w2s);c.save();c.beginPath();c.rect(0,0,W,H);Q.forEach((q,i)=>i?c.lineTo(q[0],q[1]):c.moveTo(q[0],q[1]));c.closePath();c.fillStyle='rgba(0,0,0,.45)';c.fill('evenodd');c.strokeStyle='#51cf66';c.lineWidth=2.5;c.setLineDash([]);c.beginPath();Q.forEach((q,i)=>i?c.lineTo(q[0],q[1]):c.moveTo(q[0],q[1]));c.closePath();c.stroke();c.restore();});
 SAFE('meubles',()=>{CONF=conflicts();CONF.forEach((m,e)=>{const Q=footprint(e);if(!Q)return;c.save();c.fillStyle='rgba(255,40,40,.25)';c.strokeStyle='#ff3b3b';c.lineWidth=2;pathPoly(c,Q.map(w2s));c.fill();c.stroke();c.restore();});
  if(ROOMHL&&(tool==='rinfo'||$('#roomw').classList.contains('on'))){c.save();c.setLineDash([8,5]);c.strokeStyle='#51cf66';c.lineWidth=2.5;pathPoly(c,ROOMHL.map(w2s));c.stroke();c.restore();}});
 SAFE('contraintes',()=>drawCons(c));SAFE('aperçu',()=>drawPreview(c,T));
 if(boxSel){const b=boxSel,cr=b.x1<b.x0;c.save();c.setLineDash(cr?[5,4]:[]);c.strokeStyle=cr?'#4cd17a':'#33b5ff';c.fillStyle=cr?'rgba(76,209,122,.1)':'rgba(51,181,255,.1)';const x=Math.min(b.x0,b.x1),y=Math.min(b.y0,b.y1),w=Math.abs(b.x1-b.x0),h=Math.abs(b.y1-b.y0);c.fillRect(x,y,w,h);c.strokeRect(x,y,w,h);c.restore();}
 SAFE('curseur',()=>drawCursor(c,T));
