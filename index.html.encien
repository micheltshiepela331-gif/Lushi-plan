<script>
function showErr(t){try{var d=document.getElementById('errbox');if(!d){d=document.createElement('div');d.id='errbox';d.style.cssText='position:fixed;left:8px;right:8px;bottom:8px;z-index:99999;background:#c92a2a;color:#fff;padding:10px 12px;border-radius:9px;font:14px sans-serif;box-shadow:0 6px 20px rgba(0,0,0,.5)';document.body.appendChild(d);}
 d.innerHTML='⚠️ Lushi Plan a rencontré un problème. Fais une capture de cet écran et envoie-la :<br><b>'+String(t).replace(/</g,'&lt;')+'</b><br><button id="errReset" style="margin-top:8px;padding:6px 10px">Effacer le plan gardé et redémarrer</button> <button id="errClose" style="padding:6px 10px">Fermer</button>';
 document.getElementById('errClose').onclick=function(){d.remove();};
 document.getElementById('errReset').onclick=function(){if(!confirm('Le plan gardé dans le téléphone sera effacé (les fichiers .lplan enregistrés restent). Continuer ?'))return;try{localStorage.removeItem('lushiplan_v1');localStorage.removeItem('lushiplan_v1_docs');localStorage.removeItem('lushiplan_v1_bg');}catch(e){}location.reload();};}catch(e){alert(t);}}
window.addEventListener('error',function(e){showErr((e.message||'Erreur inconnue')+' — ligne '+(e.lineno||'?')+':'+(e.colno||'?'));});
window.addEventListener('unhandledrejection',function(e){var r=e.reason;showErr('Erreur : '+(r&&r.message||r));});
</script>
