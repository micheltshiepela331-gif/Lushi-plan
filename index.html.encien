function blockIcon(nm){const g=blockPrims({name:nm,p:[0,0],rot:0,sc:1,m:1});let P=[];g.l.forEach(s2=>P.push(s2[0],s2[1]));g.c.forEach(([c2,r])=>P.push([c2[0]-r,c2[1]-r],[c2[0]+r,c2[1]+r]));if(!P.length)return '';const b=scrBox(P),k=20/Math.max(b[2]-b[0],b[3]-b[1],1e-6),ox=12-(b[0]+b[2])/2*k,oy=12+(b[1]+b[3])/2*k,X=q=>(ox+q[0]*k).toFixed(1),Y=q=>(oy-q[1]*k).toFixed(1);
 return '<path d="'+g.l.map(s2=>'M'+X(s2[0])+' '+Y(s2[0])+'L'+X(s2[1])+' '+Y(s2[1])).join('')+'"/>'+g.c.map(([c2,r])=>'<circle cx="'+X(c2)+'" cy="'+Y(c2)+'" r="'+Math.max(.6,r*k).toFixed(1)+'"/>').join('');}
Object.keys(BLOCKS).forEach(k=>{if(!IC[k])IC[k]=blockIcon(k);});
